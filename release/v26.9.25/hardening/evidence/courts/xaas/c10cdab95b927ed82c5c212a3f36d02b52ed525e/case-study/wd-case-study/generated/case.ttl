@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix wddeck: <urn:wd:case-study-2:deck:> .

wddeck:deck a pres:Presentation ;
  pres:id "wd-case-study-2" ;
  pres:title "Western Digital Case Study 2 — HDD Failure Analysis AI Agent" ;
  pres:author "Sean Chatman" ;
  pres:company "XaaS" ;
  pres:subject "WD Senior Forward Deployed Engineer case study" ;
  pres:footer "Sean Chatman  /  Western Digital  /  September 2026" .

@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix wddeck: <urn:wd:case-study-2:deck:> .

wddeck:slide-01 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-01" ;
  pres:order 1 ;
  pres:layout "hero_flow" ;
  pres:audience "interview" ;
  pres:kicker "Western Digital Case Study 2" ;
  pres:title "HDD Failure Analysis\nAI Agent" ;
  pres:subtitle "A governed quality loop — not a chatbot in front of a vector database." ;
  pres:footer "Sean Chatman · September 2026" ;
  pres:notes "Open with the frame: this is a 20-minute design walk-through. The answer is not \"use an LLM\"; the answer is an operating loop that makes prior failure-analysis work reusable while keeping engineering authority explicit. Say: I chose Case Study 2 and interpreted the ask as engineering judgment under incomplete information. I asked clarifying questions, continued in parallel, and kept assumptions explicit." .

wddeck:slide-01-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-01 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "OBSERVE" ;
  pres:tone "blue" .

wddeck:slide-01-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-01 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "ADMIT" ;
  pres:tone "green" .

wddeck:slide-01-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-01 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "WORK" ;
  pres:tone "gold" .

wddeck:slide-01-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-01 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "VERIFY" ;
  pres:tone "red" .

wddeck:slide-01-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-01 ;
  pres:order 5 ;
  pres:role "stage" ;
  pres:title "LEARN" ;
  pres:tone "stone" .

wddeck:slide-02 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-02" ;
  pres:order 2 ;
  pres:layout "agenda" ;
  pres:audience "interview" ;
  pres:title "What I will prove in 20 minutes" ;
  pres:notes "Say this slide as a contract: I will not spend the time narrating every document. I will make the selection function clear. First, the bottleneck. Second, the architecture. Third, the safety/trust boundary. Fourth, the delivery plan. Emphasize the evidence ceiling: the prototype is useful because it makes the architecture falsifiable, but code is optional and does not substitute for design narrative." .

wddeck:slide-02-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 1 ;
  pres:role "step" ;
  pres:title "1\nFrame the real bottleneck" ;
  pres:tone "blue" .

wddeck:slide-02-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 2 ;
  pres:role "step" ;
  pres:title "2\nShow the governed architecture" ;
  pres:tone "green" .

wddeck:slide-02-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 3 ;
  pres:role "step" ;
  pres:title "3\nSeparate ranking from authority" ;
  pres:tone "gold" .

wddeck:slide-02-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 4 ;
  pres:role "step" ;
  pres:title "4\nDefine measurable delivery" ;
  pres:tone "stone" .

wddeck:slide-02-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 5 ;
  pres:role "callout" ;
  pres:body "Success is not a persuasive demo. Success is a system that tells the engineer what is known, what is missing, what is novel, and what action is justified next." ;
  pres:tone "stone" .

wddeck:slide-02-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-02 ;
  pres:order 6 ;
  pres:role "boundary" ;
  pres:body "Main evidence boundary: repository-local proposal + prototype fixtures, not WD production proof." ;
  pres:tone "red" .

wddeck:slide-03 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-03" ;
  pres:order 3 ;
  pres:layout "source_chain" ;
  pres:audience "interview" ;
  pres:title "The problem is repeated context reconstruction" ;
  pres:notes "Use WD's own problem framing: the evidence is fragmented across prior FA reports, image-heavy presentations, Confluence, Excel and structured build data. The workflow cost is not only search latency. It is repeated human reconstruction of the failed drive's context. So the agent's value is not \"answer generation\"; it is retiring repeated investigation steps. This is where MTTR and corrective-action quality become measurable." .

wddeck:slide-03-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 1 ;
  pres:role "source" ;
  pres:title "Historical FA\nPowerPoint" ;
  pres:tone "blue" .

wddeck:slide-03-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 2 ;
  pres:role "source" ;
  pres:title "Images / SEM\nplots / waveforms" ;
  pres:tone "blue" .

wddeck:slide-03-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 3 ;
  pres:role "source" ;
  pres:title "Confluence\nknown issues" ;
  pres:tone "blue" .

wddeck:slide-03-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 4 ;
  pres:role "source" ;
  pres:title "Excel\ntrackers" ;
  pres:tone "blue" .

wddeck:slide-03-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 5 ;
  pres:role "source" ;
  pres:title "Data lake\nbuild facts" ;
  pres:tone "blue" .

wddeck:slide-03-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 6 ;
  pres:role "source" ;
  pres:title "Engineer\njudgment" ;
  pres:tone "green" .

wddeck:slide-03-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 7 ;
  pres:role "center" ;
  pres:title "Reconstruct context\nbefore deciding the next action" ;
  pres:tone "gold" .

wddeck:slide-03-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 8 ;
  pres:role "outcome" ;
  pres:title "Slow MTTR + repeated investigative work + weaker corrective actions" ;
  pres:tone "red" .

wddeck:slide-03-block-09 a pres:Block ;
  pres:blockOf wddeck:slide-03 ;
  pres:order 9 ;
  pres:role "callout" ;
  pres:body "The first product promise: start the engineer at judgment, not at document archaeology." ;
  pres:tone "stone" .

wddeck:slide-04 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-04" ;
  pres:order 4 ;
  pres:layout "triad" ;
  pres:audience "interview" ;
  pres:title "Core design rule: candidate ≠ admission ≠ authority" ;
  pres:notes "This is the most important slide. Say it slowly. A model can nominate plausible failure modes, but plausibility is not engineering knowledge. Admission needs required evidence and applicability constraints. Authority remains with the engineer for consequential disposition. This prevents the system from turning a confident-looking nearest neighbor into a false root cause." .

wddeck:slide-04-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Candidate" ;
  pres:tone "blue" .

wddeck:slide-04-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Admission" ;
  pres:tone "gold" .

wddeck:slide-04-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Authority" ;
  pres:tone "green" .

wddeck:slide-04-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 4 ;
  pres:role "detail" ;
  pres:body "Model / retrieval may nominate" ;
  pres:tone "stone" .

wddeck:slide-04-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 5 ;
  pres:role "detail" ;
  pres:body "Evidence + applicability decide" ;
  pres:tone "stone" .

wddeck:slide-04-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 6 ;
  pres:role "detail" ;
  pres:body "Engineer owns consequence" ;
  pres:tone "stone" .

wddeck:slide-04-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 7 ;
  pres:role "callout" ;
  pres:body "Similarity can rank a prior case. Similarity cannot make it true." ;
  pres:tone "stone" .

wddeck:slide-04-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 8 ;
  pres:role "status" ;
  pres:title "KNOWN" ;
  pres:tone "green" .

wddeck:slide-04-block-09 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 9 ;
  pres:role "status" ;
  pres:title "PARTIAL" ;
  pres:tone "gold" .

wddeck:slide-04-block-10 a pres:Block ;
  pres:blockOf wddeck:slide-04 ;
  pres:order 10 ;
  pres:role "status" ;
  pres:title "UNKNOWN" ;
  pres:tone "red" .


@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix wddeck: <urn:wd:case-study-2:deck:> .

wddeck:slide-05 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-05" ;
  pres:order 5 ;
  pres:layout "pipeline" ;
  pres:audience "interview" ;
  pres:title "Architecture: one evidence state, many projections" ;
  pres:notes "Walk left to right. Sources remain sources. Ingestion creates normalized evidence but also quarantines failures. The canonical evidence plane binds identity, provenance, source ACLs and applicability rules. The triage plane uses retrieval and ranking, but admission is deterministic. Downstream artifacts are projections; we avoid each dashboard or work queue becoming a separate truth source." .

wddeck:slide-05-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Source systems\nPPT · images · Confluence · Excel · data lake" ;
  pres:tone "blue" .

wddeck:slide-05-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Ingestion boundary\nextract · normalize · quarantine failures" ;
  pres:tone "gold" .

wddeck:slide-05-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Canonical FA evidence plane\nidentity · provenance · graph · rules" ;
  pres:tone "green" .

wddeck:slide-05-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "Triage plane\nretrieve · rank · admit · construct work" ;
  pres:tone "stone" .

wddeck:slide-05-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 5 ;
  pres:role "projection" ;
  pres:title "Engineer view" ;
  pres:tone "white" .

wddeck:slide-05-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 6 ;
  pres:role "projection" ;
  pres:title "sJira work" ;
  pres:tone "white" .

wddeck:slide-05-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 7 ;
  pres:role "projection" ;
  pres:title "Audit receipt" ;
  pres:tone "white" .

wddeck:slide-05-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 8 ;
  pres:role "projection" ;
  pres:title "Manager view" ;
  pres:tone "white" .

wddeck:slide-05-block-09 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 9 ;
  pres:role "projection" ;
  pres:title "Evaluation" ;
  pres:tone "white" .

wddeck:slide-05-block-10 a pres:Block ;
  pres:blockOf wddeck:slide-05 ;
  pres:order 10 ;
  pres:role "callout" ;
  pres:body "The graph is canonical. Views, work items, receipts and demos are projections." ;
  pres:tone "stone" .

wddeck:slide-06 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-06" ;
  pres:order 6 ;
  pres:layout "pairs" ;
  pres:audience "interview" ;
  pres:title "What the agent returns for a failed drive" ;
  pres:notes "Use a concrete example verbally: for a failed drive with a reported timeout symptom, the system might surface two probable known modes, show lot and firmware applicability, link to prior cases, indicate missing station retest evidence, and recommend a named diagnostic action. The important part: it also states whether the evidence is sufficient for KNOWN, only PARTIAL, or truly UNKNOWN." .

wddeck:slide-06-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 1 ;
  pres:role "pair" ;
  pres:title "Ranked candidates" ;
  pres:body "probable failure modes + why ranked" ;
  pres:tone "blue" .

wddeck:slide-06-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 2 ;
  pres:role "pair" ;
  pres:title "Evidence packet" ;
  pres:body "supporting, contradicting and missing evidence" ;
  pres:tone "green" .

wddeck:slide-06-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 3 ;
  pres:role "pair" ;
  pres:title "Closest prior cases" ;
  pres:body "applicable prior art, not merely similar text" ;
  pres:tone "blue" .

wddeck:slide-06-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 4 ;
  pres:role "pair" ;
  pres:title "Next action" ;
  pres:body "named test, teardown step, route, closure or escalation" ;
  pres:tone "green" .

wddeck:slide-06-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 5 ;
  pres:role "pair" ;
  pres:title "Standing" ;
  pres:body "KNOWN · PARTIAL · UNKNOWN" ;
  pres:tone "blue" .

wddeck:slide-06-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 6 ;
  pres:role "pair" ;
  pres:title "Authority" ;
  pres:body "what the system constructed vs what engineer must decide" ;
  pres:tone "green" .

wddeck:slide-06-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-06 ;
  pres:order 7 ;
  pres:role "callout" ;
  pres:body "The output is a triage packet. It should reduce search, expose uncertainty and construct the next bounded action." ;
  pres:tone "stone" .

wddeck:slide-07 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-07" ;
  pres:order 7 ;
  pres:layout "graph" ;
  pres:audience "interview" ;
  pres:title "Data model: object-centric, provenance-bound" ;
  pres:notes "Explain the data stance. A failed drive is not a blob of text. It is related to drive identity, build, lot, supplier, BOM revision, firmware, station, tests, rework, evidence artifacts, observations, failure modes, actions, dispositions and reusable experience. Provenance is carried with each assertion. This lets the engineer ask: what is observed, what was derived, and where did it come from?" .

wddeck:slide-07-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 1 ;
  pres:role "node" ;
  pres:title "FailureCase" ;
  pres:tone "gold" .

wddeck:slide-07-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 2 ;
  pres:role "node" ;
  pres:title "Drive" ;
  pres:tone "blue" .

wddeck:slide-07-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 3 ;
  pres:role "node" ;
  pres:title "Build" ;
  pres:tone "blue" .

wddeck:slide-07-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 4 ;
  pres:role "node" ;
  pres:title "EvidenceArtifact" ;
  pres:tone "blue" .

wddeck:slide-07-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 5 ;
  pres:role "node" ;
  pres:title "FailureMode" ;
  pres:tone "green" .

wddeck:slide-07-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 6 ;
  pres:role "node" ;
  pres:title "DiagnosticAction" ;
  pres:tone "green" .

wddeck:slide-07-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 7 ;
  pres:role "node" ;
  pres:title "MachineExperience" ;
  pres:tone "green" .

wddeck:slide-07-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 8 ;
  pres:role "callout" ;
  pres:body "Observed ≠ derived ≠ inferred." ;
  pres:tone "stone" .

wddeck:slide-07-block-09 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 9 ;
  pres:role "callout" ;
  pres:body "Vector index is disposable; evidence record is not." ;
  pres:tone "stone" .

wddeck:slide-07-block-10 a pres:Block ;
  pres:blockOf wddeck:slide-07 ;
  pres:order 10 ;
  pres:role "callout" ;
  pres:body "Source ACLs travel with evidence." ;
  pres:tone "stone" .

wddeck:slide-08 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-08" ;
  pres:order 8 ;
  pres:layout "split" ;
  pres:audience "interview" ;
  pres:title "Reasoning design: precompute corpus, decide on current facts" ;
  pres:notes "This is the cost and latency answer. I would not retrieve the last 200 documents into context. Corpus normalization, embeddings, image observations and known-case metadata are precomputed. Query time reconstructs the current failed drive, filters by ACL, retrieves candidate prior art, ranks hypotheses and then applies admission rules. For structured data, I prefer purpose-built tools over unrestricted text-to-SQL because the tool contract controls cost, joins, permissions and auditability." .

wddeck:slide-08-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 1 ;
  pres:role "section" ;
  pres:title "Offline / precomputed" ;
  pres:tone "blue" .

wddeck:slide-08-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 2 ;
  pres:role "section" ;
  pres:title "Query time" ;
  pres:tone "green" .

wddeck:slide-08-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 3 ;
  pres:role "left" ;
  pres:body "Normalize documents, images, plots" ;
  pres:tone "stone" .

wddeck:slide-08-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 4 ;
  pres:role "left" ;
  pres:body "Embeddings + lexical indexes" ;
  pres:tone "stone" .

wddeck:slide-08-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 5 ;
  pres:role "left" ;
  pres:body "Prior-case metadata" ;
  pres:tone "stone" .

wddeck:slide-08-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 6 ;
  pres:role "left" ;
  pres:body "Applicability definitions" ;
  pres:tone "stone" .

wddeck:slide-08-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 7 ;
  pres:role "right" ;
  pres:body "Resolve drive/build facts" ;
  pres:tone "stone" .

wddeck:slide-08-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 8 ;
  pres:role "right" ;
  pres:body "ACL-filter retrieval" ;
  pres:tone "stone" .

wddeck:slide-08-block-09 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 9 ;
  pres:role "right" ;
  pres:body "Rank candidates" ;
  pres:tone "stone" .

wddeck:slide-08-block-10 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 10 ;
  pres:role "right" ;
  pres:body "Admit KNOWN/PARTIAL/UNKNOWN" ;
  pres:tone "stone" .

wddeck:slide-08-block-11 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 11 ;
  pres:role "center" ;
  pres:title "Curated semantic tools\nnot unrestricted text-to-SQL" ;
  pres:tone "stone" .

wddeck:slide-08-block-12 a pres:Block ;
  pres:blockOf wddeck:slide-08 ;
  pres:order 12 ;
  pres:role "callout" ;
  pres:body "Expensive corpus work stays offline; current drive facts stay current." ;
  pres:tone "stone" .


@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix wddeck: <urn:wd:case-study-2:deck:> .

wddeck:slide-09 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-09" ;
  pres:order 9 ;
  pres:layout "chain" ;
  pres:audience "interview" ;
  pres:title "Security and governance are first-class design constraints" ;
  pres:notes "Tie directly to WD's rubric. ACL propagation, IP handling and auditability are not a final deployment checklist. They are part of the state machine. If a derived artifact combines multiple restricted sources, use the most restrictive applicable policy until WD defines a declassification rule. Every candidate and recommendation should be replayable from subject identity, source versions, tool/model versions and admission rules." .

wddeck:slide-09-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Source ACL" ;
  pres:tone "blue" .

wddeck:slide-09-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Derived evidence" ;
  pres:tone "gold" .

wddeck:slide-09-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Recommendation" ;
  pres:tone "stone" .

wddeck:slide-09-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "Engineer disposition" ;
  pres:tone "green" .

wddeck:slide-09-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 5 ;
  pres:role "line" ;
  pres:body "Authorization before retrieval, not retrieve-then-redact." ;
  pres:tone "stone" .

wddeck:slide-09-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 6 ;
  pres:role "line" ;
  pres:body "Every recommendation replayable from source versions, model/tool versions and admission rules." ;
  pres:tone "stone" .

wddeck:slide-09-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 7 ;
  pres:role "line" ;
  pres:body "Phase-one authority: SELECT + CONSTRUCT only. Consequence stays human-gated." ;
  pres:tone "stone" .

wddeck:slide-09-block-08 a pres:Block ;
  pres:blockOf wddeck:slide-09 ;
  pres:order 8 ;
  pres:role "callout" ;
  pres:body "Security is not a later hardening pass; it is part of the evidence model." ;
  pres:tone "stone" .

wddeck:slide-10 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-10" ;
  pres:order 10 ;
  pres:layout "stages" ;
  pres:audience "interview" ;
  pres:title "Evaluation: prove trust before claiming MTTR" ;
  pres:notes "Make this very sober. Start with offline controls, especially false-KNOWN negative controls. Then shadow evaluation against historical or parallel cases. Only after that does a bounded pilot measure MTTR and repeated work. Say: false-KNOWN is the trust metric. MTTR is the business metric. Both matter, but one prevents the system from being dangerous and the other proves business value." .

wddeck:slide-10-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "Offline court" ;
  pres:body "positive · partial · novel · misleading-similarity · tamper" ;
  pres:tone "blue" .

wddeck:slide-10-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Shadow evaluation" ;
  pres:body "compare with current FA process, no automatic consequence" ;
  pres:tone "gold" .

wddeck:slide-10-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Bounded pilot" ;
  pres:body "measured value with human-gated production-adjacent workflow" ;
  pres:tone "green" .

wddeck:slide-10-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 4 ;
  pres:role "guardrail" ;
  pres:title "Critical guardrail: false-KNOWN" ;
  pres:tone "red" .

wddeck:slide-10-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 5 ;
  pres:role "metrics" ;
  pres:title "Business metrics: MTTR · time to action · engineer touches · repeated work avoided" ;
  pres:tone "stone" .

wddeck:slide-10-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-10 ;
  pres:order 6 ;
  pres:role "callout" ;
  pres:body "A lower MTTR after rollout is not automatically causal proof. Define baseline and comparison before claiming improvement." ;
  pres:tone "stone" .

wddeck:slide-11 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-11" ;
  pres:order 11 ;
  pres:layout "timeline" ;
  pres:audience "interview" ;
  pres:title "30 / 60 / 90 delivery plan" ;
  pres:notes "This is the pragmatism slide. In 30 days: one failure family, evidence reconstruction, known/partial/unknown triage and offline/shadow proof. In 60: authorized real sources and shadow comparison. In 90: bounded pilot with human-gated consequence. State clearly what you would cut: broad corpus coverage, polished dashboards, fine-tuning experiments. Do not cut provenance, negative controls, ACLs, human authority or baseline measurement." .

wddeck:slide-11-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-11 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "0–30\nBounded vertical slice" ;
  pres:body "One failure family, source map, sample corpus, structured join, triage packet." ;
  pres:tone "blue" .

wddeck:slide-11-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-11 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "31–60\nReal-source shadow" ;
  pres:body "Authorized connectors, ACL propagation, disposition capture, evaluation dashboard." ;
  pres:tone "gold" .

wddeck:slide-11-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-11 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "61–90\nBounded pilot" ;
  pres:body "Human-gated workflow, MachineExperience admission, process-delta review." ;
  pres:tone "green" .

wddeck:slide-11-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-11 ;
  pres:order 4 ;
  pres:role "callout" ;
  pres:body "Cut broad corpus coverage, polish and autonomy before cutting provenance, negative controls or human authority." ;
  pres:tone "stone" .

wddeck:slide-12 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-12" ;
  pres:order 12 ;
  pres:layout "flow" ;
  pres:audience "interview" ;
  pres:title "Close: the long-term compounding loop" ;
  pres:notes "Close with the compounding value: if the system helps one case become verified prior art, future applicable cases get cheaper and safer. The first decision I would ask for is not autonomy. It is a bounded shadow slice with representative data, an agreed ground-truth policy, and a measured baseline. Then stop and invite questions." .

wddeck:slide-12-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 1 ;
  pres:role "stage" ;
  pres:title "UNKNOWN" ;
  pres:tone "red" .

wddeck:slide-12-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 2 ;
  pres:role "stage" ;
  pres:title "Bounded\ninvestigation" ;
  pres:tone "gold" .

wddeck:slide-12-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 3 ;
  pres:role "stage" ;
  pres:title "Verified\ndisposition" ;
  pres:tone "green" .

wddeck:slide-12-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 4 ;
  pres:role "stage" ;
  pres:title "Machine\nExperience" ;
  pres:tone "blue" .

wddeck:slide-12-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 5 ;
  pres:role "stage" ;
  pres:title "Future case\nKNOWN" ;
  pres:tone "green" .

wddeck:slide-12-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 6 ;
  pres:role "callout" ;
  pres:body "The system gets better because verified engineering work becomes reusable prior art — not because the model is allowed to guess harder." ;
  pres:tone "stone" .

wddeck:slide-12-block-07 a pres:Block ;
  pres:blockOf wddeck:slide-12 ;
  pres:order 7 ;
  pres:role "decision" ;
  pres:body "My proposed first decision: authorize a bounded shadow slice, not production actuation." ;
  pres:tone "stone" .


@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix wddeck: <urn:wd:case-study-2:deck:> .

wddeck:slide-13 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-13" ;
  pres:order 13 ;
  pres:layout "bullets" ;
  pres:audience "internal" ;
  pres:kicker "PRESENTER PREP" ;
  pres:title "Appendix: ideal hiring feedback to earn" ;
  pres:footer "internal prep / do not present unless asked" ;
  pres:notes "This is not for the main presentation. It is the interviewer-lens target. The ideal feedback is not \"cool demo\"; it is that you are the person who can own ambiguous agentic solution delivery end-to-end while preserving evidence, governance and measurable delivery. That matches their evaluation rubric: system design depth, data/context engineering, tradeoff reasoning, security/governance, evaluation rigor, pragmatism and communication." .

wddeck:slide-13-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 1 ;
  pres:role "bullet" ;
  pres:body "“He understood this as a production quality system, not a prompt-engineering exercise.”" ;
  pres:tone "stone" .

wddeck:slide-13-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 2 ;
  pres:role "bullet" ;
  pres:body "“He separated retrieval, ranking, admission, authority and measurement.”" ;
  pres:tone "stone" .

wddeck:slide-13-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 3 ;
  pres:role "bullet" ;
  pres:body "“He was explicit about assumptions and asked the right questions without blocking progress.”" ;
  pres:tone "stone" .

wddeck:slide-13-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 4 ;
  pres:role "bullet" ;
  pres:body "“He could ship a 30-day slice while preserving security, provenance and evaluation rigor.”" ;
  pres:tone "stone" .

wddeck:slide-13-block-05 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 5 ;
  pres:role "bullet" ;
  pres:body "“He did not overclaim the prototype; he used it to make the architecture falsifiable.”" ;
  pres:tone "stone" .

wddeck:slide-13-block-06 a pres:Block ;
  pres:blockOf wddeck:slide-13 ;
  pres:order 6 ;
  pres:role "conclusion" ;
  pres:body "Hiring conclusion you want: strong FDE signal — ambiguous problem, executable architecture, sober evidence boundaries, credible delivery path." ;
  pres:tone "stone" .

wddeck:slide-14 a pres:Slide ;
  pres:slideOf wddeck:deck ;
  pres:id "slide-14" ;
  pres:order 14 ;
  pres:layout "three_part" ;
  pres:audience "internal" ;
  pres:kicker "PRESENTER PREP" ;
  pres:title "Appendix: reading the reschedule signal" ;
  pres:footer "internal prep / process signal only" ;
  pres:notes "Your read is useful but should stay bounded. A reschedule is better than a cancellation because it preserves the meeting and implies stakeholder time is still being coordinated. The lack of a canned answer to the three questions can be read as a positive process signal: they may prefer to discuss them live with the right people. But do not convert it into certainty. In the interview, do not say \"you did not just use ChatGPT.\" Instead, say: I sent those questions because the prompt explicitly values the questions, and I continued with reversible assumptions so we can adjust the architecture to the real workflow." .

wddeck:slide-14-block-01 a pres:Block ;
  pres:blockOf wddeck:slide-14 ;
  pres:order 1 ;
  pres:role "part" ;
  pres:title "Observed signal" ;
  pres:body "They rescheduled because someone needed to reschedule; they did not simply cancel or send a generic written response." ;
  pres:tone "stone" .

wddeck:slide-14-block-02 a pres:Block ;
  pres:blockOf wddeck:slide-14 ;
  pres:order 2 ;
  pres:role "part" ;
  pres:title "Reasonable read" ;
  pres:body "Modestly positive: the live session still matters, and the questions likely remain part of the conversation rather than being disposed of with canned text." ;
  pres:tone "stone" .

wddeck:slide-14-block-03 a pres:Block ;
  pres:blockOf wddeck:slide-14 ;
  pres:order 3 ;
  pres:role "part" ;
  pres:title "Boundary" ;
  pres:body "Not outcome evidence. Treat it as a cue to prepare for a serious discussion, not as proof of intent to hire." ;
  pres:tone "stone" .

wddeck:slide-14-block-04 a pres:Block ;
  pres:blockOf wddeck:slide-14 ;
  pres:order 4 ;
  pres:role "conclusion" ;
  pres:body "In the interview: treat the reschedule as process evidence only; keep the architectural assumptions explicit and reversible." ;
  pres:tone "stone" .


