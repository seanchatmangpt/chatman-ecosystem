# CE23-12 benchmark design instance graph (ce23:), Chatman Ecosystem v26.9.23, order CE23-12-BD-06.
#
# Canonical source (hand-authored design facts; HANDWRITTEN.md row "release/v26.9.23/bench/design.ttl"):
# derived from the scan-verified CE23-12 design capital (DESIGN.md; ontology-draft.ttl PART 4-5), with
# every trace edge rebound to the COMMITTED operator-prose propositions of
# release/v26.9.23/sjira/candidates/chatman-ce23-12-{bench,standings}.ttl (namespace ce:, emitted and
# re-verified against the committed prose bytes by the frozen xaas scripts/sjira/prose_spans.py).
#
# Vocabulary: the in-repo nonllm-class-qualification-pack (bench/pack/ontology.ttl, nlb:).
# Computed statistics (tier bounds, BoundRows, threshold sizes) are NOT here: pack/scripts/evidence_tiers.py
# writes them to bench/generated/. Work orders are NOT here: the plan CONSTRUCT of the pack
# (templates/plan-orders.ttl.tmpl) generates them into out/plan/orders.ttl; this graph holds zero
# sj:WorkOrder nodes (court clause GQP-P1).
#
# Standing: this graph asserts no ALIVE standing. BENCHMARK_DESIGN_ALIVE is derived by the CE23-12
# court receipt on an exact subject; every class's NON_LLM_OPERATIONAL_ALIVE tuple is UNKNOWN at n = 0.

@prefix nlb:     <https://ggen.dev/nonllm-bench#> .
@prefix ce23:    <https://chatman.dev/release/v26.9.23#> .
@prefix ce:      <https://ggen-igniter.dev/sjira/chatman-26.9.23#> .
@prefix dflss:   <https://ggen.dev/dflss#> .
@prefix es:      <https://ggen.dev/ontology/evidence-standing#> .
@prefix sj:      <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################################################
# Traces of the pack's vocabulary individuals to the operator prose (consumer facts)
#################################################################################################

nlb:BENCHMARK_DESIGN_ALIVE
  nlb:acceptancePredicate ce23:BD-D1 , ce23:BD-D2 , ce23:BD-D3 , ce23:BD-D4 , ce23:BD-D5 , ce23:BD-D6 ,
    ce23:BD-M1 , ce23:BD-M2 , ce23:BD-A1 , ce23:BD-A2 , ce23:BD-A3 , ce23:BD-A4 , ce23:BD-A5 , ce23:BD-A6 , ce23:BD-X1 ;
  prov:wasDerivedFrom ce:P-cc3821f7df83e938 , ce:P-94cce1ee3a020ec4 , ce:P-e3fad592bf0d3743 , ce:P-87719c7113cc07bb .
nlb:BENCHMARK_QUALIFIED prov:wasDerivedFrom ce:P-de26870ebc0da3ab .
nlb:NON_LLM_OPERATIONAL_ALIVE
  nlb:acceptancePredicate ce23:OP-1 , ce23:OP-2 , ce23:OP-3 , ce23:OP-4 , ce23:OP-5 , ce23:OP-6 ;
  prov:wasDerivedFrom ce:P-e4d899e1e24be748 , ce:P-3951c3003b3ad270 , ce:P-0da102e0639487ea , ce:P-dc3d8f62602cde3e .

nlb:tier-below-discovery prov:wasDerivedFrom ce:P-de26870ebc0da3ab .
nlb:tier-discovery prov:wasDerivedFrom ce:P-de26870ebc0da3ab , ce:P-54b789f4d65de73d .
nlb:tier-qualification prov:wasDerivedFrom ce:P-de26870ebc0da3ab .
nlb:tier-operational prov:wasDerivedFrom ce:P-de26870ebc0da3ab .
nlb:tier-scale prov:wasDerivedFrom ce:P-de26870ebc0da3ab .

# PART 4 -- ACCEPTANCE PREDICATES
#################################################################################################

ce23:BD-D1 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D1" ; nlb:conjunct "D" ;
  dcterms:description "Benchmark ontology admitted: nlb vocabulary + nlbsh shapes + gates are merged in ggen-marketplace/packs/nonllm-class-qualification-pack at an exact SHA; the pack qualification consumer syncs in ggen strict mode; each gate and shape admits the clean fixture and refuses every registered mutation on rdflib, pyoxigraph and pyshacl." ;
  nlb:checkCommand "python3 release/v26.9.23/bench/pack/scripts/verify.py --consumer release/v26.9.23/bench --mutations release/v26.9.23/courts/ce23_12/mutations.toml && (cd release/v26.9.23/bench && ggen sync run)" ;
  nlb:refusalMutation "Each fixture in qualification/mutations/*.ttl (near-miss expecting ALIVE, n=31 u=0.05, x=1 u=0.01, 30 observations on 1 case, OS with a column, same-family independent verifier, untraced node) must be refused; any admitted mutation falsifies BD-D1." ;
  nlb:ownerOrder "CE23-12-BD-02" ; prov:wasDerivedFrom ce:P-b29a6e572f8aef3b .

ce23:BD-D2 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D2" ; nlb:conjunct "D" ;
  dcterms:description "Candidate classes enumerated: at least 5 classes with claimStatus KNOWN_CANDIDATE, each with a bound class toolchain; refused and preserved classes are enumerated too." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
ASK { { SELECT (COUNT(DISTINCT ?c) AS ?k) WHERE { ?c a nlb:BenchmarkClass ; nlb:claimStatus "KNOWN_CANDIDATE" ; nlb:classToolchain ?t } } FILTER(?k >= 5) }""" ;
  nlb:refusalMutation "Demote one KNOWN_CANDIDATE to PRESERVED: the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-0bf49a6ad91b8c58 , ce:P-f7d560f5d644b1a4 .

ce23:BD-D3 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D3" ; nlb:conjunct "D" ;
  dcterms:description "Membership tests identified and observed: every KNOWN_CANDIDATE has a membership predicate with at least one TYPED_OUTPUT clause and one TRIAL_REPAIR or INDEPENDENT_SEMANTIC clause; no class relies on a declared label only." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
ASK { FILTER NOT EXISTS { ?c a nlb:BenchmarkClass ; nlb:claimStatus "KNOWN_CANDIDATE" .
  FILTER NOT EXISTS { ?c nlb:membershipPredicate ?p ; nlb:membershipClause ?a , ?b .
    ?a nlb:clauseBasis "TYPED_OUTPUT" . ?b nlb:clauseBasis ?bb . FILTER(?bb IN ("TRIAL_REPAIR","INDEPENDENT_SEMANTIC")) } } }""" ;
  nlb:refusalMutation "Replace a class's clauses with one DECLARED_LABEL clause (the current xme route/2 behaviour, machine_experience.ex:103-108): the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-8bc683ae3c1a9de8 , ce:P-44a93211e9c067ad .

ce23:BD-D4 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D4" ; nlb:conjunct "D" ;
  dcterms:description "Independent verifiers identified: every KNOWN_CANDIDATE has an independent verifier whose implementation family differs from its repair tool's." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
ASK { FILTER NOT EXISTS { ?c a nlb:BenchmarkClass ; nlb:claimStatus "KNOWN_CANDIDATE" ; nlb:repairTool ?t . ?t nlb:implementationFamily ?ft .
  FILTER NOT EXISTS { ?c nlb:independentVerifier ?v . ?v nlb:implementationFamily ?fv . FILTER(?fv != ?ft) } } }""" ;
  nlb:refusalMutation "Declare the class verifier (same engine as the repair) as the independent verifier: the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-a233ad30e1a31fca , ce:P-6514eed0f00946e2 .

ce23:BD-D5 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D5" ; nlb:conjunct "D" ;
  dcterms:description "Near-miss UNKNOWN falsifiers identified: every KNOWN_CANDIDATE has at least 3 NearMissCase individuals expecting es:UNKNOWN with a typed reason, and none is nlb:inClass." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
PREFIX es: <https://ggen.dev/ontology/evidence-standing#>
ASK { FILTER NOT EXISTS { ?c a nlb:BenchmarkClass ; nlb:claimStatus "KNOWN_CANDIDATE" .
  { SELECT ?c (COUNT(?m) AS ?k) WHERE { ?c a nlb:BenchmarkClass . OPTIONAL { ?m a nlb:NearMissCase ; nlb:nearClass ?c ; nlb:expectedStanding es:UNKNOWN ; nlb:expectedReason ?r } } GROUP BY ?c }
  FILTER(?k < 3) } }""" ;
  nlb:refusalMutation "Set one near-miss's expected standing to es:ALIVE (the pack gate 030 mutation): the class drops below 3 and the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-e86f34aec0045db1 , ce:P-5c4d9223b171d729 .

ce23:BD-D6 a nlb:AcceptancePredicate ; nlb:predicateId "BD-D6" ; nlb:conjunct "D" ;
  dcterms:description "CTQs defined: the 15 operator CTQs exist as dflss:CTQ with the five req:AdmittedCtq fields (source trace, measure, verification method, negative case, control chart)." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
PREFIX dflss: <https://ggen.dev/dflss#>
PREFIX prov: <http://www.w3.org/ns/prov#>
ASK { { SELECT (COUNT(DISTINCT ?q) AS ?k) WHERE { ?q a dflss:CTQ ; prov:wasDerivedFrom ?s ; nlb:operationalMeasure ?m ; nlb:verificationMethod ?v ; nlb:negativeCase ?n ; nlb:controlChart ?cc ; nlb:requiredResult ?r } } FILTER(?k = 15) }""" ;
  nlb:refusalMutation "Delete the control chart of one CTQ: the count drops to 14 and the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-94cce1ee3a020ec4 .

ce23:BD-M1 a nlb:AcceptancePredicate ; nlb:predicateId "BD-M1" ; nlb:conjunct "M" ;
  dcterms:description "Measurement/receipt/OCEL model defined: the 7 RTY stages each name an OCEL event type emitted on success and refusal; required receipt fields are declared (subject SHAs, actuator toolchain, argv sha256, factor levels, uname -sm, case id)." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
ASK { { SELECT (COUNT(DISTINCT ?s) AS ?k) WHERE { ?s a nlb:Stage ; nlb:ocelEventType ?e ; nlb:coversMorphism ?m ; nlb:instrumentedToday ?i } } FILTER(?k = 7)
  FILTER EXISTS { ?r a nlb:ReceiptFieldSet ; nlb:requiredField "uname_sm" , "actuator_toolchain" , "factor_levels" } }""" ;
  nlb:refusalMutation "Remove the event type of the Admit stage: the count drops to 6 and the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-e3fad592bf0d3743 , ce:P-a468b548fef60475 .

ce23:BD-M2 a nlb:AcceptancePredicate ; nlb:predicateId "BD-M2" ; nlb:conjunct "MSA_CONTRACT" ;
  dcterms:description "MSA contract defined: every MSA question of the operator prose is covered by at least one MSACourt with an instrument, today's status and a falsifier." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
PREFIX prov: <http://www.w3.org/ns/prov#>
ASK { FILTER NOT EXISTS { ?p a nlb:MSAProperty . FILTER NOT EXISTS { ?m a nlb:MSACourt ; nlb:msaProperty ?p ; nlb:statusToday ?s ; nlb:verifierCommand ?cmd } } }""" ;
  nlb:refusalMutation "Delete the M2 receipt-currency court: stale-receipt detection becomes uncovered and the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-22dff21d49b9f5a6 .

ce23:BD-A1 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A1" ; nlb:conjunct "A" ;
  dcterms:description "DOE support matrix generated: factor-standing.json, design-matrix.json and ci-matrix.json are ggen projections of the factor graph; computed resolution equals declared resolution (>= IV); UNSUPPORTED factors appear only in not_varied; byte-identical on regeneration." ;
  nlb:checkCommand "(cd release/v26.9.23/bench && ggen sync run) && git diff --exit-code -- release/v26.9.23/bench/out/doe && python3 release/v26.9.23/bench/pack/scripts/doe_verify.py release/v26.9.23/bench/out/doe/design-matrix.json" ;
  nlb:refusalMutation "Set the toolchain generator to cold x concurrency only (I=ABE): resolution 3 must be REFUSED(resolution_below_required); give OS a column: gate 040 must refuse." ;
  nlb:ownerOrder "CE23-12-BD-04" ; prov:wasDerivedFrom ce:P-2d647d6e18f801df , ce:P-9b8d48190eeaac75 , ce:P-d79566375284518a .

ce23:BD-A2 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A2" ; nlb:conjunct "A" ;
  dcterms:description "Statistical acceptance rules generated: tier individuals and exact BoundRows come from the kernel and agree with a second implementation to 1e-9; the overclaim shape compares a claimed bound with the exact (n, x) row and covers defects > 0; n is checked against distinct unseen receipts." ;
  nlb:checkCommand "python3 release/v26.9.23/bench/pack/scripts/evidence_tiers.py --consumer release/v26.9.23/bench --check" ;
  nlb:refusalMutation "Claims (n=31, x=0, u=0.05), (n=30, x=1, u=0.01) and (n=30 with 1 distinct receipt) must each violate nlbsh:ClassStandingShape; the candidate gate 010 admitted the first two (skeptic run)." ;
  nlb:ownerOrder "CE23-12-BD-03" ; prov:wasDerivedFrom ce:P-9224895d20a6a0bd , ce:P-de26870ebc0da3ab , ce:P-4d3769c9fc61645a .

ce23:BD-A3 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A3" ; nlb:conjunct "A" ;
  dcterms:description "Corpus and split rule defined: every KNOWN_CANDIDATE declares Dev(C), T_freeze(C), a reachable tier with and without synthetic members, and a cluster count; Train and Test are disjoint by subject digest and patch-id." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
ASK { FILTER NOT EXISTS { ?c a nlb:BenchmarkClass ; nlb:claimStatus "KNOWN_CANDIDATE" .
  FILTER NOT EXISTS { ?c nlb:devRepo ?d ; nlb:reachableTier ?t ; nlb:reachableTierWithSynthetic ?t2 ; nlb:clusterCount ?cc } }
  FILTER NOT EXISTS { ?a nlb:split nlb:Train ; nlb:inClass ?c1 . ?b nlb:split nlb:Test ; nlb:inClass ?c1 .
    { ?a nlb:subjectDigest ?x . ?b nlb:subjectDigest ?x } UNION { ?a nlb:patchId ?y . ?b nlb:patchId ?y } } }""" ;
  nlb:refusalMutation "Add a Test member sharing a patch-id with a Train member (the xaas b6fbdc21 pair the corpus skeptic found): the ASK becomes false." ;
  nlb:ownerOrder "CE23-12-BD-06" ; prov:wasDerivedFrom ce:P-87719c7113cc07bb , ce:P-f3bf6d9ee8cfe82a , ce:P-54b789f4d65de73d .

ce23:BD-A4 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A4" ; nlb:conjunct "PLAN" ;
  dcterms:description "Benchmark work orders generated (GeneratedQualificationPlan): the qualification-plan CONSTRUCT emits one tuple-complete sj:WorkOrder per (KNOWN_CANDIDATE class x B1..B6) plus one per MSA court; compile_prose over the CE23-12 candidates emits the prose-derived orders; both regenerate byte-identically (--check)." ;
  nlb:checkCommand "sh release/v26.9.23/sjira/compile_check.sh && sh release/v26.9.23/courts/CE23-12-GeneratedQualificationPlan.sh" ;
  nlb:refusalMutation "Delete the B5 order of one class from the projection: regeneration differs (--check exits 1)." ;
  nlb:ownerOrder "CE23-12-BD-08" ; prov:wasDerivedFrom ce:P-eb6bf51d657d803f , ce:P-e6e5199c02901c00 .

ce23:BD-A5 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A5" ; nlb:conjunct "A" ;
  dcterms:description "Every generated artifact traces to operator prose: every design node is prov:wasDerivedFrom an sj:Proposition whose span re-verifies against the operator prose bytes (prose_spans.py check exit 0); every projection's generation receipt names the design graph digest." ;
  nlb:checkCommand "sh release/v26.9.23/courts/CE23-12-BenchmarkDesign.sh (clauses P1 prose pins, P2 prose_spans check of both committed units, T1 trace closure)" ;
  nlb:refusalMutation "Remove prov:wasDerivedFrom from one CTQ (nlbsh:TraceShape violation), or change one byte inside a quoted span of the prose (prose_spans check REFUSED)." ;
  nlb:ownerOrder "CE23-12-BD-05" ; prov:wasDerivedFrom ce:P-354dcc1eb7f4ddb2 .

ce23:BD-A6 a nlb:AcceptancePredicate ; nlb:predicateId "BD-A6" ; nlb:conjunct "A" ;
  dcterms:description "No hand-written suite: benchmark definitions, case manifests, reports and the CI matrix are ggen projections with a GENERATED header; two regenerations are byte-identical over out/ (the .ggen-v2 chain hash is excluded: it advances by design)." ;
  nlb:checkCommand "sh release/v26.9.23/courts/CE23-12-GeneratedQualificationPlan.sh (clause G1: two fresh ggen sync runs byte-identical to the committed out/)" ;
  nlb:refusalMutation "Hand-edit one projected case manifest: regeneration restores the bytes and the committed tree differs." ;
  nlb:ownerOrder "CE23-12-BD-07" ; prov:wasDerivedFrom ce:P-d5b3bfcf4d7b43c7 , ce:P-d357273c1da8c3c8 .

ce23:BD-X1 a nlb:AcceptancePredicate ; nlb:predicateId "BD-X1" ; nlb:conjunct "NON_IMPLICATION" ;
  dcterms:description "The design graph promotes nothing: no ClassStanding of kind NON_LLM_OPERATIONAL_ALIVE or BENCHMARK_QUALIFIED is in state es:ALIVE without unseen-execution receipts (tuples in state UNKNOWN are allowed and required); the CE23-12 design receipt reports every class UNKNOWN for operation." ;
  nlb:askQuery """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
PREFIX es: <https://ggen.dev/ontology/evidence-standing#>
ASK { FILTER NOT EXISTS { ?s a nlb:ClassStanding ; nlb:standingKind ?k ; es:standingState es:ALIVE . FILTER(?k IN (nlb:NON_LLM_OPERATIONAL_ALIVE, nlb:BENCHMARK_QUALIFIED)) FILTER NOT EXISTS { ?s nlb:unseenExecutionReceipt ?r } } }""" ;
  nlb:refusalMutation "Set a class standing to es:ALIVE with n=0 and no receipt: the ASK becomes false and nlbsh:OperationalStandingShape reports a violation." ;
  nlb:ownerOrder "CE23-12-BD-09" ; prov:wasDerivedFrom ce:P-e4d899e1e24be748 , ce:P-dc3d8f62602cde3e , ce:P-0da102e0639487ea .

ce23:OP-1 a nlb:AcceptancePredicate ; nlb:predicateId "OP-1" ; nlb:conjunct "DESIGN" ;
  dcterms:description "BENCHMARK_DESIGN_ALIVE holds on the current design graph digest (validity scope: the digest the executor was generated from)." ;
  prov:wasDerivedFrom ce:P-3951c3003b3ad270 .
ce23:OP-2 a nlb:AcceptancePredicate ; nlb:predicateId "OP-2" ; nlb:conjunct "MSA" ;
  dcterms:description "MSA_ALIVE: every MSACourt ALIVE on its own receipts with >= 30 independent units and 0 defects on miss / false-accept / stale-accept; Cohen's kappa defined (both verifiers judged good and bad items) and every verifier disagreement routed UNKNOWN." ;
  prov:wasDerivedFrom ce:P-22dff21d49b9f5a6 , ce:P-6514eed0f00946e2 .
ce23:OP-3 a nlb:AcceptancePredicate ; nlb:predicateId "OP-3" ; nlb:conjunct "UNSEEN" ;
  dcterms:description "UnseenExecution(C): n = COUNT(DISTINCT subject digest) of Test-split members (not Dev(C), deduped by digest and patch-id) each with an executed receipt from the generated executor under env -i, fresh HOME, clean exact-SHA checkout, no transcript and no LLM credential; n >= 30 for DISCOVERY." ;
  prov:wasDerivedFrom ce:P-f3bf6d9ee8cfe82a , ce:P-0da102e0639487ea .
ce23:OP-4 a nlb:AcceptancePredicate ; nlb:predicateId "OP-4" ; nlb:conjunct "STAT" ;
  dcterms:description "StatisticalQualification(C): claimed upper bound >= exact Clopper-Pearson (n, x); tier = highest tier with n >= tierN and exact bound <= tier bound; FTY, RTY and P(false-KNOWN) reported with lower/upper 95% bounds; P(false-KNOWN) measured on >= 30 B6 near-misses with 0 false admissions for DISCOVERY." ;
  prov:wasDerivedFrom ce:P-05883ecca56c32e8 , ce:P-b9022a10780f111d .
ce23:OP-5 a nlb:AcceptancePredicate ; nlb:predicateId "OP-5" ; nlb:conjunct "ZERO_LLM" ;
  dcterms:description "ZeroLLM(C): LLM invocations on the KNOWN path = 0 (c-chart, zero tolerance) AND the generated provider guard refuses every B2 hidden-provider control (env prefixes, binaries on PATH incl. codex/gemini/ollama/openai, local model ports) AND the court PATH reaches no LLM binary." ;
  prov:wasDerivedFrom ce:P-50376c3f972e19c0 .
ce23:OP-6 a nlb:AcceptancePredicate ; nlb:predicateId "OP-6" ; nlb:conjunct "REPLAY" ;
  dcterms:description "Replay(C): every unseen receipt replays: recipe re-executed on the base gives the same git write-tree digest (path-normalized) and evidence replay is identical; divergence count 0; replay_unobserved counts as a defect." ;
  prov:wasDerivedFrom ce:P-a468b548fef60475 .

#################################################################################################
# PART 5 -- THE CE23-12 DESIGN INSTANCE GRAPH (ce23:) -- target chatman-ecosystem release/v26.9.23/bench/design.ttl
#################################################################################################

ce23:suite-CE23-12 a nlb:BenchmarkSuite ;
  rdfs:label "CE23-12 DfLSS Non-LLM Operational Benchmark" ;
  prov:wasDerivedFrom ce:P-d6a05b83a474ef62 , ce:P-a463693a094b335f .

ce23:CE23-12-design-standing a nlb:ClassStanding ;
  rdfs:label "CE23-12 design standing record (current)" ;
  nlb:standingKind nlb:BENCHMARK_DESIGN_ALIVE ;
  es:standingState es:UNKNOWN ;
  nlb:standingReason "a stored standing is a category error: BENCHMARK_DESIGN_ALIVE is derived only by the CE23-12 court receipt on an exact chatman-ecosystem subject (courts/CE23-12.sh)" ;
  prov:wasDerivedFrom ce:P-cc3821f7df83e938 .

