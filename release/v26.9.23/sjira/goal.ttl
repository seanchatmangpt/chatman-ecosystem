ce:CE23-1-falsifier a sj:Falsifier ;
    rdfs:label "CE23-1 falsifier" ;
    dcterms:description "The CE23-1 court exits 0 while no release/v26.9.23 subject exists, or while any path under release/v26.9.1 differs from its pre-v26.9.23 tree; the recorded gap is the counterexample: No v26.9.23 release subject exists today (chatman-ce23.md)." .

ce:CE23-2 a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-2" ;
