---
to: out/spc/chart-data.json
sparql:
  charts: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?chart ?result WHERE { ?q a dflss:CTQ ; rdfs:label ?label ; nlb:controlChart ?chart ; nlb:requiredResult ?result . }
    ORDER BY ?label
---
{"_generated": "GENERATED by ggen sync from nonllm-class-qualification-pack (templates/spc-chart-data.json.tmpl); do not hand-edit.",
 "phase": "NO_DATA",
 "note": "SPC after qualification (successor order CE23-12-OP-20): no subgroup exists before executed benchmark receipts; limits are computed only from Phase I data (>= 20-25 subgroups), never assumed.",
 "charts": [{% for c in charts %}
  {"ctq": {{ c.label | json_encode() }}, "chart_type": {{ c.chart | json_encode() }}, "required_result": {{ c.result | json_encode() }}, "center_line": null, "ucl": null, "lcl": null, "points": []}{% if not loop.last %},{% endif %}{% endfor %}
 ]}
