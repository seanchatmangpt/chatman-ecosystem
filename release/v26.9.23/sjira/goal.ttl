ce:CE23-3 a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-3" ;
    rdfs:label "CE23-3 Import the Semantic Manufacturing crown" ;
    dcterms:description "Import the Semantic Manufacturing crown: exact digest of a fresh STOP-GC-26.9.23 receipt says STOP=true, all 13 gate receipts admitted, replay succeeds." ;
