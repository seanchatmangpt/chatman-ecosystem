rp:rule_alive_exit0 a rp:ImplicationRule ; rp:contract rp:c_dfcm_fleet ;
    rp:ifPath "standing.value" ; rp:ifPattern "^ALIVE\\Z" ;
    rp:thenPath "replay.commands[].exit" ; rp:thenEquals 0 ;
