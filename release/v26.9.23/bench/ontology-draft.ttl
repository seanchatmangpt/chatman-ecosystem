  nlb:expectedTypedState "REFUSED / non-ALIVE (receipt_unsealed, pin_refused, r_projection_not_alive)" ; nlb:existingTyping "semantic_drive.ex:1041, 1094, 1932; seal-to-project corruption seam absent" ; nlb:seamStatus es:PARTIAL_ALIVE ; prov:wasDerivedFrom ce23:P-c5890eaf509015b3 .
