#################################################################################################
# PART 6 -- SHACL SHAPE SKETCHES (nlbsh:). Validated with pyshacl 0.31.0 against this file + candidates
# (conforms) and against mutation fixtures (each must violate): DESIGN.md section 12.
#################################################################################################

nlbsh:ClassStandingShape a sh:NodeShape ;
  sh:targetClass nlb:ClassStanding ;
  sh:property [ sh:path nlb:standingKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nlb:StandingKind ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "evidence tuple incomplete: a class standing needs forClass, tier, n, defects, confidence, upperFailureBound, boundMethod, environmentScope" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      SELECT $this WHERE { $this nlb:standingKind ?k . FILTER(?k != nlb:BENCHMARK_DESIGN_ALIVE)
        FILTER NOT EXISTS { $this nlb:forClass ?c ; nlb:tier ?t ; nlb:n ?n ; nlb:defects ?d ; nlb:confidence ?cf ;
          nlb:upperFailureBound ?u ; nlb:boundMethod ?m ; nlb:environmentScope ?e } }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "overclaim: claimed upperFailureBound is below the exact Clopper-Pearson bound for (n, defects), or no generated BoundRow exists for (n, defects)" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      SELECT $this WHERE { $this nlb:n ?n ; nlb:defects ?d ; nlb:upperFailureBound ?u .
        OPTIONAL { ?row a nlb:BoundRow ; nlb:boundN ?n ; nlb:boundDefects ?d ; nlb:exactUpperBound ?x }
        FILTER(!BOUND(?x) || ?u < ?x) }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "tier overclaim: n below the tier's N, or the exact bound above the tier's zero-defect bound" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      SELECT $this WHERE { $this nlb:n ?n ; nlb:defects ?d ; nlb:tier ?t . ?t nlb:tierN ?tn .
        OPTIONAL { ?t nlb:zeroDefectUpperBound ?tb . ?row a nlb:BoundRow ; nlb:boundN ?n ; nlb:boundDefects ?d ; nlb:exactUpperBound ?x }
        FILTER(?n < ?tn || (BOUND(?tb) && BOUND(?x) && ?x > ?tb)) }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "pseudo-replication: n exceeds the number of distinct subject digests among unseen-execution receipts" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      SELECT $this WHERE { $this nlb:n ?n . FILTER(?n > 0)
        { SELECT $this (COUNT(DISTINCT ?dg) AS ?k) WHERE { OPTIONAL { $this nlb:unseenExecutionReceipt ?r . ?r nlb:subjectDigest ?dg } } GROUP BY $this }
        FILTER(?k < ?n) }""" ] .

nlbsh:OperationalStandingShape a sh:NodeShape ;
  sh:targetSubjectsOf nlb:standingKind ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "NON_LLM_OPERATIONAL_ALIVE asserted ALIVE without DISCOVERY-tier evidence, MSA ALIVE, zero LLM invocations, zero replay divergence and no UNSUPPORTED varied factor" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      PREFIX es: <https://ggen.dev/ontology/evidence-standing#>
      SELECT $this WHERE { $this nlb:standingKind nlb:NON_LLM_OPERATIONAL_ALIVE ; es:standingState es:ALIVE .
        FILTER ( NOT EXISTS { $this nlb:tier ?t . ?t nlb:tierRank ?r . FILTER(?r >= 1) }
          || NOT EXISTS { $this nlb:msaStanding es:ALIVE }
          || NOT EXISTS { $this nlb:llmInvocations 0 }
          || NOT EXISTS { $this nlb:replayDivergence 0 }
          || EXISTS { $this nlb:variedFactor ?f . ?f nlb:support "UNSUPPORTED" } ) }""" ] .

nlbsh:KnownClassShape a sh:NodeShape ;
  sh:targetClass nlb:BenchmarkClass ;
  sh:property [ sh:path nlb:claimStatus ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "KNOWN_CANDIDATE" "PRESERVED" "BLOCKED" "NOT_KNOWN" "OUTSIDE_BOUNDARY" ) ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "KNOWN_CANDIDATE lacks repair tool, verifier, class toolchain, observed membership (TYPED_OUTPUT + TRIAL_REPAIR/INDEPENDENT_SEMANTIC), an independent verifier of a different implementation family, or 3 near-misses expecting UNKNOWN" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      PREFIX es: <https://ggen.dev/ontology/evidence-standing#>
      SELECT $this WHERE { $this nlb:claimStatus "KNOWN_CANDIDATE" .
        FILTER ( NOT EXISTS { $this nlb:repairTool ?t ; nlb:verifierArgv ?v ; nlb:classToolchain ?tc ; nlb:membershipPredicate ?mp }
          || NOT EXISTS { $this nlb:membershipClause ?a . ?a nlb:clauseBasis "TYPED_OUTPUT" }
          || NOT EXISTS { $this nlb:membershipClause ?b . ?b nlb:clauseBasis ?bb . FILTER(?bb IN ("TRIAL_REPAIR","INDEPENDENT_SEMANTIC")) }
          || NOT EXISTS { $this nlb:repairTool ?t2 ; nlb:independentVerifier ?iv . ?t2 nlb:implementationFamily ?f1 . ?iv nlb:implementationFamily ?f2 . FILTER(?f1 != ?f2) }
          || NOT EXISTS { { SELECT $this (COUNT(DISTINCT ?m) AS ?k) WHERE { ?m a nlb:NearMissCase ; nlb:nearClass $this ; nlb:expectedStanding es:UNKNOWN } GROUP BY $this } FILTER(?k >= 3) } ) }""" ] .

nlbsh:NearMissShape a sh:NodeShape ;
  sh:targetClass nlb:NearMissCase ;
  sh:property [ sh:path nlb:expectedStanding ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue es:UNKNOWN ] ;
  sh:property [ sh:path nlb:expectedReason ; sh:minCount 1 ] ;
  sh:property [ sh:path nlb:inClass ; sh:maxCount 0 ] .

nlbsh:FactorShape a sh:NodeShape ;
  sh:targetClass nlb:Factor ;
  sh:property [ sh:path nlb:support ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "VARIED" "FIXED" "PARTIAL" "UNSUPPORTED" ) ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "a non-VARIED factor (UNSUPPORTED, PARTIAL or FIXED) is placed in the design: it has a column, bit weight or generator, or a design lists it" ;
    sh:select """PREFIX nlb: <https://ggen.dev/nonllm-bench#>
      SELECT $this WHERE { $this nlb:support ?s . FILTER(?s != "VARIED")
        FILTER ( EXISTS { $this nlb:column ?c } || EXISTS { $this nlb:bitWeight ?w } || EXISTS { $this nlb:generatedBy ?g } || EXISTS { ?d nlb:hasFactor $this } ) }""" ] .

nlbsh:TraceShape a sh:NodeShape ;
  sh:targetClass nlb:AcceptancePredicate , nlb:BenchmarkClass , dflss:CTQ , nlb:Factor , nlb:MSACourt , nlb:MSAProperty ,
    nlb:NearMissCase , nlb:Stage , nlb:FaultInjectionPoint , nlb:ClassStanding , nlb:EvidenceTier , nlb:FractionalFactorialDesign ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class sj:Proposition ;
    sh:message "design node does not trace to an operator-prose proposition (sj:Proposition with a re-verified span)" ] .
