---
to: out/crosswalk.ttl
sparql:
  rows: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?d ?role ?source ?target ?boundary ?reason ?rule ?authority ?classification
           ?component ?sha ?standing ?supplier
    WHERE {
      ?d a er:RoleDisposition ; er:legacyRole ?role ; er:sourceRelease ?source ; er:targetRelease ?target .
      OPTIONAL { ?d er:boundary ?boundary . }
      OPTIONAL { ?d er:reason ?why . }
      OPTIONAL { ?d er:derivedBy ?drv . }
      OPTIONAL { ?d er:decidedBy ?dec . }
      OPTIONAL { ?d er:classificationSource ?cs . }
      OPTIONAL { ?d er:suppliedBy ?supplier . }
      OPTIONAL {
        ?source er:legacyComponent ?component .
        ?component er:legacyRole ?role .
        OPTIONAL { ?component er:legacySha ?lsha . }
        OPTIONAL { ?component er:legacyStanding ?standing . }
      }
      BIND(COALESCE(STR(?why), "") AS ?reason)
      BIND(COALESCE(STR(?drv), "") AS ?rule)
      BIND(COALESCE(STR(?dec), "") AS ?authority)
      BIND(COALESCE(STR(?cs), "") AS ?classification)
      BIND(COALESCE(STR(?lsha), "") AS ?sha)
    }
    ORDER BY ?source ?target ?role ?d
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack (templates/crosswalk.ttl.tmpl).
# ggen never emits its enriched graph, so this template projects every
# er:RoleDisposition (explicit decisions and rule-derived rows alike) as Turtle,
# wrapping IRIs as <...> and literals as "...". Do not hand-edit.
@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
{% for r in rows %}
<{{ r.d }}> a er:RoleDisposition ;
    er:legacyRole {{ r.role | json_encode() }} ;
    er:sourceRelease <{{ r.source }}> ;
    er:targetRelease <{{ r.target }}> ;{% if r.boundary %}
    er:boundary <{{ r.boundary }}> ;{% endif %}{% if r.component %}
    er:legacyComponent <{{ r.component }}> ;{% endif %}{% if r.sha %}
    er:legacySha {{ r.sha | json_encode() }} ;{% endif %}{% if r.standing %}
    er:legacyStanding <{{ r.standing }}> ;{% endif %}{% if r.supplier %}
    er:suppliedBy <{{ r.supplier }}> ;{% endif %}{% if r.rule %}
    er:derivedBy {{ r.rule | json_encode() }} ;{% endif %}{% if r.authority %}
    er:decidedBy {{ r.authority | json_encode() }} ;{% endif %}{% if r.classification %}
    er:classificationSource {{ r.classification | json_encode() }} ;{% endif %}
    er:reason {{ r.reason | json_encode() }} .
{% endfor %}
