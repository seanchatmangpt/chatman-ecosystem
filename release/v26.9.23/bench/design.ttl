#################################################################################################
# Statistics definitions (DESIGN.md section 8), projected into ACCEPTANCE_RULES.md
#################################################################################################

ce23:stat-fty a nlb:StatisticDefinition ; nlb:statisticOrder 1 ; nlb:statisticSymbol "FTY" ; nlb:statisticDefinition "units passing all k = 7 stages with exactly one ActuationStarted / N (unit = one admitted KNOWN work-order execution)" ; prov:wasDerivedFrom ce:P-b9022a10780f111d .
ce23:stat-rty a nlb:StatisticDefinition ; nlb:statisticOrder 2 ; nlb:statisticSymbol "RTY" ; nlb:statisticDefinition "product over the 7 stages of Y_j = pass_j / n_j from StageCompleted events; RTY_unit = pass_all / N is also reported (equal to the product only under independence); Bonferroni lower bound 1 - sum_j p_U(d_j, n_j; alpha/k)" ; prov:wasDerivedFrom ce:P-b9022a10780f111d .
ce23:stat-dpmo a nlb:StatisticDefinition ; nlb:statisticOrder 3 ; nlb:statisticSymbol "DPMO" ; nlb:statisticDefinition "D / (N * k) * 10^6, observed count (never a normal-approximation prediction)" ; prov:wasDerivedFrom ce:P-b20d62a968224997 .
ce23:stat-false-known a nlb:StatisticDefinition ; nlb:statisticOrder 4 ; nlb:statisticSymbol "P(false-KNOWN)" ; nlb:statisticDefinition "FP / (FP + TN) over expected-UNKNOWN B6 near-misses, with its exact Clopper-Pearson upper bound; safety-critical CTQ" ; prov:wasDerivedFrom ce:P-05883ecca56c32e8 .
ce23:stat-cp a nlb:StatisticDefinition ; nlb:statisticOrder 5 ; nlb:statisticSymbol "p_U" ; nlb:statisticDefinition "exact one-sided Clopper-Pearson upper bound BetaInv(1 - alpha; x + 1, n - x); x = 0: 1 - alpha^(1/n); n = 0: 1; minimum n at 0 defects for a nominal bound p*: ceil(ln alpha / ln(1 - p*)); alpha = 0.05" ; prov:wasDerivedFrom ce:P-de26870ebc0da3ab .
ce23:stat-cpu a nlb:StatisticDefinition ; nlb:statisticOrder 6 ; nlb:statisticSymbol "CPU" ; nlb:statisticDefinition "latency against a one-sided USL: sigma_w = MRbar / 1.128, CPU = (USL - xbar) / (3 sigma_w), Bissell 95% lower bound; Cp / Cpk only for two-sided continuous specifications" ; prov:wasDerivedFrom ce:P-b20d62a968224997 .
ce23:stat-imr a nlb:StatisticDefinition ; nlb:statisticOrder 7 ; nlb:statisticSymbol "I-MR" ; nlb:statisticDefinition "xbar +/- 3 MRbar / 1.128; MR UCL = 3.267 MRbar" ; prov:wasDerivedFrom ce:P-e9625dff50e2aa88 .
ce23:stat-p a nlb:StatisticDefinition ; nlb:statisticOrder 8 ; nlb:statisticSymbol "p-chart" ; nlb:statisticDefinition "pbar +/- 3 sqrt(pbar (1 - pbar) / n_i); LCL > 0 needs n_i > 9 (1 - pbar) / pbar" ; prov:wasDerivedFrom ce:P-e9625dff50e2aa88 .
ce23:stat-cu a nlb:StatisticDefinition ; nlb:statisticOrder 9 ; nlb:statisticSymbol "c / u" ; nlb:statisticDefinition "cbar + 3 sqrt(cbar); ubar + 3 sqrt(ubar / n_i); zero tolerance (cbar = 0) for LLM invocations, human interventions, unreceipted consequences, replay divergence" ; prov:wasDerivedFrom ce:P-e9625dff50e2aa88 .
ce23:stat-g a nlb:StatisticDefinition ; nlb:statisticOrder 10 ; nlb:statisticSymbol "g-chart" ; nlb:statisticDefinition "UCL = gbar + 3 sqrt(gbar (gbar + 1)), conforming units between defects; used when pbar is near 0" ; prov:wasDerivedFrom ce:P-e9625dff50e2aa88 .
ce23:stat-msa a nlb:StatisticDefinition ; nlb:statisticOrder 11 ; nlb:statisticSymbol "MSA agreement" ; nlb:statisticDefinition "effectiveness = correct / total; miss = bad accepted / bad (CP-bounded); false alarm = good rejected / good; repeatability = identical verdicts over r repeats; Cohen's kappa = (p_o - p_e) / (1 - p_e), defined only when both verifiers judged good and bad items" ; prov:wasDerivedFrom ce:P-22dff21d49b9f5a6 , ce:P-6514eed0f00946e2 .

