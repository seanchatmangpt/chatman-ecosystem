@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ea:Industry a rdfs:Class .
ea:Strategy a rdfs:Class .
ea:OperatingModel a rdfs:Class .
ea:Capability a rdfs:Class .
ea:ValueStream a rdfs:Class .
ea:Process a rdfs:Class .
ea:ArchitectureRequirement a rdfs:Class .
ea:ArchitectureBuildingBlock a rdfs:Class .
ea:ArchitectureContract a rdfs:Class .
ea:SolutionBuildingBlock a rdfs:Class .
ea:Pack a rdfs:Class .
ea:BBlock a rdfs:Class .
ea:BaselineArchitecture a rdfs:Class .
ea:TargetArchitecture a rdfs:Class .
ea:TransitionArchitecture a rdfs:Class .
ea:Qualification a rdfs:Class .
ea:QualificationReceipt a rdfs:Class .
ea:ArchitectureDecision a rdfs:Class .
ea:ArchitectureReceipt a rdfs:Class .
ea:AuthorityBoundary a rdfs:Class .
ea:Standing a rdfs:Class .

ea:derivedFromStrategy a rdf:Property ; rdfs:domain ea:ArchitectureRequirement ; rdfs:range ea:Strategy .
ea:realizesCapability a rdf:Property ; rdfs:domain ea:ArchitectureBuildingBlock ; rdfs:range ea:Capability .
ea:requiresABB a rdf:Property ; rdfs:range ea:ArchitectureBuildingBlock .
ea:satisfiesABB a rdf:Property ; rdfs:domain ea:SolutionBuildingBlock ; rdfs:range ea:ArchitectureBuildingBlock .
ea:governedByContract a rdf:Property ; rdfs:range ea:ArchitectureContract .
ea:hasCandidateSBB a rdf:Property ; rdfs:domain ea:ArchitectureBuildingBlock ; rdfs:range ea:SolutionBuildingBlock .
ea:qualifiedBy a rdf:Property ; rdfs:domain ea:SolutionBuildingBlock ; rdfs:range ea:Qualification .
ea:composedFromPack a rdf:Property ; rdfs:domain ea:SolutionBuildingBlock ; rdfs:range ea:Pack .
ea:composedFromBBlock a rdf:Property ; rdfs:domain ea:SolutionBuildingBlock ; rdfs:range ea:BBlock .
ea:transitionFrom a rdf:Property ; rdfs:domain ea:TransitionArchitecture .
ea:transitionTo a rdf:Property ; rdfs:domain ea:TransitionArchitecture .
ea:hasEvidence a rdf:Property ; rdfs:range prov:Entity .
ea:hasAuthorityBoundary a rdf:Property ; rdfs:range ea:AuthorityBoundary .
ea:hasStanding a rdf:Property ; rdfs:range ea:Standing .
ea:exactSubject a rdf:Property ; rdfs:range xsd:string .
ea:artifactDigest a rdf:Property ; rdfs:range xsd:string .
ea:qualificationDigest a rdf:Property ; rdfs:range xsd:string .
ea:refusalCode a rdf:Property ; rdfs:range xsd:string .

ea:Diversification a ea:OperatingModel .
ea:Coordination a ea:OperatingModel .
ea:Replication a ea:OperatingModel .
ea:Unification a ea:OperatingModel .

ea:UNKNOWN a ea:Standing .
ea:CANDIDATE a ea:Standing .
ea:ADMITTED a ea:Standing .
ea:QUALIFIED a ea:Standing .
ea:REFUSED a ea:Standing .
ea:SUPERSEDED a ea:Standing .
ea:PARTIAL_ALIVE a ea:Standing .
ea:ALIVE a ea:Standing .

# Normative semantic separations.
ea:ArchitectureBuildingBlock rdfs:comment "Implementation-independent architecture need. MUST NOT be used as a vendor/product identity." .
ea:SolutionBuildingBlock rdfs:comment "Concrete realization candidate. Qualification never grants authority or consequential DO." .
ea:Pack rdfs:comment "Reusable semantic/manufacturing material; not an ABB, SBB, or enterprise architecture." .
ea:ArchitectureContract rdfs:comment "Machine-evaluable contract used to decide whether an exact SBB subject satisfies an ABB." .


# DfCM Industry Closure architecture-level court.
ea:ArchitectureVersion a rdfs:Class .
ea:ArchitectureClaim a rdfs:Class .
ea:ArchitectureCourt a rdfs:Class .
ea:CompetingArchitecture a rdfs:Class .
ea:DfCMFrontier a rdfs:Class .
ea:IndustryClosureClaim a rdfs:Class ; rdfs:subClassOf ea:ArchitectureClaim .
ea:ArchitectureFalsifier a rdfs:Class .

ea:architectureVersion a rdf:Property ; rdfs:range ea:ArchitectureVersion .
ea:versionDigest a rdf:Property ; rdfs:range xsd:string .
ea:boundaryDigest a rdf:Property ; rdfs:range xsd:string .
ea:claimSubject a rdf:Property .
ea:evaluatedBy a rdf:Property ; rdfs:range ea:ArchitectureCourt .
ea:comparedWith a rdf:Property ; rdfs:range ea:CompetingArchitecture .
ea:hasFalsifier a rdf:Property ; rdfs:range ea:ArchitectureFalsifier .
ea:preservesOption a rdf:Property ; rdfs:domain ea:DfCMFrontier .
ea:strictlyDominates a rdf:Property ; rdfs:domain ea:CompetingArchitecture .
ea:grantsDoAuthority a rdf:Property ; rdfs:range xsd:boolean .
ea:claimText a rdf:Property ; rdfs:range xsd:string .

ea:ChatmanFullerV26_9_26 a ea:ArchitectureVersion ;
  ea:versionDigest "v26.9.26" .

ea:ChatmanFullerBestArchitectureClaim a ea:IndustryClosureClaim ;
  ea:architectureVersion ea:ChatmanFullerV26_9_26 ;
  ea:claimText "Chatman/Fuller v26.9.26 is the best architecture under the declared common court until falsified." ;
  ea:hasStanding ea:CANDIDATE .

ea:StrictDominanceFalsifier a ea:ArchitectureFalsifier ;
  rdfs:comment "Produce a lawful architecture that, under the same admitted reality, boundary, authority, cost, evidence and consequences, is no worse on every required dimension and strictly better on at least one." .

ea:ChatmanFullerBestArchitectureClaim ea:hasFalsifier ea:StrictDominanceFalsifier .

ea:IndustryClosureClaim rdfs:comment "Architecture-level, versioned and falsifiable claim. Industry closure is not merely exhaustive ABB enumeration; it stands only while no admissible competing reality-to-consequence architecture strictly dominates the claimed architecture under the same court." .
ea:DfCMFrontier rdfs:comment "Maximum useful lawful reversible possibility space preserved before irreversible selection, bounded by ontology, capability, authority, cost, evidence and consequence." .
ea:ArchitectureCourt rdfs:comment "Common-boundary adversarial comparison court. Court evidence may establish standing or falsification but never grants consequential DO authority." .
