---
to: out/doe/design-matrix.json
sparql:
  factors: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?letter ?label ?support ?lo ?hi ?w ?isbase WHERE {
      ?d a nlb:FractionalFactorialDesign ; nlb:hasFactor ?f .
      ?f nlb:column ?letter ; rdfs:label ?label ; nlb:support ?support ; nlb:lowRealization ?lo ; nlb:highRealization ?hi .
      { ?f nlb:bitWeight ?w . BIND("1" AS ?isbase) } UNION { ?f nlb:generatedBy ?g . ?g nlb:bitWeight ?w . BIND("0" AS ?isbase) }
    }
    ORDER BY ?letter ?w
  design: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?runs ?resolution ?relation ?seed WHERE {
      ?d a nlb:FractionalFactorialDesign ; rdfs:label ?label ; nlb:runCount ?runs ; nlb:resolution ?resolution ;
        nlb:definingRelation ?relation ; nlb:runOrderSeed ?seed .
    }
  notvaried: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?support WHERE { ?f a nlb:Factor ; rdfs:label ?label ; nlb:support ?support . FILTER(?support != "VARIED") }
    ORDER BY ?label
---
{#- Regular 2^(k-p) design in Yates standard order, computed from the factor graph only: a base factor
    with bit weight w is +1 at run r (0-based) iff floor(r / w) is odd; a generated factor's level is the
    product of its generators' levels. No run table is written by hand. -#}
{%- set_global nbase = 0 -%}{%- set_global letters = [] -%}
{%- for r in factors -%}{%- if r.isbase == "1" -%}{%- set_global nbase = nbase + 1 -%}{%- endif -%}
{%- if r.letter not in letters -%}{%- set_global letters = letters | concat(with=r.letter) -%}{%- endif -%}{%- endfor -%}
{%- set_global nruns = 1 -%}{%- for i in range(end=nbase) -%}{%- set_global nruns = nruns * 2 -%}{%- endfor -%}
{"_generated": "GENERATED by ggen sync from nonllm-class-qualification-pack (templates/doe-design-matrix.json.tmpl); do not hand-edit.",
 "design": "2^({{ letters | length }}-{{ letters | length - nbase }})", "runs_total": {{ nruns }}, "order": "yates-standard",
{%- for d in design %}
 "label": {{ d.label | json_encode() }},
 "declared": {"run_count": {{ d.runs }}, "resolution": {{ d.resolution }}, "defining_relation": {{ d.relation | json_encode() }}, "run_order_seed": {{ d.seed | json_encode() }}},
{%- endfor %}
 "factors": [{% for l in letters %}{%- set_global shown = false -%}{% for r in factors %}{% if r.letter == l and not shown %}
  {"column": "{{ l }}", "factor": {{ r.label | json_encode() }}, "support": "{{ r.support }}", "role": "{% if r.isbase == "1" %}base{% else %}generated{% endif %}", "low": {{ r.lo | json_encode() }}, "high": {{ r.hi | json_encode() }}}{%- set_global shown = true -%}{% endif %}{% endfor %}{% if not loop.last %},{% endif %}{% endfor %}
 ],
 "not_varied": [{% for n in notvaried %}{"factor": {{ n.label | json_encode() }}, "support": "{{ n.support }}"}{% if not loop.last %}, {% endif %}{% endfor %}],
 "runs": [
{%- for run in range(end=nruns) %}
  {"run": {{ run + 1 }}, "coded": { {%- for l in letters -%}
    {%- set_global lows = 0 -%}
    {%- for r in factors -%}{%- if r.letter == l -%}
      {%- set_global w = r.w | int -%}{%- set_global q = run / w -%}{%- set_global q = q | int -%}
      {%- if q % 2 == 0 -%}{%- set_global lows = lows + 1 -%}{%- endif -%}
    {%- endif -%}{%- endfor -%}
    "{{ l }}": {% if lows % 2 == 0 %}1{% else %}-1{% endif %}{% if not loop.last %}, {% endif %}
  {%- endfor -%} }}{% if not loop.last %},{% endif %}
{%- endfor %}
 ]}
