pcc:RouteCastleDeploy a ce:Capability ;
    dcterms:title "route.castle.deploy" ;
    dcterms:description "POST /api/castle/deploy (owner-only, lib/castle.ts's deployCastle) -- records an already-built, already kind-loaded castle image as this namespace's deployed workload and creates the real k8s Deployment/ConfigMap deploy-state record. Does not build or load the image itself (no Docker socket access from the pod). Reversible: a later POST /api/castle/deploy or POST /api/castle/sunset supersedes/removes the recorded state." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(owner)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteCastleRun a ce:Capability ;
    dcterms:title "route.castle.run" ;
    dcterms:description "POST /api/castle/run (member+, lib/castle.ts's runCastleVerb) -- the generic castle-verb actuation route: resolves a caller-supplied verbId against the fixed ALLOWED_CASTLE_VERBS allowlist (fortune5-requirements, inventory-components, inventory-goals) and creates a real, self-cleaning k8s Job to run it. Blocked by an active change-freeze window unless a freeze.override approval is on file. Reversible: every allowlisted verb today is read-only, and the Job it creates self-cleans." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(member)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteCastleSchedule a ce:Capability ;
    dcterms:title "route.castle.schedule" ;
    dcterms:description "POST/DELETE /api/castle/schedule (member+, lib/scheduled-verbs.ts's scheduleCastleVerb/cancelScheduledVerb) -- files (or cancels) a pending ScheduledVerb row for a future castle-verb run. POST never runs anything itself; it opens a distinct castle.verb.schedule maker-checker approval (already modeled as pcc:ApprovalCastleVerbSchedule) that a second, distinct owner-role approver must sign before lib/batch-jobs.ts's CronJob will actually fire it. This individual models the route-level filing/cancellation action itself, distinct from the approval gate it opens. Reversible: DELETE cancels a still-pending row." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(member)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteCastleSunset a ce:Capability ;
    dcterms:title "route.castle.sunset" ;
    dcterms:description "POST /api/castle/sunset (owner-only, lib/castle.ts's sunsetCastle) -- deletes every real k8s Job this module created plus the deploy-state ConfigMap; the response IS the real teardown record. Irreversible as a direct action: the deleted Jobs/ConfigMap are gone and cannot be restored, only recreated from scratch via a fresh POST /api/castle/deploy (which is a new deployment, not an undo)." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(owner)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible false ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteFeatureFlags a ce:Capability ;
    dcterms:title "route.feature-flags" ;
    dcterms:description "POST /api/feature-flags and /api/feature-flags/[flag] (member+, lib/k8s.ts's createOrUpdateConfigMap) -- toggles a platform feature flag via a real RFC 7386 merge patch to the platform-feature-flags ConfigMap, gated by a live plan-tier entitlement check (lib/tiers.ts) read off the flag's owning Project CR when turning a gated flag on. Reversible: any flag can be toggled back off (never tier-gated), and the merge patch only ever touches the one changed key." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(member)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteOrgsCustomDomain a ce:Capability ;
    dcterms:title "route.orgs.custom-domain" ;
    dcterms:description "POST /api/orgs/[id]/custom-domain (owner-of-that-org, lib/k8s.ts's createOrgCertificate) -- claims a hostname exclusively for this org (checked live against every other org's registry entry via findOrgByCustomDomain), persists the binding, and creates a real cert-manager.io/v1 Certificate CR requesting a TLS cert for that hostname against this cluster's ClusterIssuer. Reversible: the binding and Certificate CR can be replaced by a later POST for the same org." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRoleIn(org, owner)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteProjects a ce:Capability ;
    dcterms:title "route.projects" ;
    dcterms:description "POST /api/projects (owner-only, lib/k8s.ts's createProjectWithDatabase) and DELETE /api/projects/[name] (owner-only, lib/k8s.ts's deleteProjectWithDatabase) -- both collapse to this one route-capability-surface name once the [name] path segment is dropped. Creates or tears down a real Project + SingleDatabase CR pair and its namespace-scoped RBAC. Create is reversible via a subsequent DELETE; DELETE itself is irreversible -- the underlying database and its data are gone, not merely marked deleted." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(owner)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible false ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteProjectsBackups a ce:Capability ;
    dcterms:title "route.projects.backups" ;
    dcterms:description "POST /api/projects/[name]/backups (authenticated actor, lib/k8s.ts's createBackupJob/createRestoreJob) -- action:'backup' (default) creates a real backup Job against the project's live-resolved database Pod; action:'restore' requires the caller to type the exact backupJobName as a confirm string and verifies (via the database=<stem> label) that the named backup actually belongs to this project before restoring into its Pod. Both are additive/reversible in effect: backup creates a new artifact, restore overwrites data with an existing prior backup rather than destroying anything new." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "session.authenticated" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:RouteSecrets a ce:Capability ;
    dcterms:title "route.secrets" ;
    dcterms:description "POST /api/secrets (member+, lib/k8s.ts's createSecret) and DELETE /api/secrets (member+, lib/k8s.ts's deleteSecret) -- both collapse to this one route-capability-surface name. POST writes a real k8s Secret from caller-supplied key/value pairs (values never logged, only method/path/status recorded); DELETE removes a real Secret by namespace+name. Irreversible: a deleted Secret's values are gone -- recreating a Secret of the same name does not restore the original values unless the caller still has them." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "requireRole(member)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible false ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

