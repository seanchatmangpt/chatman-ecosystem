---
to: "packs-out/{{ packageName }}-pack/pack.toml"
skip_empty: false
unless_exists: true
for_each: results
sparql:
  results: |
    PREFIX asg: <https://ggen.io/ontology/ash-subproject-generator#>
    SELECT ?packageName ?totalDownloads ?hexUrl WHERE {
      ?s a asg:AshSubproject ;
         asg:packageName ?packageName ;
         asg:totalDownloads ?totalDownloads ;
         asg:hexUrl ?hexUrl .
    }
---
[pack]
name = "{{ packageName }}-pack"
version = "0.1.0"
description = """
Real scaffold generated by ash-subproject-pack-generator from real hex.pm
data ({{ packageName }}, {{ totalDownloads }} real total downloads at
generation time, {{ hexUrl }}).

NOT yet a complete, working ggen pack -- this is structure only. A real
maintainer (or a future, more capable generator) still needs to read
{{ packageName }}'s actual DSL/documentation and fill in ontology.ttl with
that library's real vocabulary and templates/ with real generation logic,
same as every other real pack in this marketplace. Generating this
skeleton mechanically is honest; claiming it is a finished, working pack
without that step would not be.
"""

[compatibility]
requires_ash = true
