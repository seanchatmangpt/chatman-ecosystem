rp:f_dd_ssha a rp:FieldBinding ; rp:contract rp:c_dfcm_fleet ; rp:profile rp:profile_durable ;
    rp:dottedPath "identity.subject_sha" ; rp:valueForm rp:vf_sha1 ; rp:mandatory true ;
    rp:brokenTerm "R_missing_identity" ;
    rp:resolution rp:res_subject_commit ; rp:repoPath "identity.repo" ; rp:repoMode "repo-map" ;
    rdfs:comment "Replaces the silent skip of validate_receipt.py:21 (Path(repo).is_dir()) with a mandatory --repo-map lookup." ;
