---
to: out/manifest.toml
sparql:
  release: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?release ?name ?version ?targetDate ?standing ?authority ?predecessor ?classification
    WHERE {
      ?release a er:Release .
      OPTIONAL { ?release rdfs:label ?label . }
      OPTIONAL { ?release er:version ?v . }
      OPTIONAL { ?release er:targetDate ?d . }
      OPTIONAL { ?release er:standing ?s . }
      OPTIONAL { ?release er:authorityClass ?a . }
      OPTIONAL { ?release er:crosswalkFrom ?old . OPTIONAL { ?old dcterms:hasVersion ?ov . } }
      OPTIONAL { ?release er:classificationSource ?cs . }
      BIND(COALESCE(STR(?label), "") AS ?name)
      BIND(COALESCE(STR(?v), "") AS ?version)
      BIND(COALESCE(STR(?d), "") AS ?targetDate)
      BIND(COALESCE(STRAFTER(STR(?s), "#"), "") AS ?standing)
      BIND(COALESCE(STRAFTER(STR(?a), "#"), "") AS ?authority)
      BIND(COALESCE(STR(?ov), "") AS ?predecessor)
      BIND(COALESCE(STR(?cs), "") AS ?classification)
    }
    ORDER BY ?release
  roles: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT DISTINCT ?role WHERE { ?release a er:Release ; er:requiredRole ?role . } ORDER BY ?role
  components: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?c ?id ?repository ?ref ?refCheck ?sha ?role ?disposition ?standing ?required
    WHERE {
      ?release a er:Release ; er:hasComponent ?c .
      OPTIONAL { ?c er:componentId ?cid . }
      OPTIONAL { ?c er:repository ?repo . }
      OPTIONAL { ?c er:branchRef ?br . }
      OPTIONAL { ?c er:refCheckMode ?mode . }
      OPTIONAL { ?c er:commitSha ?cs . }
      OPTIONAL { ?c er:role ?r . }
      OPTIONAL { ?c er:disposition ?disp . }
      OPTIONAL { ?c er:standing ?st . }
      OPTIONAL { ?c er:required ?req . }
      BIND(COALESCE(STR(?cid), STRAFTER(STR(?repo), "/"), "") AS ?id)
      BIND(COALESCE(STR(?repo), "") AS ?repository)
      BIND(COALESCE(STR(?br), "") AS ?ref)
      BIND(IF(?mode = er:GITHUB_LIVE, "github", IF(?mode = er:EXTERNAL_EXACT, "external", COALESCE(STRAFTER(STR(?mode), "#"), ""))) AS ?refCheck)
      BIND(COALESCE(STR(?cs), "") AS ?sha)
      BIND(COALESCE(STR(?r), "") AS ?role)
      BIND(COALESCE(STRAFTER(STR(?disp), "#"), "") AS ?disposition)
      BIND(COALESCE(STRAFTER(STR(?st), "#"), "") AS ?standing)
      BIND(IF(BOUND(?req) && ?req = true, "true", "false") AS ?required)
    }
    ORDER BY ?id ?c
  deps: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?c ?dep
    WHERE {
      ?release a er:Release ; er:hasComponent ?c .
      ?c er:dependsOn ?d .
      OPTIONAL { ?d er:componentId ?did . }
      OPTIONAL { ?d er:repository ?drepo . }
      BIND(COALESCE(STR(?did), STRAFTER(STR(?drepo), "/"), STR(?d)) AS ?dep)
    }
    ORDER BY ?c ?dep
  observations: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?id ?authority ?repository ?ref ?sha ?observedAt
    WHERE {
      ?release a er:Release ; er:hasComponent ?c .
      ?c er:hasRefObservation ?o .
      OPTIONAL { ?c er:componentId ?cid . }
      OPTIONAL { ?c er:repository ?crepo . }
      OPTIONAL { ?o er:observationAuthority ?a . }
      OPTIONAL { ?o er:observedRepository ?or . }
      OPTIONAL { ?o er:observedRef ?oref . }
      OPTIONAL { ?o er:observedSha ?osha . }
      OPTIONAL { ?o er:observedAt ?at . }
      BIND(COALESCE(STR(?cid), STRAFTER(STR(?crepo), "/"), "") AS ?id)
      BIND(COALESCE(STR(?a), "") AS ?authority)
      BIND(COALESCE(STR(?or), "") AS ?repository)
      BIND(COALESCE(STR(?oref), "") AS ?ref)
      BIND(COALESCE(STR(?osha), "") AS ?sha)
      BIND(COALESCE(STR(?at), "") AS ?observedAt)
    }
    ORDER BY ?id ?sha
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/release-manifest.toml.tmpl). Do not hand-edit: a hand edit makes the
# next `ggen sync run` refuse (FM-WRITE-005); regenerate by deleting this file.
# Every verify_release component field is emitted: id, repository, ref, ref_check,
# sha, role, disposition, standing, required, depends_on.
{% for r in release %}[release]
name = {{ r.name | json_encode() }}
version = {{ r.version | json_encode() }}
target_date = {{ r.targetDate | json_encode() }}
standing = {{ r.standing | json_encode() }}
authority_class = {{ r.authority | json_encode() }}
predecessor_version = {{ r.predecessor | json_encode() }}
classification_source = {{ r.classification | json_encode() }}
required_roles = [{% for x in roles %}
  {{ x.role | json_encode() }},{% endfor %}
]
{% endfor %}{% for c in components %}
[[components]]
id = {{ c.id | json_encode() }}
repository = {{ c.repository | json_encode() }}
ref = {{ c.ref | json_encode() }}
ref_check = {{ c.refCheck | json_encode() }}
sha = {{ c.sha | json_encode() }}
role = {{ c.role | json_encode() }}
disposition = {{ c.disposition | json_encode() }}
standing = {{ c.standing | json_encode() }}
required = {{ c.required }}
depends_on = [{% for d in deps %}{% if d.c == c.c %}{{ d.dep | json_encode() }}, {% endif %}{% endfor %}]
{% endfor %}{% for o in observations %}
[[external_ref_observations]]
component = {{ o.id | json_encode() }}
authority = {{ o.authority | json_encode() }}
repository = {{ o.repository | json_encode() }}
ref = {{ o.ref | json_encode() }}
sha = {{ o.sha | json_encode() }}
observed_at = {{ o.observedAt | json_encode() }}
{% endfor %}
