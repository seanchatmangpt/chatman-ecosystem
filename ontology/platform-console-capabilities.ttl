@prefix ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#> .
@prefix pcc: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/platform-console-capabilities#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

pcc:PlatformConsoleCapabilityOntology a owl:Ontology ;
    dcterms:title "Platform Console Capability Individuals (Phase 1 slice)" ;
    dcterms:description "Real ce:Capability ABox individuals for the 3 in-scope platform-console DO actions named in the eager-forging-sparrow plan: inventory-components, inventory-goals, freeze.override. Imports ontology/capabilities.ttl for the TBox/SHACL shape it validates against." ;
    owl:imports <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities> .

pcc:CastleVerbInventoryComponents a ce:Capability ;
    dcterms:title "inventory-components" ;
    dcterms:description "Read-only castle inventory-components verb, actuated via POST /api/castle/run; the only side effect is a self-cleaning k8s Job." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "AuthorityObject.admits(castle.verb.run)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:CastleVerbInventoryGoals a ce:Capability ;
    dcterms:title "inventory-goals" ;
    dcterms:description "Read-only castle inventory-goals verb, actuated via POST /api/castle/run; the only side effect is a self-cleaning k8s Job. Second data point proving the castle-verb pattern generalizes beyond inventory-components." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
