---
to: out/plan/orders.ttl
construct: |
  PREFIX nlb: <https://ggen.dev/nonllm-bench#>
  PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
  PREFIX dcterms: <http://purl.org/dc/terms/>
  PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
  PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
  PREFIX prov: <http://www.w3.org/ns/prov#>
  CONSTRUCT {
    ?order a sj:WorkOrder ;
      rdfs:label ?label ;
      dcterms:identifier ?id ;
      dcterms:title ?title ;
      dcterms:description ?desc ;
      sj:repository ?repo ;
      sj:baseSha ?base ;
      sj:subject ?subject ;
      sj:standing "UNKNOWN" ;
      sj:evidenceCeiling "EXECUTED_VERIFIED" ;
      sj:evidenceHorizon "EXECUTED_VERIFIED" ;
      sj:authorityCeiling "CONSTRUCT" ;
      sj:authorityRequirement "NONE" ;
      sj:promotionRule "Standing advances only from an ADMITTED receipt of an executed benchmark run whose identity names this order; BENCHMARK_DESIGN_ALIVE never promotes it (BENCHMARK_DESIGN_ALIVE does not imply NON_LLM_OPERATIONAL_ALIVE)." ;
      sj:replayIdentity ?replay ;
      sj:pathScope ?scope ;
      sj:requiresCourt ?court ;
      sj:requiresEvidence sj:receipt-evidence ;
      sj:acceptance ?acc ;
      sj:falsifier ?fal ;
      sj:projection sj:markdown-projection ;
      sj:nextAction ?act ;
      sj:nextCheckpoint ?cp ;
      sj:requiresReceiptClass "verification" ;
      sj:checkpointOf ?cp ;
      sj:boundaryClass sj:Successor ;
      sj:postcondition ?post ;
      sj:requiresCapability ?cap ;
      sj:consequenceClass "verification" ;
      sj:exclusion "NON_LLM_OPERATIONAL_ALIVE is never implied by the benchmark design; no cross-platform evidence is synthesized (OS factor UNSUPPORTED, outside the demonstrated evidence ceiling)." ;
      sj:successorPolicy "Generated by the qualification plan of the benchmark design for the successor goal; executing it produces the receipts that can promote the class from implemented to operationally qualified at a stated evidence tier." .
    ?acc a sj:AcceptanceCriterion ; rdfs:label ?accLabel ; dcterms:description ?post .
    ?fal a sj:Falsifier ; rdfs:label ?falLabel ; dcterms:description ?falText .
    ?court a sj:Court ; rdfs:label ?courtLabel ; dcterms:description ?courtText .
    ?act a sj:Action ; rdfs:label ?actLabel ; dcterms:description ?actText .
    ?entry a nlb:PlanEntry ;
      rdfs:label ?entryLabel ;
      nlb:planOrder ?order ;
      nlb:planSource ?source ;
      nlb:planKind ?kind ;
      nlb:planFamily ?fam ;
      nlb:planClass ?klass ;
      nlb:planTier ?next ;
      nlb:targetRepository ?target ;
      nlb:referenceOrder ?ref ;
      prov:wasDerivedFrom ?trace .
  }
  WHERE {
    ?plan a nlb:QualificationPlan ;
      nlb:planRoot ?root ;
      nlb:planCheckpoint ?cp ;
      nlb:planNamespace ?ns ;
      nlb:planIdPrefix ?prefix ;
      nlb:planReplayPrefix ?rprefix ;
      nlb:msaCapability ?msaCap ;
      nlb:gapCapability ?gapCap .
    ?root sj:repository ?repo ; sj:baseSha ?base .
    {
      ?klass nlb:claimStatus "KNOWN_CANDIDATE" ; nlb:classCode ?ccode ; skos:prefLabel ?clabel ; nlb:targetRepository ?target .
      ?st a nlb:ClassStanding ; nlb:forClass ?klass ; nlb:standingKind nlb:NON_LLM_OPERATIONAL_ALIVE ; nlb:tier ?cur .
      ?cur nlb:tierRank ?rank .
      ?next a nlb:EvidenceTier ; nlb:tierRank ?rank2 ; nlb:tierN ?tn ; skos:prefLabel ?tl ; nlb:zeroDefectUpperBound ?tb .
      FILTER(?rank2 = ?rank + 1)
      ?fam a nlb:BenchmarkFamily ; nlb:familyCode ?fcode ; skos:prefLabel ?flabel ;
        nlb:familyAcceptance ?facc ; nlb:familyFalsifier ?ffal ; nlb:familyCapability ?famCap ; nlb:referenceOrder ?ref .
      ?fam prov:wasDerivedFrom ?trace .
      BIND(?klass AS ?source)
      BIND("CLASS_FAMILY_TIER" AS ?kind)
      BIND(CONCAT(?ccode, "-", ?fcode) AS ?idcode)
      BIND(CONCAT(?fcode, " ", ?tl, " qualification of ", ?clabel) AS ?title)
      BIND(CONCAT(?flabel, " for ", ?clabel, " reaches ", ?tl, ": ", ?facc,
        "; the class tuple carries n >= ", STR(?tn), " distinct unseen subject digests with 0 defects and an exact one-sided 95% Clopper-Pearson upper failure bound <= ",
        STR(?tb), " (BoundRow n=", STR(?tn), ", x=0); environment scope macOS arm64, the OS factor UNSUPPORTED (outside the demonstrated evidence ceiling).") AS ?post)
      BIND(CONCAT("A receipt claims ", ?tl, " for ", ?clabel, " while ", ?ffal, "; or the tuple claims n >= ", STR(?tn),
        " with fewer distinct unseen subject digests, or an upper failure bound below ", STR(?tb),
        " (0 failures in ", STR(?tn), " trials bounds p_f only below ", STR(?tb), ").") AS ?falText)
    } UNION {
      ?source a nlb:MSACourt ; nlb:courtCode ?code ; rdfs:label ?clabel ; nlb:msaProperty ?prop ;
        nlb:statusToday ?status ; nlb:referenceOrder ?ref ; nlb:targetRepository ?target ; prov:wasDerivedFrom ?trace .
      ?prop rdfs:label ?plabel .
      BIND("MSA_COURT" AS ?kind)
      BIND(CONCAT("MSA-", ?code) AS ?idcode)
      BIND(CONCAT("MSA court ", ?code, " (", ?plabel, ") ALIVE") AS ?title)
      BIND(CONCAT(?clabel, " is ALIVE on its own receipts: at least 30 independent units, 0 misses, 0 false accepts and 0 stale accepts, Cohen's kappa defined over good and bad items, every verifier disagreement routed UNKNOWN; status today ",
        ?status, ".") AS ?post)
      BIND(CONCAT("A planted bad item, a stale receipt or a near-miss passes MSA court ", ?code,
        " (", ?plabel, "), or the court is credited ALIVE with fewer than 30 units.") AS ?falText)
    } UNION {
      ?source a nlb:CapabilityGap ; nlb:gapCode ?gcode ; rdfs:label ?glabel ; nlb:gapStatus ?gstatus ;
        nlb:targetRepository ?target ; nlb:referenceOrder ?ref ; prov:wasDerivedFrom ?trace .
      ?ref nlb:referenceTask ?task ; nlb:referenceFalsifier ?rfal .
      BIND("CAPABILITY_GAP" AS ?kind)
      BIND(CONCAT("GAP-", ?gcode) AS ?idcode)
      BIND(CONCAT("Capability ", ?gcode, ": ", ?glabel) AS ?title)
      BIND(CONCAT("The ", ?gstatus, " capability '", ?glabel, "' exists and is witnessed: ", ?task) AS ?post)
      BIND(?rfal AS ?falText)
    }
    BIND(CONCAT(?prefix, ?idcode) AS ?id)
    BIND(COALESCE(?famCap, IF(?kind = "MSA_COURT", ?msaCap, ?gapCap)) AS ?cap)
    BIND(IRI(CONCAT(?ns, ?id)) AS ?order)
    BIND(IRI(CONCAT(?ns, ?id, "-acceptance")) AS ?acc)
    BIND(IRI(CONCAT(?ns, ?id, "-falsifier")) AS ?fal)
    BIND(IRI(CONCAT(?ns, ?id, "-court")) AS ?court)
    BIND(IRI(CONCAT(?ns, ?id, "-action")) AS ?act)
    BIND(IRI(CONCAT(?ns, ?id, "-entry")) AS ?entry)
    BIND(CONCAT(?id, " ", ?title) AS ?label)
    BIND(CONCAT("Generated by the nonllm-class-qualification-pack plan CONSTRUCT (templates/plan-orders.ttl.tmpl) from the design node ",
      STR(?source), " (", ?kind, "); successor work of the benchmark design, executed on ", ?target, ".") AS ?desc)
    BIND(STR(?source) AS ?subject)
    BIND(CONCAT(?rprefix, ?id) AS ?replay)
    BIND(CONCAT("successor:", ?target) AS ?scope)
    BIND(CONCAT(?id, " acceptance") AS ?accLabel)
    BIND(CONCAT(?id, " falsifier") AS ?falLabel)
    BIND(CONCAT(?id, " court") AS ?courtLabel)
    BIND(CONCAT("The successor court of ", ?id, " observes the postcondition on the exact executed subject and records its exit status in an R-schema receipt.") AS ?courtText)
    BIND(CONCAT("Execute ", ?id) AS ?actLabel)
    BIND(CONCAT("Execute ", ?id, " through the generated executor path on ", ?target, " and write a receipt whose identity names this order.") AS ?actText)
    BIND(CONCAT(?id, " plan entry") AS ?entryLabel)
  }
sparql:
  orders: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?order ?id ?label ?title ?desc ?repo ?base ?subject ?standing ?ec ?eh ?ac ?ar ?promo ?replay ?scope
           ?court ?courtLabel ?courtText ?ev ?acc ?accLabel ?post ?fal ?falLabel ?falText ?proj ?act ?actLabel ?actText
           ?cp ?rc ?bc ?cap ?cc ?excl ?succ WHERE {
      ?e a nlb:PlanEntry ; nlb:planOrder ?order .
      ?order dcterms:identifier ?id ; rdfs:label ?label ; dcterms:title ?title ; dcterms:description ?desc ;
        sj:repository ?repo ; sj:baseSha ?base ; sj:subject ?subject ; sj:standing ?standing ;
        sj:evidenceCeiling ?ec ; sj:evidenceHorizon ?eh ; sj:authorityCeiling ?ac ; sj:authorityRequirement ?ar ;
        sj:promotionRule ?promo ; sj:replayIdentity ?replay ; sj:pathScope ?scope ; sj:requiresCourt ?court ;
        sj:requiresEvidence ?ev ; sj:acceptance ?acc ; sj:falsifier ?fal ; sj:projection ?proj ; sj:nextAction ?act ;
        sj:nextCheckpoint ?cp ; sj:requiresReceiptClass ?rc ; sj:checkpointOf ?cp ; sj:boundaryClass ?bc ;
        sj:postcondition ?post ; sj:requiresCapability ?cap ; sj:consequenceClass ?cc ; sj:exclusion ?excl ;
        sj:successorPolicy ?succ .
      ?acc rdfs:label ?accLabel .
      ?fal rdfs:label ?falLabel ; dcterms:description ?falText .
      ?court rdfs:label ?courtLabel ; dcterms:description ?courtText .
      ?act rdfs:label ?actLabel ; dcterms:description ?actText .
    }
    ORDER BY ?id
  entries: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    SELECT ?entry ?order ?id ?elabel ?source ?kind ?target
           (SAMPLE(?famv) AS ?fam) (SAMPLE(?klassv) AS ?klass) (SAMPLE(?tierv) AS ?tier)
           (GROUP_CONCAT(DISTINCT STR(?ref); separator=" ") AS ?refs)
           (GROUP_CONCAT(DISTINCT STR(?trace); separator=" ") AS ?traces) WHERE {
      ?entry a nlb:PlanEntry ; rdfs:label ?elabel ; nlb:planOrder ?order ; nlb:planSource ?source ; nlb:planKind ?kind ;
        nlb:targetRepository ?target ; nlb:referenceOrder ?ref ; prov:wasDerivedFrom ?trace .
      ?order dcterms:identifier ?id .
      OPTIONAL { ?entry nlb:planFamily ?famv }
      OPTIONAL { ?entry nlb:planClass ?klassv }
      OPTIONAL { ?entry nlb:planTier ?tierv }
    }
    GROUP BY ?entry ?order ?id ?elabel ?source ?kind ?target
    ORDER BY ?id
---
# GENERATED by ggen sync from nonllm-class-qualification-pack (templates/plan-orders.ttl.tmpl); do not hand-edit.
# The generated qualification plan: one tuple-complete sj:WorkOrder per KNOWN_CANDIDATE class x
# benchmark family (next evidence tier), per MSA court and per capability gap, each with acceptance,
# falsifier, court and action nodes, and one nlb:PlanEntry provenance node per order.
# {{ orders | length }} work orders; {{ entries | length }} plan entries.
@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix nlb: <https://ggen.dev/nonllm-bench#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
{% for o in orders %}
<{{ o.order }}> a sj:WorkOrder ;
    rdfs:label {{ o.label | json_encode() }} ;
    dcterms:identifier {{ o.id | json_encode() }} ;
    dcterms:title {{ o.title | json_encode() }} ;
    dcterms:description {{ o.desc | json_encode() }} ;
    sj:repository {{ o.repo | json_encode() }} ;
    sj:baseSha {{ o.base | json_encode() }} ;
    sj:subject {{ o.subject | json_encode() }} ;
    sj:standing {{ o.standing | json_encode() }} ;
    sj:evidenceCeiling {{ o.ec | json_encode() }} ;
    sj:evidenceHorizon {{ o.eh | json_encode() }} ;
    sj:authorityCeiling {{ o.ac | json_encode() }} ;
    sj:authorityRequirement {{ o.ar | json_encode() }} ;
    sj:promotionRule {{ o.promo | json_encode() }} ;
    sj:replayIdentity {{ o.replay | json_encode() }} ;
    sj:pathScope {{ o.scope | json_encode() }} ;
    sj:requiresCourt <{{ o.court }}> ;
    sj:requiresEvidence <{{ o.ev }}> ;
    sj:acceptance <{{ o.acc }}> ;
    sj:falsifier <{{ o.fal }}> ;
    sj:projection <{{ o.proj }}> ;
    sj:nextAction <{{ o.act }}> ;
    sj:nextCheckpoint <{{ o.cp }}> ;
    sj:requiresReceiptClass {{ o.rc | json_encode() }} ;
    sj:checkpointOf <{{ o.cp }}> ;
    sj:boundaryClass <{{ o.bc }}> ;
    sj:postcondition {{ o.post | json_encode() }} ;
    sj:requiresCapability <{{ o.cap }}> ;
    sj:consequenceClass {{ o.cc | json_encode() }} ;
    sj:exclusion {{ o.excl | json_encode() }} ;
    sj:successorPolicy {{ o.succ | json_encode() }} .
<{{ o.acc }}> a sj:AcceptanceCriterion ; rdfs:label {{ o.accLabel | json_encode() }} ; dcterms:description {{ o.post | json_encode() }} .
<{{ o.fal }}> a sj:Falsifier ; rdfs:label {{ o.falLabel | json_encode() }} ; dcterms:description {{ o.falText | json_encode() }} .
<{{ o.court }}> a sj:Court ; rdfs:label {{ o.courtLabel | json_encode() }} ; dcterms:description {{ o.courtText | json_encode() }} .
<{{ o.act }}> a sj:Action ; rdfs:label {{ o.actLabel | json_encode() }} ; dcterms:description {{ o.actText | json_encode() }} .
{% endfor %}
{% for e in entries %}
<{{ e.entry }}> a nlb:PlanEntry ;
    rdfs:label {{ e.elabel | json_encode() }} ;
    nlb:planOrder <{{ e.order }}> ;
    nlb:planSource <{{ e.source }}> ;
    nlb:planKind {{ e.kind | json_encode() }} ;
{%- if e.fam %}
    nlb:planFamily <{{ e.fam }}> ;
{%- endif %}
{%- if e.klass %}
    nlb:planClass <{{ e.klass }}> ;
{%- endif %}
{%- if e.tier %}
    nlb:planTier <{{ e.tier }}> ;
{%- endif %}
    nlb:targetRepository {{ e.target | json_encode() }} ;
{%- for r in e.refs | split(pat=" ") | sort %}
    nlb:referenceOrder <{{ r }}> ;
{%- endfor %}
{%- for t in e.traces | split(pat=" ") | sort %}
    prov:wasDerivedFrom <{{ t }}>{% if loop.last %} .{% else %} ;{% endif %}
{%- endfor %}
{% endfor %}