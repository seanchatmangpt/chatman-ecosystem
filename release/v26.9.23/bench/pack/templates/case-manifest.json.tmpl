---
to: "out/cases/{{ case }}.json"
for_each: cases
sparql:
  cases: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX es: <https://ggen.dev/ontology/evidence-standing#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?case ?family ?klass ?expected ?reason ?executor WHERE {
      {
        ?c a nlb:NearMissCase ; nlb:nearClass ?k ; nlb:expectedStanding ?s ; nlb:expectedReason ?reason .
        ?k nlb:classCode ?klass .
        BIND("B6" AS ?family)
        BIND("UNSUPPORTED(executor): pre-resolve membership probe order CE23-12-OP-04" AS ?executor)
      } UNION {
        ?c a nlb:NegativeControlCase ; nlb:expectedStanding ?s ; nlb:expectedReason ?reason ; nlb:executorStatus ?executor .
        BIND("B2" AS ?family)
        BIND("" AS ?klass)
      }
      BIND(STRAFTER(STR(?c), "#") AS ?case)
      BIND(STRAFTER(STR(?s), "#") AS ?expected)
    }
    ORDER BY ?case
---
{"_generated": "GENERATED by ggen sync from nonllm-class-qualification-pack (templates/case-manifest.json.tmpl); do not hand-edit.",
 "case": {{ case | json_encode() }},
 "family": {{ family | json_encode() }},
 "class": {% if klass == "" %}null{% else %}{{ klass | json_encode() }}{% endif %},
 "expected_standing": {{ expected | json_encode() }},
 "expected_reason": {{ reason | json_encode() }},
 "executor": {"status": {{ executor | json_encode() }}, "argv": []},
 "counts_toward_n": false
}
