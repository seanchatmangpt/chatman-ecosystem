---
to: out/doe/factor-standing.json
sparql:
  factors: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?support ?column ?reason WHERE {
      ?f a nlb:Factor ; rdfs:label ?label ; nlb:support ?support .
      OPTIONAL { ?f nlb:column ?c } OPTIONAL { ?f nlb:supportReason ?r }
      BIND(COALESCE(?c, "") AS ?column) BIND(COALESCE(?r, "") AS ?reason)
    }
    ORDER BY ?support ?label
---
{"_generated": "GENERATED by ggen sync from nonllm-class-qualification-pack (templates/doe-factor-standing.json.tmpl); do not hand-edit.",
 "evidence_ceiling": "cross-OS robustness remains outside the demonstrated evidence ceiling: an UNSUPPORTED factor never appears in a run and no cross-platform evidence is synthesized",
 "factors": [{% for f in factors %}
  {"factor": {{ f.label | json_encode() }}, "support": "{{ f.support }}", "column": {% if f.column == "" %}null{% else %}"{{ f.column }}"{% endif %}, "reason": {{ f.reason | json_encode() }}}{% if not loop.last %},{% endif %}{% endfor %}
 ]}
