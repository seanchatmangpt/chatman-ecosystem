{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatmangpt.github.io/chatman-ecosystem/spec/spg.schema.json",
  "title": "Chatman Semantic Procedural Graph",
  "type": "object",
  "required": ["schema", "id", "version", "state", "standing", "nodes", "edges", "projections", "prior_art"],
  "properties": {
    "schema": {"const": "chatman.spg.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "state": {"enum": ["CANDIDATE", "ADMITTED", "REFUSED"]},
    "standing": {"enum": ["NONE", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "UNSUPPORTED"]},
    "nodes": {"type": "array", "minItems": 1},
    "edges": {"type": "array", "minItems": 1},
    "projections": {"type": "object"},
    "prior_art": {"type": "array"}
  },
  "additionalProperties": true
}
