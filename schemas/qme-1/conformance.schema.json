{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qme:1:conformance:26.9.29",
  "title": "QME-1 Conformance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "profile",
    "evidence_horizon",
    "standing",
    "canonical_owners",
    "semantic_claims",
    "authority_ceiling",
    "authority_basis",
    "consequence",
    "observation",
    "attempt",
    "receipt",
    "replay",
    "falsifiers",
    "negative_knowledge",
    "guard_retirements",
    "external_candidates",
    "value",
    "generated"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^QME-1(?:/.*)?$"
    },
    "evidence_horizon": {
      "type": "string",
      "minLength": 1
    },
    "standing": {
      "enum": [
        "UNKNOWN",
        "PARTIAL_ALIVE",
        "ALIVE",
        "BLOCKED",
        "BUILD_BROKEN",
        "UNSUPPORTED",
        "REFUSED"
      ]
    },
    "canonical_owners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantic_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "consequential",
          "visible",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "consequential": {
            "type": "boolean"
          },
          "visible": {
            "type": "boolean"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority_ceiling": {
      "enum": [
        "none",
        "select",
        "construct",
        "do"
      ]
    },
    "authority_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "consequence": {
      "type": "object",
      "required": [
        "bounded",
        "class"
      ],
      "properties": {
        "bounded": {
          "type": "boolean"
        },
        "class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "independent"
      ],
      "properties": {
        "independent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "observed",
        "violation_observed",
        "boundary"
      ],
      "properties": {
        "observed": {
          "type": "boolean"
        },
        "violation_observed": {
          "type": "boolean"
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "subject",
        "id"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": [
        "actuates"
      ],
      "properties": {
        "actuates": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_knowledge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/negative"
      }
    },
    "guard_retirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard_retirement"
      }
    },
    "external_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "promotes_to_local_do"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "promotes_to_local_do": {
            "type": "boolean"
          }
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded",
        "capability_gain",
        "durable_experience",
        "hardening_gain",
        "reuse_gain",
        "cost",
        "net"
      ],
      "properties": {
        "bounded": {
          "type": "boolean"
        },
        "capability_gain": {
          "type": "number"
        },
        "durable_experience": {
          "type": "number"
        },
        "hardening_gain": {
          "type": "number"
        },
        "reuse_gain": {
          "type": "number"
        },
        "cost": {
          "type": "number"
        },
        "net": {
          "type": "number"
        }
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "is_projection"
      ],
      "properties": {
        "is_projection": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "_expected_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "boundary",
        "condition",
        "evidence_horizon",
        "excluded",
        "authority_impact",
        "consequence_impact",
        "falsifier",
        "successor",
        "receipt",
        "replay_identity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "evidence_horizon": {
          "type": "string"
        },
        "excluded": {
          "type": "string"
        },
        "authority_impact": {
          "type": "string"
        },
        "consequence_impact": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        },
        "successor": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        },
        "replay_identity": {
          "type": "string"
        }
      }
    },
    "guard_retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard",
        "subject",
        "same_subject_evidence",
        "falsifier"
      ],
      "properties": {
        "guard": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "same_subject_evidence": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        }
      }
    }
  }
}
