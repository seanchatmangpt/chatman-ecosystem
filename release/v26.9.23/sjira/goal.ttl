# -- CE23-12 and its three conjunct gates -------------------------------------
# chatman-ce23-12-bench.md adds CE23-12 as a Chatman CE23 crown gate (the
# GC23-0..12 contract stays stable); chatman-ce23-12-standings.md binds it for
# v26.9.23 to CE23-12 = BenchmarkDesign ∧ MSAContract ∧
# GeneratedQualificationPlan. Design capital (substrate, candidate standing,
# not repo code), /Users/sac/wt/v26922/v26923/bench/:
#   DESIGN.md          sha256:f4d185d70ea3e7d56a4ba19b8e07c04c933efd5c705b5d918566658eaf579a19
#   ontology-draft.ttl sha256:3a17698927ee0c7053e76f4d516d7a14a2f92e35ee2db0971c8f432ed58aecdf
#   orders.json        sha256:332d01021ae817734a7ac568cd30e4076ce5a864d3c576168d267a38caa60843
# orders.json holds the hand-assembled reference orders CE23-12-BD-01..09;
# they are NOT work orders of this graph -- the CE23-12 orders are compiler
# output of the two prose units. The bench and standings extraction JSON
# (candidates/raw/) is the recorded LLM edge of that design run
# (llm:claude-opus-5-5@wf_a0af447e-5fa/bench:design), reused rather than
# re-extracted (ARD section 5.5: no second LLM pass over the same revision).

ce:CE23-12 a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-12" ;
    rdfs:label "CE23-12 DfLSS non-LLM benchmark design crown" ;
    dcterms:description "CE23-12: NonLLMClassClosureBenchmark (chatman-ce23-12-bench.md), for v26.9.23 bound to CE23-12 = BenchmarkDesign ∧ MSAContract ∧ GeneratedQualificationPlan (chatman-ce23-12-standings.md): the release establishes the measurement system and qualification contract now; actual class-level operational standing must come from executed benchmark receipts." ;
    rdfs:comment "Crown amendment: CE23-12 joins the root crown as a Chatman CE23 crown gate (chatman-ce23-12-bench.md: 'make this a Chatman CE23 crown gate, rather than mutating the already-admitted Semantic Manufacturing checkpoint'). Standing for v26.9.23: BENCHMARK_DESIGN_ALIVE; NON_LLM_OPERATIONAL_ALIVE is never implied." ;
    sj:checkpointOf ce:GC-CE-26.9.23 ;
    sj:boundaryClass sj:LastMile ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23-12-bench.md" ;
    sj:sourceSha256 "sha256:4146d688c21db6e1af51a2187df8056b1a0f977001c817d64fbde0547029b485" ;
    sj:exclusion "BENCHMARK_DESIGN_ALIVE does not imply NONLLM_OPERATIONAL_ALIVE (chatman-ce23-12-standings.md); no benchmark class standing is promoted by design." ;
    sj:courtCommand "sh release/v26.9.23/courts/CE23-12.sh" ;
    sj:acceptance ce:CE23-12-acceptance ;
    sj:falsifier ce:CE23-12-falsifier .
ce:CE23-12-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-12 acceptance" ;
    dcterms:description "CE23-12 = BenchmarkDesign ∧ MSAContract ∧ GeneratedQualificationPlan (chatman-ce23-12-standings.md): each conjunct gate has an ALIVE gate receipt at the exact Chatman SHA, and every receipt records non_llm_operational UNKNOWN for every class without executed unseen-member receipts." .
ce:CE23-12-falsifier a sj:Falsifier ;
    rdfs:label "CE23-12 falsifier" ;
    dcterms:description "BENCHMARK_DESIGN_ALIVE ⇏ NONLLM_OPERATIONAL_ALIVE (chatman-ce23-12-standings.md): the CE23-12 court exits 0 while a conjunct gate lacks an ALIVE receipt, or while some class standing is NON_LLM_OPERATIONAL_ALIVE (or BENCHMARK_QUALIFIED) without executed unseen-member receipts -- treating documentation about execution as execution." .

ce:CE23-12-BenchmarkDesign a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-12-BenchmarkDesign" ;
    rdfs:label "CE23-12 conjunct BenchmarkDesign" ;
    dcterms:description "BenchmarkDesign (chatman-ce23-12-standings.md): D = claimed KNOWN classes and CTQs defined; M = measurement/receipt/OCEL model defined; benchmark ontology admitted; candidate classes enumerated; membership tests identified; independent verifiers identified; near-miss/UNKNOWN falsifiers identified; all generated artifacts trace to operator prose." ;
    sj:checkpointOf ce:CE23-12 ;
    sj:boundaryClass sj:LastMile ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23-12-standings.md" ;
    sj:sourceSha256 "sha256:80091c45b16d6afbf0bfa5717726c9221f35905f5650fad03b8cd81cbcb5b2d2" ;
    sj:courtCommand "sh release/v26.9.23/courts/CE23-12-BenchmarkDesign.sh" ;
    sj:acceptance ce:CE23-12-BenchmarkDesign-acceptance ;
    sj:falsifier ce:CE23-12-BenchmarkDesign-falsifier .
ce:CE23-12-BenchmarkDesign-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-12-BenchmarkDesign acceptance" ;
    dcterms:description "Acceptance (chatman-ce23-12-standings.md): benchmark ontology admitted; candidate classes enumerated; membership tests identified; independent verifiers identified; near-miss/UNKNOWN falsifiers identified; all generated artifacts trace to operator prose -- with D (claimed KNOWN classes and CTQs) and M (measurement/receipt/OCEL model) defined." .
ce:CE23-12-BenchmarkDesign-falsifier a sj:Falsifier ;
    rdfs:label "CE23-12-BenchmarkDesign falsifier" ;
    dcterms:description "The court exits 0 while a claimed KNOWN class has only a declared label (no membership test), no independent verifier, no near-miss UNKNOWN falsifier, or a design node that traces to no operator prose span." .

ce:CE23-12-MSAContract a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-12-MSAContract" ;
    rdfs:label "CE23-12 conjunct MSAContract" ;
    dcterms:description "MSAContract (chatman-ce23-12-standings.md): MSA = Repeatability_verifier ∧ Reproducibility_environment ∧ MutationSensitivity ∧ ClassificationAgreement -- before trusting benchmark results, test the benchmark itself." ;
    sj:checkpointOf ce:CE23-12 ;
    sj:boundaryClass sj:LastMile ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23-12-standings.md" ;
    sj:sourceSha256 "sha256:80091c45b16d6afbf0bfa5717726c9221f35905f5650fad03b8cd81cbcb5b2d2" ;
    sj:courtCommand "sh release/v26.9.23/courts/CE23-12-MSAContract.sh" ;
    sj:acceptance ce:CE23-12-MSAContract-acceptance ;
    sj:falsifier ce:CE23-12-MSAContract-falsifier .
ce:CE23-12-MSAContract-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-12-MSAContract acceptance" ;
    dcterms:description "The generated court answers each MSA question (chatman-ce23-12-standings.md): Does the same artifact always receive the same verdict? Do independent verifiers agree? Does an intentionally corrupted output reliably fail? Does a stale receipt reliably fail? Can benchmark ordering change the answer? Does cached state change classification? Can the membership test confuse a near-miss UNKNOWN with KNOWN?" .
ce:CE23-12-MSAContract-falsifier a sj:Falsifier ;
    rdfs:label "CE23-12-MSAContract falsifier" ;
    dcterms:description "Otherwise a 100% benchmark pass rate might only establish a weak benchmark (chatman-ce23-12-standings.md): the court exits 0 while an MSA property has no court, or a corrupted output, a stale receipt or a near-miss passes as KNOWN." .

ce:CE23-12-GeneratedQualificationPlan a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-12-GeneratedQualificationPlan" ;
    rdfs:label "CE23-12 conjunct GeneratedQualificationPlan" ;
    dcterms:description "GeneratedQualificationPlan (chatman-ce23-12-standings.md): A = experiment, DOE, corpus, statistics and qualification rules defined; DOE support matrix generated; statistical acceptance rules generated; benchmark work orders generated; standing typed by evidence volume (class, n, defects, confidence, environment, factors, receipt; tiers N 30/100/300/3000); Factor(OS) = UNSUPPORTED on a macOS-only executor." ;
    sj:checkpointOf ce:CE23-12 ;
    sj:boundaryClass sj:LastMile ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23-12-standings.md" ;
    sj:sourceSha256 "sha256:80091c45b16d6afbf0bfa5717726c9221f35905f5650fad03b8cd81cbcb5b2d2" ;
    sj:exclusion "Do not synthesize fake cross-platform evidence (chatman-ce23-12-standings.md)." ;
    sj:courtCommand "sh release/v26.9.23/courts/CE23-12-GeneratedQualificationPlan.sh" ;
    sj:acceptance ce:CE23-12-GeneratedQualificationPlan-acceptance ;
    sj:falsifier ce:CE23-12-GeneratedQualificationPlan-falsifier .
ce:CE23-12-GeneratedQualificationPlan-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-12-GeneratedQualificationPlan acceptance" ;
    dcterms:description "Acceptance (chatman-ce23-12-standings.md): DOE support matrix generated; statistical acceptance rules generated; benchmark work orders generated; the qualification system distinguishes N_discovery < N_qualification < N_operational, and the receipt explicitly says that cross-OS robustness remains outside the demonstrated evidence ceiling." .
ce:CE23-12-GeneratedQualificationPlan-falsifier a sj:Falsifier ;
    rdfs:label "CE23-12-GeneratedQualificationPlan falsifier" ;
    dcterms:description "The court exits 0 while the DOE gives the unsupported OS factor a column (a nominal design whose factors were not actually varied), a zero-failure run is read as more than its evidence tier bounds (0 failures in 30 trials bounds p_f only below about 0.10), or a benchmark work order is hand-written rather than generated." .

