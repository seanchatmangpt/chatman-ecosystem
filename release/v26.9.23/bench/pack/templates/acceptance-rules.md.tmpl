    ORDER BY ?order
  unsupported: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?support ?reason WHERE { ?f a nlb:Factor ; rdfs:label ?label ; nlb:support ?support ; nlb:supportReason ?reason . FILTER(?support != "VARIED") }
    ORDER BY ?label
