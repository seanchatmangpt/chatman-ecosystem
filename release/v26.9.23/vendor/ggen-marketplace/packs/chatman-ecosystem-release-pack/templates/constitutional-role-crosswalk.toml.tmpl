---
to: out/constitutional-role-crosswalk.toml
sparql:
  release: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?release ?version
    WHERE {
      ?release a er:Release .
      OPTIONAL { ?release er:version ?v . }
      BIND(COALESCE(STR(?v), "") AS ?version)
    }
    ORDER BY ?release
  calculus: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?name ?order WHERE { ?r a er:ConstitutionalRole ; er:constitutionalName ?name ; er:calculusOrder ?order . }
    ORDER BY ?order ?name
  mappings: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?m ?role ?primary ?ceiling ?brce
    WHERE {
      ?release a er:Release ; er:requiredRole ?role .
      OPTIONAL {
        ?release er:hasRoleMapping ?m .
        ?m er:releaseRole ?mappedRole .
        FILTER(STR(?mappedRole) = STR(?role))
        OPTIONAL { ?m er:primary ?p . ?p er:constitutionalName ?pn . }
        OPTIONAL { ?m er:authorityCeiling ?ac . }
        OPTIONAL { ?m er:brceExclusive ?be . }
      }
      BIND(COALESCE(STR(?pn), "") AS ?primary)
      BIND(COALESCE(STR(?ac), "") AS ?ceiling)
      BIND(IF(BOUND(?be) && ?be = true, "true", "") AS ?brce)
    }
    ORDER BY ?role ?m
  capabilities: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?m ?name ?order
    WHERE {
      ?release a er:Release ; er:hasRoleMapping ?m .
      ?m er:capability ?cap .
      ?cap er:constitutionalName ?name ; er:calculusOrder ?order .
    }
    ORDER BY ?m ?order ?name
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/constitutional-role-crosswalk.toml.tmpl). Do not hand-edit: a hand
# edit makes the next `ggen sync run` refuse (FM-WRITE-005). One [[crosswalk]]
# entry per release required role (OPTIONAL join; gate 075 refuses an unmapped
# role before rendering), so survey_portfolio RELEASE_ROLE_UNMAPPED stays clean.
{% for r in release %}[constitutional]
version = {{ r.version | json_encode() }}
source = "frozen-constitutional-calculus"
allowed_roles = [{% for c in calculus %}
  {{ c.name | json_encode() }},{% endfor %}
]
{% endfor %}{% for m in mappings %}
[[crosswalk]]
release_role = {{ m.role | json_encode() }}
primary = {{ m.primary | json_encode() }}
capabilities = [{% for c in capabilities %}{% if c.m == m.m | default(value="") %}{{ c.name | json_encode() }}, {% endif %}{% endfor %}]
authority_ceiling = {{ m.ceiling | json_encode() }}{% if m.brce %}
brce_exclusive = true{% endif %}
{% endfor %}
