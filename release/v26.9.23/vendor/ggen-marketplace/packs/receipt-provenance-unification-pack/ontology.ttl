rp:vf_standing_dfcm_exact a rp:ValueForm ;
    skos:prefLabel "standing-dfcm-exact" ; rp:jsonType "string" ;
    rp:pattern "^(UNKNOWN|PARTIAL_ALIVE|ALIVE|BLOCKED(:.+)?|BUILD_BROKEN|UNSUPPORTED(\\(.+\\))?|REFUSED\\(.+\\))\\Z" ;
    rdfs:comment "receipt.schema.json:62 with \\Z for $: the schema pattern admits \"ALIVE\\n\", which validate_receipt.py:18 (st == \"ALIVE\") then exempts from the replay-exit check, so an ALIVE-looking receipt with a failing replay is ADMITTED (qualification/fixtures/dfcm_fleet_v1/pos-alive-trailing-newline-exit75.json)." ;
    rp:sourceFile "/Users/sac/.claude/dfcm/receipt.schema.json" ; rp:sourceLine 62 .

rp:f_dd_sval a rp:FieldBinding ; rp:contract rp:c_dfcm_fleet ; rp:profile rp:profile_durable ;
    rp:dottedPath "standing.value" ; rp:valueForm rp:vf_standing_dfcm_exact ; rp:mandatory true ;
