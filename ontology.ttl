[] a org:Organization ;
    rdfs:label "Kubernetes control plane images / official container base images (node:20-slim, node:22-slim, python:3.12-slim, python:3.13-slim, rustlang/rust:nightly-slim)" ;
    dcterms:type "SUBSERVICE-ORG" ;
    dcterms:coverage "Application and service container images are built FROM these public upstream base images; no evidence of a signed/pinned base-image provenance policy beyond the trivy vulnerability scan described in vuln-scan.ts." ;
    dcterms:requires "Static grep of Dockerfile FROM lines across platform-console." .

[] a org:Organization ;
    rdfs:label "aquasec/trivy (Aqua Security open-source scanner) and its public vulnerability DB mirror (mirror.gcr.io/aquasec/trivy-db)" ;
    dcterms:type "SUBSERVICE-ORG" ;
    dcterms:coverage "Used as the platform's real vulnerability-scanning dependency (vuln-scan.ts); the CVE database is pulled from this third-party mirror at scan time, so scan accuracy depends on this external service's data freshness/availability." ;
    dcterms:requires "Read platform-console/app/lib/vuln-scan.ts comments describing the real trivy pull and containerd-socket scan mechanism." .

[] a org:Organization ;
    rdfs:label "GitHub Actions marketplace actions (actions/checkout, dtolnay/rust-toolchain, Swatinem/rust-cache, taiki-e/install-action)" ;
