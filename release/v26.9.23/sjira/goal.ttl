    sj:checkpointOf ce:GC-CE-26.9.23 ;
    sj:boundaryClass sj:Core ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23.md" ;
    sj:sourceSha256 "sha256:6d788331a4ebc5ad34c3579acc71d6572197ba830eaea23188f468505a1954d3" ;
