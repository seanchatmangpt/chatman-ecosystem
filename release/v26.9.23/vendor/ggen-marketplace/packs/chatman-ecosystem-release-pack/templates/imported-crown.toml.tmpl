---
to: out/imported-crown.toml
sparql:
  crowns: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?crown ?checkpoint ?standing ?subject ?stopDigest ?required ?llm ?unreceipted ?crownRepo ?crownSha ?pairedRepo ?pairedSha
    WHERE {
      ?crown a er:ImportedCrown .
      OPTIONAL { ?crown er:crownCheckpoint ?cp . }
      OPTIONAL { ?crown er:stopStanding ?st . }
      OPTIONAL { ?crown er:crownSubjectSha ?s . }
      OPTIONAL { ?crown er:stopReceiptSha256 ?d . }
      OPTIONAL { ?crown er:requiredGateCount ?r . }
      OPTIONAL { ?crown er:llmInvocationsOnKnownReferencePath ?l . }
      OPTIONAL { ?crown er:unreceiptedActuation ?u . }
      OPTIONAL { ?crown er:crownComponent ?c . OPTIONAL { ?c er:repository ?cr . } OPTIONAL { ?c er:commitSha ?cs . } }
      OPTIONAL { ?crown er:pairedComponent ?p . OPTIONAL { ?p er:repository ?pr . } OPTIONAL { ?p er:commitSha ?ps . } }
      BIND(COALESCE(STR(?cp), "") AS ?checkpoint)
      BIND(COALESCE(STRAFTER(STR(?st), "#"), STR(?st), "") AS ?standing)
      BIND(COALESCE(STR(?s), "") AS ?subject)
      BIND(COALESCE(STR(?d), "") AS ?stopDigest)
      BIND(COALESCE(STR(?r), "") AS ?required)
      BIND(COALESCE(STR(?l), "") AS ?llm)
      BIND(COALESCE(STR(?u), "") AS ?unreceipted)
      BIND(COALESCE(STR(?cr), "") AS ?crownRepo)
      BIND(COALESCE(STR(?cs), "") AS ?crownSha)
      BIND(COALESCE(STR(?pr), "") AS ?pairedRepo)
      BIND(COALESCE(STR(?ps), "") AS ?pairedSha)
    }
    ORDER BY ?checkpoint ?crown
  gates: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?crown ?id ?standing ?subject ?paired ?digest
    WHERE {
      ?crown a er:ImportedCrown ; er:hasGateReceipt ?g .
      OPTIONAL { ?g er:gateId ?gid . }
      OPTIONAL { ?g er:gateStanding ?gst . }
      OPTIONAL { ?g er:gateSubjectSha ?gs . }
      OPTIONAL { ?g er:pairedSubjectSha ?gp . }
      OPTIONAL { ?g er:receiptSha256 ?gd . }
      BIND(COALESCE(STR(?gid), STR(?g)) AS ?id)
      BIND(COALESCE(STRAFTER(STR(?gst), "#"), STR(?gst), "") AS ?standing)
      BIND(COALESCE(STR(?gs), "") AS ?subject)
      BIND(COALESCE(STR(?gp), "") AS ?paired)
      BIND(COALESCE(STR(?gd), "") AS ?digest)
    }
    ORDER BY ?crown ?id ?digest
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/imported-crown.toml.tmpl). Do not hand-edit: a hand edit makes the next
# `ggen sync run` refuse (FM-WRITE-005). One [[imported_crown]] per er:ImportedCrown of the
# consumer graph (lifted by bin/import-crown-lift.py); gate 090 refuses the sync before
# this renders unless STOP is ALIVE, the required gates are ALIVE at the crown subject and
# against the paired subject, and both zero-intelligence counters are 0 (CE23-3, CE23-8).
[imported_crowns]
crown_count = {{ crowns | length }}
{% for c in crowns %}
[[imported_crown]]
checkpoint = {{ c.checkpoint | json_encode() }}
stop_standing = {{ c.standing | json_encode() }}
stop_subject_sha = {{ c.subject | json_encode() }}
stop_receipt_sha256 = {{ c.stopDigest | json_encode() }}
crown_repository = {{ c.crownRepo | json_encode() }}
crown_commit_sha = {{ c.crownSha | json_encode() }}
paired_repository = {{ c.pairedRepo | json_encode() }}
paired_commit_sha = {{ c.pairedSha | json_encode() }}
required_gate_count = {{ c.required }}
LLM_INVOCATIONS_ON_KNOWN_REFERENCE_PATH = {{ c.llm }}
UNRECEIPTED_ACTUATION = {{ c.unreceipted }}
{% for g in gates %}{% if g.crown == c.crown %}
[[imported_crown.gate]]
id = {{ g.id | json_encode() }}
standing = {{ g.standing | json_encode() }}
subject_sha = {{ g.subject | json_encode() }}
paired_subject_sha = {{ g.paired | json_encode() }}
receipt_sha256 = {{ g.digest | json_encode() }}
{% endif %}{% endfor %}{% endfor %}
