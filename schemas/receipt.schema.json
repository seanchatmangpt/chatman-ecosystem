{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatman.dev/schemas/receipt.schema.json",
  "title": "Chatman Ecosystem Receipt",
  "type": "object",
  "required": ["id", "subject", "actor", "authority", "intention", "observed", "executed", "changed", "verified", "replay", "standing_before", "standing_after", "timestamp", "digest"],
  "properties": {
    "id": {"type": "string", "pattern": "^receipt:[a-z0-9_-]+$"},
    "subject": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "authority": {"type": "string"},
    "intention": {"type": "string", "minLength": 1},
    "observed": {"type": "array", "items": {"type": "string"}},
    "executed": {"type": "array", "items": {"type": "string"}},
    "changed": {"type": "array", "items": {"type": "string"}},
    "verified": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "excluded": {"type": "array", "items": {"type": "string"}},
    "replay": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "standing_before": {"type": "string"},
    "standing_after": {"type": "string"},
    "timestamp": {"type": "string"},
    "digest": {"type": "string"}
  },
  "additionalProperties": false
}
