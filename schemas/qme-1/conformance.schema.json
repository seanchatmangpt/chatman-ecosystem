{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qme:1:conformance:26.9.29",
  "title": "QME-1 Conformance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "profile",
    "evidence_horizon",
    "canonical_owners",
    "authority_ceiling",
    "consequence",
    "observation",
    "receipt",
    "replay",
    "falsifiers",
    "negative_knowledge",
    "generated"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^QME-1(?:/.*)?$"
    },
    "evidence_horizon": {
      "type": "string",
      "minLength": 1
    },
    "canonical_owners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_ceiling": {
      "enum": [
        "none",
        "select",
        "construct",
        "do"
      ]
    },
    "consequence": {
      "type": "object",
      "required": [
        "bounded",
        "class"
      ],
      "properties": {
        "bounded": {
          "type": "boolean"
        },
        "class": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "independent"
      ],
      "properties": {
        "independent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "subject",
        "id"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": [
        "actuates"
      ],
      "properties": {
        "actuates": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_knowledge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/negative"
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "is_projection"
      ],
      "properties": {
        "is_projection": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "boundary",
        "condition",
        "excluded",
        "falsifier",
        "successor",
        "receipt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "excluded": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        },
        "successor": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        }
      }
    }
  }
}
