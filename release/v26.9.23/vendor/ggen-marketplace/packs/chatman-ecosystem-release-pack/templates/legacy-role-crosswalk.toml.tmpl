---
to: out/legacy-role-crosswalk.toml
sparql:
  pairs: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?source ?target ?sourceVersion ?targetVersion ?classification (COUNT(DISTINCT ?role) AS ?roleCount)
    WHERE {
      ?target a er:Release ; er:crosswalkFrom ?source .
      ?source er:legacyRequiredRole ?role .
      OPTIONAL { ?source dcterms:hasVersion ?sv . }
      OPTIONAL { ?target er:version ?tv . }
      OPTIONAL { ?target er:classificationSource ?cs . }
      BIND(COALESCE(STR(?sv), "") AS ?sourceVersion)
      BIND(COALESCE(STR(?tv), "") AS ?targetVersion)
      BIND(COALESCE(STR(?cs), "") AS ?classification)
    }
    GROUP BY ?source ?target ?sourceVersion ?targetVersion ?classification
    ORDER BY ?source ?target
  rows: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?role ?sourceVersion ?targetVersion ?component ?repository ?sha ?legacyStanding
           ?boundary ?derivedBy ?decidedBy ?reason ?classificationSource ?suppliedBy
    WHERE {
      ?target a er:Release ; er:crosswalkFrom ?source .
      ?source er:legacyRequiredRole ?role .
      OPTIONAL { ?source dcterms:hasVersion ?sv . }
      OPTIONAL { ?target er:version ?tv . }
      OPTIONAL {
        ?source er:legacyComponent ?lc .
        ?lc er:legacyRole ?role .
        OPTIONAL { ?lc er:componentId ?cid . }
        OPTIONAL { ?lc er:legacyRepository ?repo . }
        OPTIONAL { ?lc er:legacySha ?lsha . }
        OPTIONAL { ?lc er:legacyStanding ?lst . }
      }
      OPTIONAL {
        ?d a er:RoleDisposition ; er:legacyRole ?role ; er:sourceRelease ?source ; er:targetRelease ?target .
        OPTIONAL { ?d er:boundary ?b . }
        OPTIONAL { ?d er:derivedBy ?drv . }
        OPTIONAL { ?d er:decidedBy ?dec . }
        OPTIONAL { ?d er:reason ?why . }
        OPTIONAL { ?d er:classificationSource ?csrc . }
        OPTIONAL { ?d er:suppliedBy ?sup . OPTIONAL { ?sup er:componentId ?supId . } OPTIONAL { ?sup er:repository ?supRepo . } }
      }
      BIND(COALESCE(STR(?sv), "") AS ?sourceVersion)
      BIND(COALESCE(STR(?tv), "") AS ?targetVersion)
      BIND(COALESCE(STR(?cid), "") AS ?component)
      BIND(COALESCE(STR(?repo), "") AS ?repository)
      BIND(COALESCE(STR(?lsha), "") AS ?sha)
      BIND(COALESCE(STRAFTER(STR(?lst), "#"), "") AS ?legacyStanding)
      BIND(COALESCE(STRAFTER(STR(?b), "#ROLE_"), "") AS ?boundary)
      BIND(COALESCE(STR(?drv), "") AS ?derivedBy)
      BIND(COALESCE(STR(?dec), "") AS ?decidedBy)
      BIND(COALESCE(STR(?why), "") AS ?reason)
      BIND(COALESCE(STR(?csrc), "") AS ?classificationSource)
      BIND(COALESCE(STR(?supId), STRAFTER(STR(?supRepo), "/"), "") AS ?suppliedBy)
    }
    ORDER BY ?sourceVersion ?targetVersion ?role
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/legacy-role-crosswalk.toml.tmpl). Do not hand-edit: a hand edit makes
# the next `ggen sync run` refuse (FM-WRITE-005); regenerate by deleting this file.
# Rows come from the predecessor's required roles (OPTIONAL joins), never from an
# inner join on a disposition, so a role cannot silently disappear from this file;
# gate 070 refuses the sync before rendering if any role is undisposed.
{% for p in pairs %}[crosswalk]
source_release = {{ p.source | json_encode() }}
source_version = {{ p.sourceVersion | json_encode() }}
target_release = {{ p.target | json_encode() }}
target_version = {{ p.targetVersion | json_encode() }}
classification_source = {{ p.classification | json_encode() }}
role_count = {{ p.roleCount }}
{% endfor %}{% for r in rows %}
[[role]]
legacy_role = {{ r.role | json_encode() }}
legacy_component = {{ r.component | json_encode() }}
legacy_repository = {{ r.repository | json_encode() }}
legacy_sha = {{ r.sha | json_encode() }}
legacy_standing = {{ r.legacyStanding | json_encode() }}
boundary = {{ r.boundary | json_encode() }}
derived_by = {{ r.derivedBy | json_encode() }}
decided_by = {{ r.decidedBy | json_encode() }}
supplied_by = {{ r.suppliedBy | json_encode() }}
classification_source = {{ r.classificationSource | json_encode() }}
reason = {{ r.reason | json_encode() }}
source_version = {{ r.sourceVersion | json_encode() }}
target_version = {{ r.targetVersion | json_encode() }}
{% endfor %}
