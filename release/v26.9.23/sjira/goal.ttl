    sj:capabilityId "construct:chatman-ecosystem-lane" .
ce:cap-release-semantic-manufacturing a sj:Capability ;
    rdfs:label "Release: Semantic Manufacturing v26.9.23" ;
    dcterms:description "The Semantic Manufacturing release closure of xaas and ggen_igniter (GC-26.9.23; DRIVER.md release parts A3 and B, lane V23-Q, operator GC23-12 acceptance). The chatman root imports its receipts by digest and never actuates it; naming the capability grants no authority." ;
    sj:capabilityId "release:semantic-manufacturing" .
