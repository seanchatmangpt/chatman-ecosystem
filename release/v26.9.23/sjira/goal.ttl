ce:CE23-4-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-4 acceptance" ;
    dcterms:description "Admission condition (chatman-ce23.md, CE23-4): V23-H manufactures successor prose; its digest is explicitly accepted; self-hosting court passes." .
