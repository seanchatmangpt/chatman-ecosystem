  es:standingState es:UNKNOWN ;
  nlb:standingReason "candidate only: nonllm-class-qualification-pack not admitted (BD-D1), design graph not committed in a release subject (BD-06), projections not generated (BD-A1/A4/A6)" ;
  prov:wasDerivedFrom ce23:P-cc3821f7df83e938 .

