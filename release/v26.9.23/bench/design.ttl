# -- DOE factors (B3). Column assignment solved by BENCH-B3/assign_search.py (96 of 720 valid; lexicographic first) --
ce23:doe-B3 a nlb:FractionalFactorialDesign ;
  rdfs:label "2^(6-2) resolution IV over the VARIED factors" ;
  nlb:runCount 16 ; nlb:resolution 4 ; nlb:definingRelation "I=ABCE=ADEF=BCDF" ;
  nlb:runnerLabel "macos-15" ; nlb:runOrderSeed "ce23-12-b3-26.9.23" ;
  nlb:hasFactor ce23:factor-cold , ce23:factor-concurrency , ce23:factor-path , ce23:factor-env , ce23:factor-toolchain , ce23:factor-ordering ;
  nlb:replicationForTier "m members per run, same members in every run (blocks): m=4 -> 64 executions (DISCOVERY, bound 0.0457); m=8 -> 128 (QUALIFICATION, 0.0231); m=20 -> 320 (OPERATIONAL, 0.0093). Executions count toward class-transfer n only when each run uses fresh unseen members (then r=2 -> 32, r=7 -> 112, r=19 -> 304)." ;
  prov:wasDerivedFrom ce:P-d79566375284518a , ce:P-9b8d48190eeaac75 , ce:P-2d647d6e18f801df .
ce23:factor-cold a nlb:Factor ; rdfs:label "cold/warm" ; nlb:support "VARIED" ; nlb:column "A" ; nlb:bitWeight 1 ;
  nlb:lowRealization "warm: operator HOME caches + existing _build" ;
  nlb:highRealization "cold-A: fresh HOME seeded offline (hex 2.5.1, rebar3, rustler_precompiled cache), empty _build, deps cloned, ASDF_DATA_DIR/RUSTUP_HOME/CARGO_HOME pinned, cargo on PATH, HEX_OFFLINE=1" ;
  nlb:supportReason "cold-A end-to-end UNVERIFIED (178 deps built in 1231 s, then cargo enoent from PATH); cold-B (empty deps) needs network: excluded" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-concurrency a nlb:Factor ; rdfs:label "concurrency" ; nlb:support "VARIED" ; nlb:column "B" ; nlb:bitWeight 2 ;
  nlb:lowRealization "1 episode" ; nlb:highRealization "4 concurrent episodes, distinct MIX_TEST_PARTITION" ;
  nlb:supportReason "temp-dir names repeat across OS processes (System.unique_integer, xaas.episode.ex:234, semantic_drive.ex:2091); worktree provision check-then-create race (worktrees.ex:102-104): expected B3 defects" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-path a nlb:Factor ; rdfs:label "subject/work-root path" ; nlb:support "VARIED" ; nlb:column "C" ; nlb:bitWeight 4 ;
  nlb:lowRealization "short canonical path (<= 80 bytes)" ; nlb:highRealization "228-byte path with spaces for subject clone and --work-root" ;
  nlb:supportReason "executor checkout path held FIXED (cold x spaced executor path is BUILD_BROKEN: picosat_elixir Makefile); receipts embed absolute paths, so replay uses a path-normalized digest" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-env a nlb:Factor ; rdfs:label "environment" ; nlb:support "VARIED" ; nlb:column "D" ; nlb:bitWeight 8 ;
  nlb:lowRealization "env -i allowlist {HOME, PATH=toolchain+cargo+/usr/bin:/bin, LANG, MIX_ENV, ASDF_DATA_DIR, RUSTUP_HOME, CARGO_HOME, HEX_OFFLINE, CARGO_NET_OFFLINE}" ;
  nlb:highRealization "sanitized ambient: login env minus guard-matched names, PATH minus dirs holding LLM binaries" ;
  nlb:supportReason "the raw ambient env is not a level: it is the B2 hidden-provider negative control" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-toolchain a nlb:Factor ; rdfs:label "toolchain (executor node)" ; nlb:support "VARIED" ; nlb:column "E" ;
  nlb:generatedBy ce23:factor-cold , ce23:factor-concurrency , ce23:factor-path ;
  nlb:lowRealization "as-built: Elixir 1.19.5 on OTP 28.3.1" ; nlb:highRealization "pinned: asdf 1.20.2-otp-28 on erlang 28.5.0.2" ;
  nlb:supportReason "executor node only; the class verifier toolchain is part of class identity (nlb:classToolchain), not a factor" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-ordering a nlb:Factor ; rdfs:label "member ordering" ; nlb:support "VARIED" ; nlb:column "F" ;
  nlb:generatedBy ce23:factor-concurrency , ce23:factor-path , ce23:factor-env ;
  nlb:lowRealization "canonical (sorted by case IRI)" ; nlb:highRealization "seeded permutation restricted to a linear extension of the member dependency DAG (me-2 reads me-1)" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-reposize a nlb:Factor ; rdfs:label "repo size" ; nlb:support "PARTIAL" ;
  nlb:reservedGeneratedBy ce23:factor-cold , ce23:factor-path , ce23:factor-env ;
  nlb:lowRealization "shallow subject clone (--depth 1)" ; nlb:highRealization "full-history subject clone" ;
  nlb:supportReason "history contrast weak (26M vs 29M .git); tree size UNSUPPORTED (one registered format court suite, target_suites.ex:484). Promotion activates G=ACD: 2^(7-3) resolution IV, still 16 runs" ;
  prov:wasDerivedFrom ce:P-d79566375284518a .
ce23:factor-os a nlb:Factor ; rdfs:label "OS" ; nlb:support "UNSUPPORTED" ;
  nlb:supportReason "only macOS 26.2 arm64 (Darwin 25.2.0) runs the executor; cached Linux images carry no Erlang/Elixir/Rust and no aarch64-linux NIFs; a Linux level needs an operator-approved image pull. Cross-OS robustness is outside the demonstrated evidence ceiling." ;
  prov:wasDerivedFrom ce:P-505f07bd98c033b0 , ce:P-51855f58857c4cbb .

