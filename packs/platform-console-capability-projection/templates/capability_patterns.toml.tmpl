---
to: "generated/capability-patterns.toml"
sparql:
  rows: |
    PREFIX ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?capability ?title ?class ?owner ?authority ?broker ?receipt ?reversible ?pattern WHERE {
      ?capability a ce:Capability ;
          dcterms:title ?title ; ce:capabilityClass ?class ;
          ce:executionOwner ?owner ; ce:requiredAuthority ?authority ;
          ce:brokerRequired ?broker ; ce:receiptRequired ?receipt ; ce:reversible ?reversible .
      BIND(
        IF(?class = ce:Select, "mustar-select",
        IF(?class = ce:Construct, "ggen-construct",
        IF(?class = ce:Data, "data-projection",
        IF(?reversible = false, "irreversible-brokered-do",
        IF(CONTAINS(LCASE(STR(?authority)), "approval"), "maker-checker-do", "brokered-do")))))
        AS ?pattern)
    } ORDER BY ?capability
---
# GENERATED by ggen from canonical Chatman Ecosystem capability facts.
# DO NOT HAND EDIT. This file is a projection, not an authority grant.

{% for row in rows %}[[capability]]
iri = "{{ row.capability }}"
title = "{{ row.title }}"
class = "{{ row.class }}"
owner = "{{ row.owner }}"
required_authority = "{{ row.authority }}"
broker_required = {{ row.broker }}
receipt_required = {{ row.receipt }}
reversible = {{ row.reversible }}
pattern = "{{ row.pattern }}"

{% endfor %}