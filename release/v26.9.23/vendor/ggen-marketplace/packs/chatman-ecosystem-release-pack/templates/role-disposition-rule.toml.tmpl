---
to: out/role-derivations.toml
construct: |
  PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
  PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
  PREFIX dcterms: <http://purl.org/dc/terms/>
  CONSTRUCT {
    ?row a er:RoleDisposition ;
        er:legacyRole ?role ;
        er:legacyComponent ?lc ;
        er:legacySha ?sha ;
        er:legacyStanding ?standing ;
        er:sourceRelease ?old ;
        er:targetRelease ?new ;
        er:boundary ?boundary ;
        er:derivedBy ?rule ;
        er:reason ?reason ;
        er:classificationSource ?source ;
        er:suppliedBy ?supplier .
  }
  WHERE {
    ?new a er:Release ; er:crosswalkFrom ?old .
    ?old a er:LegacyRelease ; er:legacyRequiredRole ?role ; er:legacyComponent ?lc .
    ?lc er:legacyRole ?role ; er:legacyRepository ?repo .
    OPTIONAL { ?lc er:legacySha ?sha . }
    OPTIONAL { ?lc er:legacyStanding ?standing . }
    FILTER NOT EXISTS {
      ?decision er:legacyRole ?role ; er:sourceRelease ?old ; er:targetRelease ?new ; er:decidedBy ?authority .
    }
    BIND(STRAFTER(STR(?repo), "/") AS ?name)
    OPTIONAL { ?new er:classificationSource ?source . }
    OPTIONAL {
      ?fc a sj:FleetClassification ; dcterms:identifier ?fid ; sj:fleetClass ?cls .
      FILTER(STR(?fid) = ?name)
    }
    OPTIONAL {
      ?court er:courtReferencesComponent ?executed .
      FILTER(STR(?executed) = STR(?repo))
    }
    FILTER(BOUND(?cls) || !BOUND(?court))
    OPTIONAL {
      ?new er:hasComponent ?supplier .
      ?supplier a er:Component ; er:required true ; er:repository ?supplierRepo .
      FILTER(STR(?supplierRepo) = STR(?repo))
    }
    BIND(IF(!BOUND(?cls), er:ROLE_SUCCESSOR,
         IF(?cls = sj:CriticalPath, er:ROLE_REQUIRED,
         IF(?cls = sj:Successor, er:ROLE_SUCCESSOR,
         IF(?cls = sj:Blocked, er:ROLE_BLOCKED,
         IF(?cls = sj:Refused, er:ROLE_REFUSED,
         IF(?cls = sj:Unsupported, er:ROLE_UNSUPPORTED, er:ROLE_UNCLASSIFIED)))))) AS ?boundary)
    BIND(IF(BOUND(?cls), "rule:fleet-classification", "rule:no-GC23-court-reference") AS ?rule)
    BIND(IF(BOUND(?cls),
         CONCAT("fleet classification row for ", ?name, " has class ", STRAFTER(STR(?cls), "#")),
         CONCAT(?name, " is absent from the fleet classification and no court of the governing checkpoint executes ", STR(?repo), "; a successor repository becomes required only when a court executes it")) AS ?reason)
    BIND(IRI(CONCAT(STR(?new), "/role/", ENCODE_FOR_URI(?role))) AS ?row)
  }
  ORDER BY ?role
sparql:
  derived: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?role ?rule ?boundary
    WHERE {
      ?d a er:RoleDisposition ; er:legacyRole ?role ; er:derivedBy ?rule .
      OPTIONAL { ?d er:boundary ?b . }
      BIND(COALESCE(STRAFTER(STR(?b), "#ROLE_"), "") AS ?boundary)
    }
    ORDER BY ?rule ?role ?boundary
  decided: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?role ?authority ?boundary
    WHERE {
      ?d a er:RoleDisposition ; er:legacyRole ?role ; er:decidedBy ?authority .
      OPTIONAL { ?d er:boundary ?b . }
      BIND(COALESCE(STRAFTER(STR(?b), "#ROLE_"), "") AS ?boundary)
    }
    ORDER BY ?role ?authority ?boundary
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/role-disposition-rule.toml.tmpl). Do not hand-edit: a hand edit makes
# the next `ggen sync run` refuse (FM-WRITE-005); regenerate by deleting this file.
#
# Disposition rule (Stage-2 enrich, template construct): a predecessor required
# role with no explicit decision is disposed by the fleet classification when its
# repository is classified (CriticalPath->REQUIRED, Successor->SUCCESSOR,
# Blocked->BLOCKED, Refused->REFUSED, Unsupported->UNSUPPORTED; any other class
# -> UNCLASSIFIED, refused by gate 070), otherwise SUCCESSOR by
# rule:no-GC23-court-reference unless a court executes it (then nothing derives
# and gate 070 refuses the role as undisposed).
[derivations]
derived_count = {{ derived | length }}
decided_count = {{ decided | length }}
{% for r in derived %}
[[derived]]
legacy_role = {{ r.role | json_encode() }}
rule = {{ r.rule | json_encode() }}
boundary = {{ r.boundary | json_encode() }}
{% endfor %}{% for r in decided %}
[[decided]]
legacy_role = {{ r.role | json_encode() }}
decided_by = {{ r.authority | json_encode() }}
boundary = {{ r.boundary | json_encode() }}
{% endfor %}
