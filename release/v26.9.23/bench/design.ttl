ce23:th-classes a nlb:CrownThreshold ; nlb:thresholdOrder 1 ; nlb:thresholdMetric "KNOWN classes qualified" ; nlb:thresholdComparator ">=" ; nlb:thresholdValue "5"^^xsd:decimal ; prov:wasDerivedFrom ce:P-4d3769c9fc61645a .
