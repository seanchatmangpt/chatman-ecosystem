to: out/CTQ_TRACKER.md
sparql:
  ctqs: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?measure ?result ?method ?negative ?chart ?safety WHERE {
      ?q a dflss:CTQ ; rdfs:label ?label ; nlb:operationalMeasure ?measure ; nlb:requiredResult ?result ;
        nlb:verificationMethod ?method ; nlb:negativeCase ?negative ; nlb:controlChart ?chart .
      OPTIONAL { ?q nlb:safetyCritical ?sc }
      BIND(IF(BOUND(?sc) && STR(?sc) = "true", "yes", "no") AS ?safety)
    }
    ORDER BY ?label
