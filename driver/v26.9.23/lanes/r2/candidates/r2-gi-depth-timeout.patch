From aa07ee76ba02c280f9af21687b6c805af96564a1 Mon Sep 17 00:00:00 2001
From: R2 scratch <r2-scratch@example.invalid>
Date: Wed, 23 Sep 2026 14:57:45 -0700
Subject: [PATCH] ci(v26.9.23): restore full-history checkout and a measured
 job budget (R2 candidate, scratch only)

- fetch-depth: 0 restored from a39921b (dropped by merge 4ffa201): the
  git-ground-truth tests need d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3
  reachable from HEAD; depth 1 fails 3 tests (CI runs 35895254599,
  35895253020, 35895256423; reproduced locally under the pin).
- timeout-minutes 30 -> 90: five push runs on 2026-09-23 hit
  "The job has exceeded the maximum execution time of 30m0s" mid-suite.
---
 .github/workflows/ci.yml | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index a75aa50..22bc3cd 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,7 +14,13 @@ permissions:
 jobs:
   test:
     runs-on: ubuntu-latest
-    timeout-minutes: 30
+    # Budget from measured runs, not a guess: a cold run (no cache for the
+    # ref -- actions/cache saves only on job success, so a timed-out run
+    # never seeds one) spends ~14 min before `mix test` (deps + release-mode
+    # ggen_graph_nif build; run 35895256423), and the last green full suite
+    # took 28 min on a suite ~18% smaller than today's (run 35682930334).
+    # 30 min cancelled five consecutive runs on 2026-09-23 mid-suite.
+    timeout-minutes: 90
     permissions:
       contents: read
 
@@ -25,6 +31,17 @@ jobs:
         uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
         with:
           persist-credentials: false
+          # Semantic Jira's git-ground-truth court proves that the canonical
+          # baseSha is an actual ancestor of this exact head. A depth-1
+          # checkout makes every older honest SHA observationally absent and
+          # turns the positive control into a false refusal. This repository's
+          # own history is therefore a required test collaborator, just like
+          # the explicitly full-history ex4pm fixture clone below.
+          # (Restored from a39921b; merge 4ffa201 dropped it, and the three
+          # "opt-in git ground truth for baseSha" tests in
+          # test/ggen_igniter_semantic_jira_pack_test.exs then refuse
+          # d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3 as unreachable.)
+          fetch-depth: 0
 
       # Real fixture checkout: 10 real ExUnit test files
       # (test/ggen_igniter_base_*_test.exs, test/ggen_igniter_install_task_
-- 
2.51.2

