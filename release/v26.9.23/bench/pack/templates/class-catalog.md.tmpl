---
to: out/CLASSES.md
sparql:
  known: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?c ?code ?label ?readiness ?repair ?repairFamily ?verifier ?ivCommand ?ivFamily ?ivBasis ?toolchain ?scope ?dev ?real ?clusters
           ?reach ?reachSyn ?membership WHERE {
      ?c nlb:claimStatus "KNOWN_CANDIDATE" ; nlb:classCode ?code ; skos:prefLabel ?label ; nlb:readiness ?readiness ;
        nlb:repairTool ?t ; nlb:verifierArgv ?verifier ; nlb:independentVerifier ?iv ; nlb:classToolchain ?toolchain ;
        nlb:canonicalScope ?scope ; nlb:devRepo ?dev ; nlb:clusterCount ?clusters ; nlb:membershipPredicate ?membership ;
        nlb:reachableTier ?rt ; nlb:reachableTierWithSynthetic ?rts .
      ?t nlb:toolName ?tn ; nlb:toolVersion ?tv ; nlb:implementationFamily ?repairFamily .
      ?iv nlb:verifierCommand ?ivCommand ; nlb:implementationFamily ?ivFamily ; nlb:independenceBasis ?ivBasis .
      ?rt skos:prefLabel ?reach . ?rts skos:prefLabel ?reachSyn .
      OPTIONAL { ?c nlb:realUnseenObserved ?realv }
      BIND(CONCAT(?tn, " ", ?tv) AS ?repair)
      BIND(COALESCE(STR(?realv), "-") AS ?real)
    }
    ORDER BY ?code
  clauses: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?code ?basis ?text WHERE {
      ?c nlb:classCode ?code ; nlb:membershipClause ?m . ?m nlb:clauseBasis ?basis ; nlb:clauseText ?text .
    }
    ORDER BY ?code ?basis ?text
  nearmiss: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?code ?case ?reason WHERE {
      ?m a nlb:NearMissCase ; nlb:nearClass ?c ; nlb:expectedReason ?reason . ?c nlb:classCode ?code .
      BIND(STRAFTER(STR(?m), "#") AS ?case)
    }
    ORDER BY ?code ?case
  others: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?status ?label ?readiness WHERE {
      ?c a nlb:BenchmarkClass ; nlb:claimStatus ?status ; skos:prefLabel ?label ; nlb:readiness ?readiness .
      FILTER(?status != "KNOWN_CANDIDATE")
    }
    ORDER BY ?status ?label
---
