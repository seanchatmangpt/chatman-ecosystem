---
to: out/acceptance-rules.json
sparql:
  tiers: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?label ?rank ?n ?nominal ?zero ?one ?conf WHERE {
      ?t a nlb:EvidenceTier ; skos:prefLabel ?label ; nlb:tierRank ?rank ; nlb:tierN ?n ; nlb:nominalFailureBound ?nominal ;
        nlb:zeroDefectUpperBound ?zero ; nlb:oneDefectUpperBound ?one ; nlb:confidence ?conf .
    }
    ORDER BY ?rank
  rows: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?n ?x ?bound WHERE { ?r a nlb:BoundRow ; nlb:boundN ?n ; nlb:boundDefects ?x ; nlb:exactUpperBound ?bound . }
    ORDER BY ?n ?x
  thresholds: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?order ?metric ?cmp ?value ?minN WHERE {
      ?t a nlb:CrownThreshold ; nlb:thresholdOrder ?order ; nlb:thresholdMetric ?metric ; nlb:thresholdComparator ?cmp ; nlb:thresholdValue ?value .
      OPTIONAL { ?t nlb:minNForLowerBound ?mv }
      BIND(COALESCE(STR(?mv), "") AS ?minN)
    }
    ORDER BY ?order
  unsupported: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?support WHERE { ?f a nlb:Factor ; rdfs:label ?label ; nlb:support ?support . FILTER(?support = "UNSUPPORTED") }
    ORDER BY ?label
---
{"_generated": "GENERATED by ggen sync from nonllm-class-qualification-pack (templates/acceptance-rules.json.tmpl); do not hand-edit.",
 "bound_method": "clopper-pearson-exact-one-sided",
 "reading_rule": "a zero-failure run is never read as more than its tier bounds; n counts distinct unseen subject digests",
 "tiers": [{% for t in tiers %}
  {"tier": {{ t.label | json_encode() }}, "rank": {{ t.rank }}, "n": {{ t.n }}, "confidence": {{ t.conf | json_encode() }}, "nominal_failure_bound": {{ t.nominal | json_encode() }}, "zero_defect_upper_bound": {{ t.zero | json_encode() }}, "one_defect_upper_bound": {{ t.one | json_encode() }}}{% if not loop.last %},{% endif %}{% endfor %}
 ],
 "bound_rows": [{% for r in rows %}
  {"n": {{ r.n }}, "defects": {{ r.x }}, "exact_upper_bound": {{ r.bound | json_encode() }}}{% if not loop.last %},{% endif %}{% endfor %}
 ],
 "crown_thresholds": [{% for t in thresholds %}
  {"order": {{ t.order }}, "metric": {{ t.metric | json_encode() }}, "comparator": {{ t.cmp | json_encode() }}, "value": {{ t.value | json_encode() }}, "min_n_for_95pct_lower_bound": {% if t.minN == "" %}null{% else %}{{ t.minN }}{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}
 ],
 "unsupported_factors": [{% for u in unsupported %}{{ u.label | json_encode() }}{% if not loop.last %}, {% endif %}{% endfor %}],
 "evidence_ceiling": "cross-OS robustness remains outside the demonstrated evidence ceiling"
}
