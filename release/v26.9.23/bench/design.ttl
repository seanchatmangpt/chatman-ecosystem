# -- CTQ tree (15; operator table) ----------------------------------------------------------------
ce23:ctq-classification a dflss:CTQ ; rdfs:label "Classification correctness" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "KNOWN vs UNKNOWN confusion matrix (obo:STATO_0000594) over members and B6 near-misses" ; nlb:requiredResult "false-KNOWN = 0; upper bound reported" ;
  nlb:verificationMethod "pre-actuation membership probe vs independent label oracle (M8)" ; nlb:negativeCase "B6 near-miss admitted KNOWN" ; nlb:controlChart "g" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-05883ecca56c32e8 .
ce23:ctq-routing a dflss:CTQ ; rdfs:label "Deterministic routing" ; nlb:safetyCritical false ;
  nlb:operationalMeasure "same admitted input -> same provider/recipe" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "route/2 over shuffled graph and permuted inputs (MSA P5)" ; nlb:negativeCase "B2 same descriptor, changed requested outcome" ; nlb:controlChart "p" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-llm-isolation a dflss:CTQ ; rdfs:label "LLM isolation" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "reachable LLM calls, credentials, providers (env prefixes, binaries on PATH, local model ports)" ; nlb:requiredResult "0" ;
  nlb:verificationMethod "generated provider guard + network fence probe (M10)" ; nlb:negativeCase "B2 hidden provider: GEMINI_/GOOGLE_/OLLAMA_/MISTRAL_/CODEX_ keys, codex/gemini/ollama/openai on PATH, /usr/local/bin/claude on the court PATH" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-conservation a dflss:CTQ ; rdfs:label "Semantic conservation" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "tuple digest preserved across hops" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "verify_hops/1 + GC23-4 carrier re-derivation (complementary: all-hop forgery caught only by the latter)" ; nlb:negativeCase "B2 malformed tuple digest; single-hop and all-hop forgeries" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-execution a dflss:CTQ ; rdfs:label "Execution success" ; nlb:safetyCritical false ;
  nlb:operationalMeasure "completed admitted KNOWN orders / admitted KNOWN orders (FTY)" ; nlb:requiredResult "target >= 99%; first crown FTY >= 95%" ;
  nlb:verificationMethod "OCEL StageCompleted outcomes per case" ; nlb:negativeCase "B4 worker crash must not count as success" ; nlb:controlChart "p" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-verification a dflss:CTQ ; rdfs:label "Verification sensitivity" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "injected bad result rejected" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "planted bad outputs per class (define lane: 49/49 rejected) + formatted semantic corruptions (M6)" ; nlb:negativeCase "B2 intentionally wrong generated file" ; nlb:controlChart "g" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-019fc42417808b99 .
ce23:ctq-receipt a dflss:CTQ ; rdfs:label "Receipt completeness" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "successful consequences with a valid, current, field-bound receipt" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "validate_receipt.py + currency court (M2) + R-projection binding court (M3)" ; nlb:negativeCase "B2 corrupted receipt (4/7 court-owned corruptions escape today)" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-18db2cd10b35adae .
ce23:ctq-replay a dflss:CTQ ; rdfs:label "Replay equivalence" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "replay reproduces admitted result/state (write-tree digest, path-normalized)" ; nlb:requiredResult "100%; unobserved replay counts as a defect" ;
  nlb:verificationMethod "re-execution replay + GC23-10 evidence replay" ; nlb:negativeCase "B2 stale subject SHA -> DIVERGED subject_changed" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-cold a dflss:CTQ ; rdfs:label "Cold reconstructability" ; nlb:safetyCritical false ;
  nlb:operationalMeasure "no transcript/session dependence: fresh HOME, clean exact-SHA checkout" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "hermetic cold rebuild court (M7)" ; nlb:negativeCase "B4 cold graph side BUILD_BROKEN must fail closed" ; nlb:controlChart "p" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-idempotence a dflss:CTQ ; rdfs:label "Idempotence" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "repeated order does not duplicate consequence" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "crash-after-DO re-drive fault case; uniqueness on (work_order_iri, tuple_digest, base_sha)" ; nlb:negativeCase "B4 lease loss / re-drive" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-fault-containment a dflss:CTQ ; rdfs:label "Fault containment" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "typed failure instead of uncontrolled fallback, per morphism" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "generated B4 fault tests per FaultInjectionPoint" ; nlb:negativeCase "B4 fault continuing to DO or promoting standing" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-c5890eaf509015b3 .
ce23:ctq-frontier a dflss:CTQ ; rdfs:label "Frontier closure" ; nlb:safetyCritical false ;
  nlb:operationalMeasure "completed work leaves the current frontier; dependent enters" ; nlb:requiredResult "100%" ;
  nlb:verificationMethod "GC23-8 frontier court per case" ; nlb:negativeCase "ALIVE order re-entering the frontier" ; nlb:controlChart "p" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-class-transfer a dflss:CTQ ; rdfs:label "Class transfer" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "P(success | x in C, x not in Train) over distinct unseen subject digests" ; nlb:requiredResult "statistically qualified at a stated tier (>= DISCOVERY: n >= 30, 0 defects, p_U <= 0.095)" ;
  nlb:verificationMethod "B5 execution through the generated executor; ClassStanding tuple" ; nlb:negativeCase "leakage: Test member sharing digest or patch-id with Train/Dev" ; nlb:controlChart "g" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 , ce:P-a463693a094b335f .
ce23:ctq-human a dflss:CTQ ; rdfs:label "Human dependence" ; nlb:safetyCritical false ;
  nlb:operationalMeasure "exceptional-human intervention on the KNOWN path" ; nlb:requiredResult "0" ;
  nlb:verificationMethod "OCEL actor attribution: no human actor between Observe and Receipt" ; nlb:negativeCase "operator edit inside a KNOWN run" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .
ce23:ctq-llm-dependence a dflss:CTQ ; rdfs:label "LLM dependence" ; nlb:safetyCritical true ;
  nlb:operationalMeasure "LLM invocations on the KNOWN path (count, not presence)" ; nlb:requiredResult "0" ;
  nlb:verificationMethod "provider-object/event count over the batch OCEL (stop_court episode_counters at e999e62 is a name rule; needs an invocation fence)" ; nlb:negativeCase "B2 LLM fallback present" ; nlb:controlChart "c" ;
  prov:wasDerivedFrom ce:P-631296cc71d3da82 .

