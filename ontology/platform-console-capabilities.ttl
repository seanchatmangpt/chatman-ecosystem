    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:ApprovalFreezeOverride a ce:Capability ;
    dcterms:title "freeze.override" ;
    dcterms:description "Maker-checker approval-workflow action gating a freeze-window override; a pure gate with no direct k8s side effect of its own, exercising the approval path castle.verb.run does not." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "approval-workflow.requireApproval" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible true ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:DataDestructionCertificateIssue a ce:Capability ;
    dcterms:title "data-destruction.certificate.issue" ;
    dcterms:description "Mints a signed, timestamped Certificate of Data Destruction via POST /api/owner/data-destruction (lib/data-destruction-certificate.ts's issueDataDestructionCertificate). Fail-closed: refuses (not_all_clear) unless a freshly-computed verifyDataDestruction read reports every real check clear -- no live PVC and no undeleted backup record for the org. Gated by approval-workflow.ts's data-destruction.certificate.issue maker-checker action: the requester's own live verification read is never sufficient by itself to issue the certificate; a second, distinct owner-role approver must sign off first. Fourth data point for the model: the first genuinely irreversible capability, distinct from the 3 existing reversible ones." ;
    ce:capabilityClass ce:Do ;
    ce:executionOwner "platform-console" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "approval-workflow.requireApproval(data-destruction.certificate.issue)" ;
    ce:brokerRequired true ;
    ce:receiptRequired true ;
    ce:reversible false ;
    ce:standing "active" ;
    ce:interface ce:CLI, ce:API, ce:MCP, ce:A2A .

pcc:ApprovalOrgDelete a ce:Capability ;
    dcterms:title "org.delete" ;
    dcterms:description "Maker-checker approval-workflow action gating full org deletion, the header-comment reference case for this codebase's 'destructive, high-blast-radius, one owner acting alone is not sufficient' bar. Irreversible." ;
