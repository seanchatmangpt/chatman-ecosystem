---
to: out/requirements.toml
sparql:
  rows: |
    PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?order ?id ?gate ?repository ?sha ?falsifier ?boundary
    WHERE {
      ?order a sj:WorkOrder ; sj:checkpointOf ?g .
      OPTIONAL { ?order dcterms:identifier ?oid . }
      OPTIONAL { ?g dcterms:identifier ?gid . }
      OPTIONAL { ?order sj:repository ?repo . }
      OPTIONAL { ?order sj:baseSha ?base . }
      OPTIONAL { ?order sj:falsifier ?f . ?f dcterms:description ?ftext . }
      OPTIONAL { ?order sj:boundaryClass ?bc . }
      BIND(COALESCE(STR(?oid), STR(?order)) AS ?id)
      BIND(COALESCE(STR(?gid), STRAFTER(STR(?g), "#"), STR(?g)) AS ?gate)
      BIND(COALESCE(STR(?repo), "") AS ?repository)
      BIND(COALESCE(STR(?base), "") AS ?sha)
      BIND(COALESCE(STR(?ftext), "") AS ?falsifier)
      BIND(COALESCE(STRAFTER(STR(?bc), "#"), "") AS ?boundary)
    }
    ORDER BY ?gate ?id ?order
---
# GENERATED by ggen sync from chatman-ecosystem-release-pack
# (templates/requirements.toml.tmpl). Do not hand-edit: a hand edit makes the next
# `ggen sync run` refuse (FM-WRITE-005). One row per checkpointed sj:WorkOrder of
# the consumer graph (OPTIONAL joins; gate 085 refuses a row without gate,
# repo@sha40 subject or falsifier before rendering).
[requirements]
row_count = {{ rows | length }}
{% for r in rows %}
[[requirement]]
work_order = {{ r.id | json_encode() }}
gate = {{ r.gate | json_encode() }}
{% set subject = r.repository ~ "@" ~ r.sha %}subject = {{ subject | json_encode() }}
boundary_class = {{ r.boundary | json_encode() }}
falsifier = {{ r.falsifier | json_encode() }}
{% endfor %}
