---
to: out/ci/bench-ce23-12-b3.yml
sparql:
  factors: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?letter ?w ?isbase WHERE {
      ?d a nlb:FractionalFactorialDesign ; nlb:hasFactor ?f .
      ?f nlb:column ?letter .
      { ?f nlb:bitWeight ?w . BIND("1" AS ?isbase) } UNION { ?f nlb:generatedBy ?g . ?g nlb:bitWeight ?w . BIND("0" AS ?isbase) }
    }
    ORDER BY ?letter ?w
  design: |
    PREFIX nlb: <https://ggen.dev/nonllm-bench#>
    SELECT ?runner ?seed WHERE { ?d a nlb:FractionalFactorialDesign ; nlb:runnerLabel ?runner ; nlb:runOrderSeed ?seed . }
---
{%- set_global nbase = 0 -%}{%- set_global letters = [] -%}
{%- for r in factors -%}{%- if r.isbase == "1" -%}{%- set_global nbase = nbase + 1 -%}{%- endif -%}
{%- if r.letter not in letters -%}{%- set_global letters = letters | concat(with=r.letter) -%}{%- endif -%}{%- endfor -%}
{%- set_global nruns = 1 -%}{%- for i in range(end=nbase) -%}{%- set_global nruns = nruns * 2 -%}{%- endfor -%}
# GENERATED by ggen sync from nonllm-class-qualification-pack (templates/ci-workflow.yml.tmpl); do not hand-edit.
# B3 variation court: the generated fractional-factorial design as a GitHub Actions matrix. A design
# artifact under release/v26.9.23/bench/out/ci/ (not an active workflow): adopting it and the DOE
# runner are successor order CE23-12-OP-17. The OS factor is UNSUPPORTED and never varied: every run
# uses the one macOS runner, and cross-OS robustness stays outside the demonstrated evidence ceiling.
name: bench-ce23-12-b3
on: workflow_dispatch
permissions:
  contents: read
jobs:
  b3:
{%- for d in design %}
    runs-on: {{ d.runner }}
{%- endfor %}
    strategy:
      fail-fast: false
      matrix:
        include:
{%- for run in range(end=nruns) %}
          - run: {{ run + 1 }}
{%- for l in letters -%}
    {%- set_global lows = 0 -%}
    {%- for r in factors -%}{%- if r.letter == l -%}
      {%- set_global w = r.w | int -%}{%- set_global q = run / w -%}{%- set_global q = q | int -%}
      {%- if q % 2 == 0 -%}{%- set_global lows = lows + 1 -%}{%- endif -%}
    {%- endif -%}{%- endfor %}
            {{ l }}: {% if lows % 2 == 0 %}high{% else %}low{% endif %}
{%- endfor %}
{%- endfor %}
    steps:
      - name: DOE runner (successor order CE23-12-OP-17)
        run: |
          {% raw %}echo "UNSUPPORTED(executor): B3 run ${{ matrix.run }} has no DOE runner yet (CE23-12-OP-17)"{% endraw %}
          exit 75
