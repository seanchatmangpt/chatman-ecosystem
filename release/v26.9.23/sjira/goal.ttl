@prefix ce: <https://ggen-igniter.dev/sjira/chatman-26.9.23#> .
@prefix v23: <https://ggen-igniter.dev/sjira/v26.9.23#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# GC-CE-26.9.23: the governing object of the Chatman Ecosystem v26.9.23 root
# release (CE23; lane CE-INTAKE, wave CE0). Source prose, committed
# byte-identical beside this file (operator testimony, O* by fiat):
#   chatman-ce23.md            sha256:6d788331a4ebc5ad34c3579acc71d6572197ba830eaea23188f468505a1954d3
#                              (13366 bytes; CE23-0 .. CE23-11 and the crown equation)
#   chatman-ce23-12-bench.md   sha256:4146d688c21db6e1af51a2187df8056b1a0f977001c817d64fbde0547029b485
#                              (13420 bytes; adds CE23-12 as a Chatman CE23 crown gate)
#   chatman-ce23-12-standings.md
#                              sha256:80091c45b16d6afbf0bfa5717726c9221f35905f5650fad03b8cd81cbcb5b2d2
#                              (7276 bytes; CE23-12 = BenchmarkDesign ∧ MSAContract ∧
#                              GeneratedQualificationPlan; NON_LLM_OPERATIONAL is never
#                              implied by design)
# Product contract: xaas docs/sjira/v26.9.23/prd-ard.md (PRD section 12 GC23-0 ..
# GC23-12, section 13 STOP; ARD section 5 first mile, section 17 compiler,
# section 24 M9 no bespoke backlog). Driver: /Users/sac/wt/v26922/v26923/DRIVER.md.
#
# Vocabulary: the semantic-jira-pack sj: namespace (ggen_igniter
# priv/ggen/semantic-jira-pack), the same GoalCheckpoint contract the xaas
# goal docs/sjira/v26.9.23/goal.ttl uses (read-only model for this graph).
# Instances: ce: = https://ggen-igniter.dev/sjira/chatman-26.9.23#.
#
# Law of this graph:
# - It holds NO sj:WorkOrder, no sj:Receipt and no sj:receipt. Every CE23
#   work order is compiler output: ggen_igniter `mix semantic_jira.compile_prose`
#   over each prose unit, its candidates (candidates/<unit>.ttl, emitted by
#   xaas scripts/sjira/prose_spans.py from the extraction JSON) and the unit's
#   goal view (units/<unit>.goal.ttl, projected from this graph by
#   unit_goal.py) writes compiled/<unit>/{propositions,orders}.ttl.
#   compile_check.sh recomputes all of them byte for byte.
# - Unit partition: every GoalCheckpoint under the root carries the
#   dcterms:source and sj:sourceSha256 of the prose that defines it. A unit
#   view is rooted at the common parent of the gates its prose defines and
#   holds exactly those gates, so each compile refuses (uncovered_gate) unless
#   that prose requires every gate it defines, and the three views partition
#   the 16 gates (CE23-0 .. CE23-11 from chatman-ce23.md, CE23-12 from the
#   bench prose, its three conjunct gates from the standings prose).
# - Standing is observed, never declared: the gate courts are
#   "sh release/v26.9.23/courts/<gate>.sh" run from the chatman-ecosystem root.
#   A court whose machinery has not landed prints
#   "UNKNOWN: <gate> machinery lands in a generated CE23 lane" and exits 75
#   (machinery absent, standing UNKNOWN), like the GC23 courts before their
#   lanes. Machinery lanes replace a court's body; this graph stays stable.
# - CE23-12 standing rule (chatman-ce23-12-standings.md): CE23-12 for v26.9.23
#   is BENCHMARK_DESIGN_ALIVE = BenchmarkDesign ∧ MSAContract ∧
#   GeneratedQualificationPlan. NON_LLM_OPERATIONAL_ALIVE(C) needs executed
#   unseen-member receipts, MSA_ALIVE, statistical qualification, zero LLM and
#   replay; it is successor work (ce:GC-CE-26.9.24) and is never implied here.
# - release/v26.9.1 is never modified by any CE23 work.
# - Discovered work that falsifies no CE23 or GC23 proposition routes to the
#   successor ce:GC-CE-26.9.24 and cannot hold this checkpoint open.

# -- Root and successor bucket ------------------------------------------------

ce:GC-CE-26.9.23 a sj:GoalCheckpoint ;
    dcterms:identifier "GC-CE-26.9.23" ;
    rdfs:label "GC-CE-26.9.23 Chatman Ecosystem v26.9.23 root release stop" ;
    dcterms:description "CHATMAN_STOP_26.9.23 = Identity ∧ BoundaryCrosswalk ∧ SM_STOP ∧ ExactMainHeads ∧ FleetClosed ∧ KnownPath_LLM=0 ∧ UnreceiptedActuation=0 ∧ Replay ∧ RootReceipt, where SM_STOP = GC23-0 ∧ … ∧ GC23-12 and FleetClosed ⇔ RequiredUnknown = 0 ∧ UnclassifiedRequiredWork = 0 (chatman-ce23.md, Crown equation). Chatman Ecosystem v26.9.23 is a dependency-closed composition release around the Semantic Manufacturing checkpoint, not an all-repositories-green release; CE23-12 = BenchmarkDesign ∧ MSAContract ∧ GeneratedQualificationPlan joins the root crown as a Chatman CE23 crown gate (chatman-ce23-12-bench.md, chatman-ce23-12-standings.md)." ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23.md" ;
    sj:sourceSha256 "sha256:6d788331a4ebc5ad34c3579acc71d6572197ba830eaea23188f468505a1954d3" ;
    sj:repository "seanchatmangpt/chatman-ecosystem" ;
    sj:baseSha "a896e16c68af1315be3492e39939c354ce46b10c" ;
    sj:successorCheckpoint ce:GC-CE-26.9.24 ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:evidenceHorizon "EXECUTED_VERIFIED" ;
    sj:requiresEvidence sj:receipt-evidence, sj:replay-evidence ;
    sj:replayIdentity "semantic-jira:chatman-26.9.23:GC-CE-26.9.23" ;
    sj:exclusion "Not required by v26.9.23 (chatman-ce23.md): making every repository ALIVE.",
        "Not required by v26.9.23 (chatman-ce23.md): closing ggen-ecosystem, autofde-lab, ash_surface, zcode-cli or other successor work, unless an observation proves one of those repos is actually traversed by a GC23 court.",
        "Not required by v26.9.23 (chatman-ce23.md): WD FA / V23-W; live WD integration is explicitly excluded from this release.",
        "Not required by v26.9.23 (chatman-ce23-12-standings.md): NON_LLM_OPERATIONAL_ALIVE for any benchmark class; BENCHMARK_DESIGN_ALIVE does not imply it.",
        "release/v26.9.1 is never modified (chatman-ce23.md CE23-1: preserve release/v26.9.1 untouched)." ;
    sj:successorPolicy "Discovered work that falsifies no CE23 or GC23 proposition -> ce:GC-CE-26.9.24; noncritical failures cannot reopen the release without falsifying a GC23 proposition (chatman-ce23.md CE23-6)." ;
    sj:acceptance ce:GC-CE-26.9.23-acceptance ;
    sj:falsifier ce:GC-CE-26.9.23-falsifier-crown, ce:GC-CE-26.9.23-falsifier-topology ;
    rdfs:seeAlso v23:GC-26.9.23 ;
    sj:stopQuery """# CHATMAN_STOP(GC-CE-26.9.23) = Identity ∧ BoundaryCrosswalk ∧ SM_STOP ∧ ExactMainHeads
#   ∧ FleetClosed ∧ KnownPath_LLM=0 ∧ UnreceiptedActuation=0 ∧ Replay ∧ RootReceipt
#   (release/v26.9.23/sjira/chatman-ce23.md, Crown equation), SM_STOP = GC23-0 ∧ … ∧ GC23-12,
#   FleetClosed ⇔ RequiredUnknown = 0 ∧ UnclassifiedRequiredWork = 0, amended by
#   CE23-12 = BenchmarkDesign ∧ MSAContract ∧ GeneratedQualificationPlan
#   (chatman-ce23-12-bench.md, chatman-ce23-12-standings.md). Crown term -> gates:
#   Identity -> CE23-0, CE23-1; BoundaryCrosswalk -> CE23-2; SM_STOP -> CE23-3, CE23-4;
#   ExactMainHeads -> CE23-5; FleetClosed -> CE23-6; KnownPath_LLM=0 and
#   UnreceiptedActuation=0 -> CE23-8; Replay -> CE23-7, CE23-9; RootReceipt -> CE23-10;
#   CE23-12 -> CE23-12, CE23-12-BenchmarkDesign, CE23-12-MSAContract,
#   CE23-12-GeneratedQualificationPlan.
# True iff (1) every crown gate exists under GC-CE-26.9.23 (sj:checkpointOf+) and has a gate
# receipt with standing ALIVE (one FILTER EXISTS per gate, no VALUES block: the query stays
# within what both the stop court's oxigraph engine and rdflib evaluate), and (2) every
# WorkOrder under GC-CE-26.9.23 outside CE23-11 is typed Successor or has a terminal receipt
# (ALIVE, BLOCKED, UNSUPPORTED or REFUSED).
# CE23-11 (the v26.9.23 tag) is the consequence of CHATMAN_STOP, never a term of it: its
# court runs only after this query is true. Evaluated over goal.ttl, the compiled orders
# (release/v26.9.23/sjira/compiled/*/orders.ttl) and the receipts the root court projects as
# sj:Receipt nodes; goal.ttl itself asserts no receipt. No LLM participates.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
ASK {
  ?root a sj:GoalCheckpoint ;
        dcterms:identifier "GC-CE-26.9.23" .
  # Identity
  FILTER EXISTS {
    ?gate0 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-0" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt0 .
    ?receipt0 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # Identity
  FILTER EXISTS {
    ?gate1 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-1" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt1 .
    ?receipt1 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # BoundaryCrosswalk
  FILTER EXISTS {
    ?gate2 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-2" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt2 .
    ?receipt2 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # SM_STOP
  FILTER EXISTS {
    ?gate3 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-3" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt3 .
    ?receipt3 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # SM_STOP
  FILTER EXISTS {
    ?gate4 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-4" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt4 .
    ?receipt4 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # ExactMainHeads
  FILTER EXISTS {
    ?gate5 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-5" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt5 .
    ?receipt5 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # FleetClosed
  FILTER EXISTS {
    ?gate6 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-6" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt6 .
    ?receipt6 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # Replay
  FILTER EXISTS {
    ?gate7 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-7" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt7 .
    ?receipt7 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # KnownPath_LLM=0, UnreceiptedActuation=0
  FILTER EXISTS {
    ?gate8 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-8" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt8 .
    ?receipt8 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # Replay
  FILTER EXISTS {
    ?gate9 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-9" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt9 .
    ?receipt9 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # RootReceipt
  FILTER EXISTS {
    ?gate10 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-10" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt10 .
    ?receipt10 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # CE23-12
  FILTER EXISTS {
    ?gate11 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-12" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt11 .
    ?receipt11 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # CE23-12
  FILTER EXISTS {
    ?gate12 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-12-BenchmarkDesign" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt12 .
    ?receipt12 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # CE23-12
  FILTER EXISTS {
    ?gate13 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-12-MSAContract" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt13 .
    ?receipt13 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  # CE23-12
  FILTER EXISTS {
    ?gate14 a sj:GoalCheckpoint ;
           dcterms:identifier "CE23-12-GeneratedQualificationPlan" ;
           sj:checkpointOf+ ?root ;
           sj:receipt ?receipt14 .
    ?receipt14 a sj:Receipt ;
              sj:standing "ALIVE" .
  }
  FILTER NOT EXISTS {
    ?order a sj:WorkOrder ;
           sj:checkpointOf+ ?root .
    FILTER NOT EXISTS {
      ?order sj:checkpointOf ?tagGate .
      ?tagGate dcterms:identifier "CE23-11" .
    }
    FILTER NOT EXISTS { ?order sj:boundaryClass sj:Successor . }
    FILTER NOT EXISTS {
      ?order sj:receipt ?orderReceipt .
      ?orderReceipt a sj:Receipt ;
                    sj:standing ?standing .
      FILTER(?standing = "ALIVE" || STRSTARTS(?standing, "BLOCKED") || STRSTARTS(?standing, "UNSUPPORTED") || STRSTARTS(?standing, "REFUSED"))
    }
  }
}""" .
ce:GC-CE-26.9.23-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "GC-CE-26.9.23 acceptance" ;
    dcterms:description "The root court computes exactly CHATMAN_STOP = Identity ∧ BoundaryCrosswalk ∧ SM_STOP ∧ ExactMainHeads ∧ FleetClosed ∧ KnownPath_LLM=0 ∧ UnreceiptedActuation=0 ∧ Replay ∧ RootReceipt (chatman-ce23.md) and it is true at the exact Chatman, xaas and ggen_igniter SHAs; the v26.9.23 tag (CE23-11) is created only after that, on the crowned subject." .
ce:GC-CE-26.9.23-falsifier-crown a sj:Falsifier ;
    rdfs:label "GC-CE-26.9.23 vacuous crown" ;
    dcterms:description "CHATMAN_STOP is reported true while some crown gate has no ADMITTED gate receipt with standing ALIVE, or some required CE23 work order has no terminal receipt, or the tag v26.9.23 exists on a subject whose imported Semantic Manufacturing STOP does not replay true." .
ce:GC-CE-26.9.23-falsifier-topology a sj:Falsifier ;
    rdfs:label "GC-CE-26.9.23 silent topology erasure" ;
    dcterms:description "They are contradictory if we simply replace the old 16-role manifest with a two-repo manifest and pretend the old obligations disappeared (chatman-ce23.md): the v26.9.23 root is accepted while a v26.9.1 required role has no explicit REQUIRED, SUCCESSOR, BLOCKED, UNSUPPORTED or REFUSED classification." .

ce:GC-CE-26.9.24 a sj:GoalCheckpoint ;
    dcterms:identifier "GC-CE-26.9.24" ;
    rdfs:label "GC-CE-26.9.24 successor of GC-CE-26.9.23" ;
    dcterms:description "Successor goal that receives every item typed out of GC-CE-26.9.23: NON_LLM_OPERATIONAL_ALIVE(C) for each benchmark class (executed unseen-member receipts, MSA_ALIVE, statistical qualification, zero LLM, replay; chatman-ce23-12-standings.md), every Successor-classed proposition of the CE23 prose, the successor repositories of the fleet partition, and every discovered item that falsifies no CE23 or GC23 proposition. Its stop predicate is not compiled yet: STOP is false by construction until accepted successor prose enters through the same first-mile pipeline." ;
    sj:successorOf ce:GC-CE-26.9.23 ;
    sj:boundaryClass sj:Successor ;
    rdfs:seeAlso v23:GC-26.9.24 ;
    sj:stopQuery """PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
# GC-CE-26.9.24 has no accepted prose yet: STOP is false by construction.
ASK { FILTER(false) }""" .

# -- Gates CE23-0 .. CE23-11 (chatman-ce23.md, "Required chatman-ecosystem v26.9.23 contract") --

ce:CE23-0 a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-0" ;
    rdfs:label "CE23-0 Re-establish root identity" ;
    dcterms:description "Re-establish root identity: chatman-ecosystem working subject is bound to a GitHub remote + exact SHA; lineage is proven rather than inferred." ;
    rdfs:comment "Crown term: Identity." ;
    sj:checkpointOf ce:GC-CE-26.9.23 ;
    sj:boundaryClass sj:Bootstrap ;
    dcterms:source "release/v26.9.23/sjira/chatman-ce23.md" ;
    sj:sourceSha256 "sha256:6d788331a4ebc5ad34c3579acc71d6572197ba830eaea23188f468505a1954d3" ;
    sj:exclusion "v26.9.23 therefore needs to repair transport/identity, not fix Chatman implementation code merely because of that classification (chatman-ce23.md)." ;
    sj:courtCommand "sh release/v26.9.23/courts/CE23-0.sh" ;
    sj:acceptance ce:CE23-0-acceptance ;
    sj:falsifier ce:CE23-0-falsifier .
ce:CE23-0-acceptance a sj:AcceptanceCriterion ;
    rdfs:label "CE23-0 acceptance" ;
    dcterms:description "Admission condition (chatman-ce23.md, CE23-0): `chatman-ecosystem` working subject is bound to a GitHub remote + exact SHA; lineage is proven rather than inferred." .
ce:CE23-0-falsifier a sj:Falsifier ;
    rdfs:label "CE23-0 falsifier" ;
    dcterms:description "The CE23-0 court exits 0 while the working subject has no GitHub remote or no exact SHA, or its lineage is asserted without proof; the recorded gap is the counterexample: Overnight fleet classified the local checkout `UNSUPPORTED` because it could not relate it to published GitHub lineage (chatman-ce23.md)." .

ce:CE23-1 a sj:GoalCheckpoint ;
    dcterms:identifier "CE23-1" ;
    rdfs:label "CE23-1 Create an independent v26.9.23 release subject" ;
    dcterms:description "Create an independent v26.9.23 release subject: Add release/v26.9.23/…; preserve release/v26.9.1 untouched." ;
    rdfs:comment "Crown term: Identity." ;
    sj:checkpointOf ce:GC-CE-26.9.23 ;
    sj:boundaryClass sj:FirstMile ;
