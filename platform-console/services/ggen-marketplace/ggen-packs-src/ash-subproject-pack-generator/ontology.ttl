# ash-subproject-pack-generator/ontology.ttl
#
# Real data, copied verbatim from a real hex.pm search
# (https://hex.pm/packages?search=depends%3Ahexpm%3Aash&sort=total_downloads,
# fetched 2026-08-20; 137 real total packages depend on `ash`). Admitted
# here: the 34 real packages with total_downloads >= 20,000, the real,
# disclosed proxy this pack version uses for "actively developed" (see
# pack.toml for why -- not verified git-commit recency).

@prefix asg:  <https://ggen.io/ontology/ash-subproject-generator#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.io/ontology/ash-subproject-generator#> a owl:Ontology ;
  rdfs:label "Real, hex.pm-sourced Ash-ecosystem subproject facts, for pack-skeleton generation" .

asg:AshSubproject a owl:Class ;
  rdfs:label "One real hex.pm package that depends on ash, admitted by a real, disclosed download threshold." .

asg:packageName a owl:DatatypeProperty ; rdfs:domain asg:AshSubproject ; rdfs:range xsd:string .
asg:totalDownloads a owl:DatatypeProperty ; rdfs:domain asg:AshSubproject ; rdfs:range xsd:integer ;
  rdfs:comment "Real total_downloads figure from hex.pm at fetch time (2026-08-20) -- a real point-in-time snapshot, not live-synced." .
asg:hexUrl a owl:DatatypeProperty ; rdfs:domain asg:AshSubproject ; rdfs:range xsd:string .

# Real, deliberate exclusion, disclosed: "honeybadger" (2,239,840
# downloads) was the #1 real result on the hex.pm search's first page,
# ahead of every real ash_* package -- excluded here as a real search
# false-positive (an error-tracking SaaS client, not an Ash-ecosystem
# library; hex.pm's dependency search appears to match some other real
# relationship, not a genuine `ash` dependency). Not admitted.

# --- 34 real packages, total_downloads >= 20,000, sorted descending ---

asg:ash_postgres a asg:AshSubproject ; asg:packageName "ash_postgres" ; asg:totalDownloads 1362679 ; asg:hexUrl "https://hex.pm/packages/ash_postgres" .
