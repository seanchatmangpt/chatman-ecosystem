@prefix cmx: <https://ggen.dev/ontology/combinatorial-maximalism-crossover#> .
@prefix agp: <https://ggen.io/ontology/ash-igniter-gen-pipeline#> .
@prefix aac: <https://ggen.dev/ontology/ash-autofde-lab-connector#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.dev/ontology/combinatorial-maximalism-crossover#> a rdfs:Class ;
  rdfs:comment "Real crossover vocabulary proving agp: (local mix-task dispatch) and aac: (cnv-deploy HTTP-invoke dispatch) can share one rank-ordered fan-out, via RDF multi-typing rather than modifying either pack's own vocabulary." .

cmx:rank a rdf:Property ; rdfs:range xsd:integer ;
  rdfs:comment "Shared topological rank, applied to individuals of EITHER agp:CodegenTarget or aac:AshConnector via multi-typing." .

cmx:dispatchVia a rdf:Property ; rdfs:range xsd:string ;
  rdfs:comment "Which real actuation mechanism this row uses: 'mix' (agp:'s sh_after shell dispatch) or 'cnv_invoke' (aac:'s template-embedded HTTP dispatch to cnv-deploy). Informational -- the query below does not itself actuate either." .

# --- Fixture individuals (this pack's own, deliberately NOT the live packs' real rows --
# avoids touching agp:CodegenTarget/aac:AshConnector individuals in ash-igniter-gen-pipeline-pack
# or ash-autofde-lab-connector-pack, both actively developed elsewhere this session) ---

cmx:FixtureDomainGen a agp:CodegenTarget ;
  agp:moduleName "Operations" ;
  agp:domainModule "Xaas" ;
  agp:mixTask "ash.gen.domain" ;
  agp:rank 0 ;
  cmx:rank 0 ;
  cmx:dispatchVia "mix" .

cmx:FixtureResourceGen a agp:CodegenTarget ;
  agp:moduleName "Widget" ;
  agp:domainModule "Xaas.Operations" ;
  agp:mixTask "ash.gen.resource" ;
  agp:rank 1 ;
  cmx:rank 1 ;
  cmx:dispatchVia "mix" .

cmx:FixturePlannerCandidate a aac:AshConnector ;
  aac:resourceModule "Xaas.Operations.WidgetPlannerCandidate" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__solve" ;
  aac:actionName "request_candidate" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/widget_planner_candidate.ex" ;
  aac:tableName "widget_planner_candidates" ;
  cmx:rank 2 ;
  cmx:dispatchVia "cnv_invoke" .

cmx:FixtureMigration a agp:CodegenTarget ;
  agp:moduleName "Widget" ;
  agp:domainModule "Xaas.Operations" ;
  agp:mixTask "ash_postgres.generate_migrations" ;
  agp:rank 3 ;
  cmx:rank 3 ;
  cmx:dispatchVia "mix" .
