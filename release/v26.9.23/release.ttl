    er:importSource "seanchatmangpt/xaas@6fd59588c2e06b83d1af6ebc653e7b545de6f90f:docs/sjira/v26.9.23/fleet/classification.ttl" .

r23:import-legacy-v26-9-1 a er:ImportedReceipt ;
    er:importName "legacy-v26.9.1" ;
    er:importPath "release/v26.9.23/imports/legacy-v26.9.1.ttl" ;
    er:importDigest "sha256:683a1cef30086c88453d73a0b9eb4b3c1f5a0fdfb17004a92e4e7842ec183170" ;
    er:ordinal 2 ;
    er:importSource "lift/manifest_to_er.py over seanchatmangpt/chatman-ecosystem@c59596f5506e7a00ca4ed6b909ebf6d6659b74c1:release/v26.9.1/manifest.toml" .

r23:import-court-references a er:ImportedReceipt ;
    er:importName "court-references" ;
    er:importPath "release/v26.9.23/imports/court-references.ttl" ;
    er:importDigest "sha256:dce0ff43c89fa04063aa89e10884996e6c84fa4458a3711a9c1f6eee554d1f46" ;
    er:ordinal 3 ;
    er:importSource "courts/ce23_2/observe_court_refs.py over seanchatmangpt/xaas@6fd59588c2e06b83d1af6ebc653e7b545de6f90f docs/sjira/v26.9.23/courts" .
