# Copy to .env.local for local development. Never commit real secrets.

# Symmetric secret used to sign/verify session JWTs (jose, HS256).
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-real-random-secret

# Seeded admin account. Username defaults to "admin" if unset.
ADMIN_USERNAME=admin

# bcrypt hash of the admin password -- NEVER a plaintext password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=$2a$12$replace.with.a.real.bcrypt.hash.................

# Cluster-internal status service base URLs. Defaults below match the
# <project>-status.<project>.svc.cluster.local convention from the platform
# design (one namespace + one Service per project). Override per-environment.
AUTOFDE_LAB_STATUS_URL=http://autofde-lab-status.autofde-lab.svc.cluster.local/status
GYMACT_STATUS_URL=http://gymact-status.gymact.svc.cluster.local/status
GGEN_STATUS_URL=http://ggen-status.ggen.svc.cluster.local/status
GGEN_MARKETPLACE_STATUS_URL=http://ggen-marketplace-status.ggen-marketplace.svc.cluster.local/status

# Prometheus base URL used by the Observability module (lib/prometheus.ts).
# Defaults to the real kube-prometheus-stack Service in this cluster.
PROMETHEUS_URL=http://monitoring-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090

# Optional. When set, the Auth and Storage project modules
# (lib/gotrue.ts, lib/storage-api.ts) make real admin-API calls (GoTrue
# /admin/users, Storage /bucket) using this service-role JWT. Left unset
# by default -- those modules then honestly report
# "requires service-role key (not configured)" instead of a fabricated
# count. This console has no such key provisioned for any project.
SUPABASE_SERVICE_ROLE_KEY=

# The Projects/Database/GitOps/IAM modules (lib/k8s.ts) never read this
# file -- they use the pod's own in-cluster ServiceAccount token
# (/var/run/secrets/kubernetes.io/serviceaccount), mounted automatically
# by Kubernetes per k8s/rbac.yaml + k8s/paas-rbac.yaml. Off-cluster (local
# dev, `next build`) those modules fail closed with "not configured".
