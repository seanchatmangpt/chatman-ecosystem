---
to: "out/scripts/crown_v{{ slug }}.sh"
for_each: courts
sparql:
  courts: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?release ?version ?slug ?root ?courtInput
    WHERE {
      ?release a er:Release ; er:version ?v .
      FILTER EXISTS { ?release er:gate ?g . }
      OPTIONAL { ?release er:courtRoot ?cr . }
      BIND(STR(?v) AS ?version)
      BIND(REPLACE(STR(?v), "[^A-Za-z0-9]", "_") AS ?slug)
      BIND(COALESCE(STR(?cr), ".") AS ?root)
      BIND(CONCAT("court|", STR(?v), "|", COALESCE(STR(?cr), ".")) AS ?courtInput)
    }
    ORDER BY ?release
  components: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT DISTINCT ?owner ?input
    WHERE {
      ?owner a er:Release ; er:hasComponent ?k .
      ?k er:repository ?r ; er:commitSha ?s .
      BIND(CONCAT("component|", STR(?r), "|", STR(?s)) AS ?input)
    }
    ORDER BY ?owner ?input
  gates: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?owner ?gate ?order ?name ?command ?commandSha ?input
    WHERE {
      ?owner a er:Release ; er:gate ?gate .
      ?gate er:gateOrder ?order ; er:gateName ?n ; er:command ?c .
      BIND(STR(?n) AS ?name)
      BIND(STR(?c) AS ?command)
      BIND(SHA256(STR(?c)) AS ?commandSha)
      BIND(CONCAT("gate|", STR(?gate), "|", STR(?order), "|", STR(?n), "|", SHA256(STR(?c))) AS ?input)
    }
    ORDER BY ?owner ?order ?gate
  probes: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?owner ?probe ?order ?name ?command ?commandSha ?input
    WHERE {
      ?owner a er:Release ; er:probe ?probe .
      ?probe er:probeOrder ?order ; er:probeName ?n ; er:command ?c .
      BIND(STR(?n) AS ?name)
      BIND(STR(?c) AS ?command)
      BIND(SHA256(STR(?c)) AS ?commandSha)
      BIND(CONCAT("probe|", STR(?probe), "|", STR(?order), "|", STR(?n), "|", SHA256(STR(?c))) AS ?input)
    }
    ORDER BY ?owner ?order ?probe
  imports: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?ordinal ?name ?path ?hex
    WHERE {
      ?i a er:ImportedReceipt ; er:importName ?n ; er:importPath ?p ; er:importDigest ?d ; er:ordinal ?o .
      BIND(STR(?o) AS ?ordinal)
      BIND(STR(?n) AS ?name)
      BIND(STR(?p) AS ?path)
      BIND(STRAFTER(STR(?d), "sha256:") AS ?hex)
    }
    ORDER BY ?o ?path
---
#!/usr/bin/env bash
# GENERATED by ggen sync from chatman-ecosystem-release-pack (templates/release-court.sh.tmpl).
# Do not hand-edit: a hand edit makes the next `ggen sync run` refuse (FM-WRITE-005); change the
# er:Gate / er:Probe / er:ImportedReceipt facts of the consumer graph and re-render instead.
# Every graph value below is one single-quoted shell word ('\'' for a quote), never shell code.
#
# Release court: from the court root (er:courtRoot relative to the consumer root, default "."),
# re-hash every imported file, run every probe, then every gate in er:gateOrder order. Each
# probe and gate command runs as `bash -euo pipefail -c <command>`, so a syntax or runtime error
# in a command is that command's own failure, never the court script's.
# Exit status (typed): 0 = every import, probe and gate passed; 1..99 = the gate with that
# er:gateOrder refused (the court stops there); 100 = an imported file is missing or its sha256
# differs from er:importDigest; 101 = a probe failed; 102 = the observation file could not be
# written; 103 = the consumer root or the court root is not a directory.
# COURT_OBSERVED=<file> (relative to the caller's directory): also write what the court observed
# as Turtle, for the consumer to feed back through extra_ontologies: er:observedOutput per probe
# and er:observedExit per gate run (each with er:observedCommandSha256, the sha256 of the command
# text it ran), and on the release one er:observedCourtInput value per element of the whole
# court input: version and court root, every component repository@SHA, every import with the
# digest the court re-hashed, every probe and gate with its IRI, order, name and command sha256.
# Gate 095 refuses an observation whose court input differs from the current graph in any
# element, so an observation cannot outlive an edit of the court it observed. The file is
# replaced only when the court reaches a gate verdict (every gate passed, or one refused); an
# import, probe or court-root failure leaves any previous observation untouched. Replacing it
# also removes the two receipts rendered from the superseded observation
# (out/receipts/root-receipt.unsealed.toml and out/receipts/ROOT.json under the consumer root,
# the `to:` of templates/root-receipt.{toml,json}.tmpl), so the next `ggen sync run` renders them
# from the new observation instead of refusing the changed render (FM-WRITE-005).
set -euo pipefail
RELEASE='{{ release | replace(from="'", to="'\''") }}'
VERSION='{{ version | replace(from="'", to="'\''") }}'
ROOT='{{ root | replace(from="'", to="'\''") }}'
COURT_BASH="${BASH:-bash}"
OBSERVED="${COURT_OBSERVED:-}"
case "$OBSERVED" in ''|/*) ;; *) OBSERVED="$PWD/$OBSERVED" ;; esac
cd "$(dirname "$0")/../.." 2> /dev/null || { echo "COURT_ROOT_MISSING consumer root of $0" >&2; exit 103; }
CONSUMER_ROOT=$PWD
cd "$ROOT" 2> /dev/null || { printf 'COURT_ROOT_MISSING court_root=%s\n' "$ROOT" >&2; exit 103; }
PARTIAL=""
INPUT=""
cleanup() { if [ -n "$PARTIAL" ]; then rm -f "$PARTIAL"; fi; }
trap cleanup EXIT
if [ -n "$OBSERVED" ]; then
  PARTIAL="$OBSERVED.partial.$$"
  printf '@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .\n' > "$PARTIAL" || exit 102
fi
obs() { if [ -n "$PARTIAL" ]; then printf '%s\n' "$1" >> "$PARTIAL" || exit 102; fi; }
lit() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//$'\n'/\\n}
  v=${v//$'\r'/\\r}
  printf '"%s"' "$v"
}
input() { INPUT="${INPUT:+$INPUT, }$(lit "$1")"; }
finish() {
  if [ -n "$PARTIAL" ]; then
    obs "<$RELEASE> er:observedCourtInput $INPUT ."
    mv -f "$PARTIAL" "$OBSERVED" || exit 102
    PARTIAL=""
    echo "COURT_OBSERVED $OBSERVED"
    local receipt
    for receipt in "$CONSUMER_ROOT/out/receipts/root-receipt.unsealed.toml" "$CONSUMER_ROOT/out/receipts/ROOT.json"; do
      if [ -e "$receipt" ]; then
        rm -f "$receipt" || exit 102
        echo "COURT_RECEIPT_SUPERSEDED $receipt"
      fi
    done
  fi
}
import_check() { # <ordinal> <name> <path> <sha256 hex>
  local got
  if [ ! -f "$3" ]; then
    echo "COURT_IMPORT_MISSING name=$2 path=$3" >&2
    exit 100
  fi
  got=$(shasum -a 256 "$3" | cut -c1-64) || { echo "COURT_IMPORT_UNREADABLE name=$2 path=$3" >&2; exit 100; }
  if [ "$got" != "$4" ]; then
    echo "COURT_IMPORT_DIGEST_MISMATCH name=$2 path=$3 want=sha256:$4 got=sha256:$got" >&2
    exit 100
  fi
  input "import|$1|$2|$3|sha256:$got"
  echo "COURT_IMPORT_OK name=$2 sha256:$got"
}
run_probe() { # <probe iri> <name> <command> <command sha256>
  local out rc
  set +e
  out=$("$COURT_BASH" -euo pipefail -c "$3")
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "COURT_PROBE_FAILED name=$2 exit=$rc" >&2
    exit 101
  fi
  echo "COURT_PROBE name=$2 output=$out"
  obs "<$1> er:observedOutput $(lit "$out") ; er:observedCommandSha256 \"$4\" ."
}
run_gate() { # <gate iri> <order> <name> <command> <command sha256>
  local rc
  echo "COURT_GATE_RUN order=$2 name=$3"
  set +e
  "$COURT_BASH" -euo pipefail -c "$4"
  rc=$?
  set -e
  obs "<$1> er:observedExit $rc ; er:observedCommandSha256 \"$5\" ."
  if [ "$rc" -ne 0 ]; then
    echo "COURT_GATE_REFUSED order=$2 name=$3 exit=$rc" >&2
    finish
    exit "$2"
  fi
  echo "COURT_GATE_PASS order=$2 name=$3"
}
# court input (er:observedCourtInput; imports are added by import_check with the digest it re-hashed)
input '{{ courtInput | replace(from="'", to="'\''") }}'
{% for c in components %}{% if c.owner == release %}input '{{ c.input | replace(from="'", to="'\''") }}'
{% endif %}{% endfor %}{% for p in probes %}{% if p.owner == release %}input '{{ p.input | replace(from="'", to="'\''") }}'
{% endif %}{% endfor %}{% for g in gates %}{% if g.owner == release %}input '{{ g.input | replace(from="'", to="'\''") }}'
{% endif %}{% endfor %}
# imports (er:ImportedReceipt, by er:ordinal)
{% for i in imports %}import_check '{{ i.ordinal | replace(from="'", to="'\''") }}' '{{ i.name | replace(from="'", to="'\''") }}' '{{ i.path | replace(from="'", to="'\''") }}' '{{ i.hex | replace(from="'", to="'\''") }}'
{% endfor %}
# probes (er:probeOrder)
{% for p in probes %}{% if p.owner == release %}run_probe '{{ p.probe | replace(from="'", to="'\''") }}' '{{ p.name | replace(from="'", to="'\''") }}' '{{ p.command | replace(from="'", to="'\''") }}' {{ p.commandSha }}
{% endif %}{% endfor %}
# gates (er:gateOrder)
{% for g in gates %}{% if g.owner == release %}run_gate '{{ g.gate | replace(from="'", to="'\''") }}' {{ g.order }} '{{ g.name | replace(from="'", to="'\''") }}' '{{ g.command | replace(from="'", to="'\''") }}' {{ g.commandSha }}
{% endif %}{% endfor %}
finish
printf 'COURT_ALIVE release=%s version=%s\n' "$RELEASE" "$VERSION"
