@prefix aac: <https://ggen.dev/ontology/ash-autofde-lab-connector#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aac:AshConnector a rdfs:Class ;
  rdfs:label "Ash-side connector resource to a clap-noun-verb-deploy-served planner tool" .

aac:resourceModule a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:domainModule a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:invokeTool a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:actionName a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:cnvDeployBaseUrlEnv a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:outputFile a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .
aac:tableName a rdf:Property ; rdfs:domain aac:AshConnector ; rdfs:range xsd:string .

aac:AutofdePlannerCandidate a aac:AshConnector ;
  dcterms:description "Real connector: xaas Ash resource -> cnv-deploy POST /invoke tool fabric__solve (wraps autofde-lab's real fabric CLI, confirmed clap-noun-verb-any/examples/autofde_lab_planners/)" ;
  aac:resourceModule "Xaas.Operations.AutofdePlannerCandidate" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__solve" ;
  aac:actionName "request_candidate" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/autofde_planner_candidate.ex" ;
  aac:tableName "autofde_planner_candidates" .

aac:AutofdePlannerCatalog a aac:AshConnector ;
  dcterms:description "Real connector: xaas Ash resource -> cnv-deploy POST /invoke tool fabric__catalog (lists registered domains/solvers, zero required arguments, confirmed clap-noun-verb-any/examples/autofde_lab_planners/cnv-any.json)" ;
  aac:resourceModule "Xaas.Operations.AutofdePlannerCatalog" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__catalog" ;
  aac:actionName "request_catalog" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/autofde_planner_catalog.ex" ;
  aac:tableName "autofde_planner_catalog_requests" .

aac:AutofdePlannerMatch a aac:AshConnector ;
  dcterms:description "Real connector: xaas Ash resource -> cnv-deploy POST /invoke tool fabric__match (matches compatible solvers for a real domain, required positional domain + optional domain-arguments, confirmed clap-noun-verb-any/examples/autofde_lab_planners/cnv-any.json)" ;
  aac:resourceModule "Xaas.Operations.AutofdePlannerMatch" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__match" ;
  aac:actionName "request_match" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/autofde_planner_match.ex" ;
  aac:tableName "autofde_planner_match_requests" .

aac:AutofdePlannerCacheStats a aac:AshConnector ;
  dcterms:description "Real connector: xaas Ash resource -> cnv-deploy POST /invoke tool fabric__cache-stats (Show cache hits, misses, writes, and namespaces., zero required arguments, confirmed clap-noun-verb-any/examples/autofde_lab_planners/cnv-any.json, generated by scripts/add_connector.py)" ;
  aac:resourceModule "Xaas.Operations.AutofdePlannerCacheStats" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__cache-stats" ;
  aac:actionName "request_cache_stats" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/autofde_planner_cache_stats.ex" ;
  aac:tableName "autofde_planner_cache_stats_requests" .

aac:AutofdePlannerCacheHotset a aac:AshConnector ;
  dcterms:description "Real connector: xaas Ash resource -> cnv-deploy POST /invoke tool fabric__cache-hotset (Measure whether 20% of artifacts account for 80% of reuse., zero required arguments, confirmed clap-noun-verb-any/examples/autofde_lab_planners/cnv-any.json, generated by scripts/add_connector.py)" ;
  aac:resourceModule "Xaas.Operations.AutofdePlannerCacheHotset" ;
  aac:domainModule "Xaas.Operations" ;
  aac:invokeTool "fabric__cache-hotset" ;
  aac:actionName "request_cache_hotset" ;
  aac:cnvDeployBaseUrlEnv "cnv_deploy_base_url" ;
  aac:outputFile "lib/xaas/operations/autofde_planner_cache_hotset.ex" ;
  aac:tableName "autofde_planner_cache_hotset_requests" .
