#################################################################
# Qualification suites (rendered into generated/qualification_runner.py).
# Declarations about this pack's own fixtures, not transcribed facts.
# Naming law inside every suite: pos-*.json must exit 0, neg-*.json must
# exit 1 and print a broken_term matching rp:refusalTermPattern.
#################################################################

rp:QualificationSuite a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Qualification suite" ;
    rdfs:comment "A directory of real receipt fixtures run through the generated validator with fixed arguments." .
rp:fixtureDir a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite .
rp:suiteArgs a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite .
rp:fleetParity a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite ; rdfs:range xsd:boolean ;
    rdfs:comment "Also require the exit code of ~/.claude/dfcm/validate_receipt.py on every fixture (skipped, visibly, where that file is absent)." .
rp:usesRepoMap a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite ; rdfs:range xsd:boolean .
rp:refusalTermPattern a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite .
rp:requiresRepo a owl:DatatypeProperty ; rdfs:domain rp:QualificationSuite ;
    rdfs:comment "Slug that must be given with --repo-map; the suite is skipped (visibly) otherwise." .

rp:suite_dfcm_fleet a rp:QualificationSuite ;
    rp:fixtureDir "qualification/fixtures/dfcm_fleet_v1" ;
    rp:suiteArgs "--contract=dfcm_fleet_v1" ;
    rp:fleetParity true ; rp:usesRepoMap false ;
    rp:refusalTermPattern "R_missing_|admission_vacuous" .
rp:suite_durable a rp:QualificationSuite ;
    rp:fixtureDir "qualification/fixtures/durable" ;
    rp:suiteArgs "--contract=dfcm_fleet_v1 --require-durable" ;
    rp:fleetParity false ; rp:usesRepoMap true ; rp:requiresRepo "seanchatmangpt/xaas" ;
    rp:refusalTermPattern "R_missing_identity|R_missing_replay" .
rp:suite_durable_standing a rp:QualificationSuite ;
    rp:fixtureDir "qualification/fixtures/durable_standing" ;
    rp:suiteArgs "--contract=dfcm_fleet_v1 --require-durable" ;
    rp:fleetParity false ; rp:usesRepoMap true ; rp:requiresRepo "seanchatmangpt/xaas" ;
    rp:refusalTermPattern "R_missing_standing" .
